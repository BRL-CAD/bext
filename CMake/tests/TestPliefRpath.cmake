include("${CMAKE_CURRENT_LIST_DIR}/CMakeTestHelpers.cmake")
if(NOT DEFINED ENV{BEXT_TEST_PLIEF} OR "$ENV{BEXT_TEST_PLIEF}" STREQUAL "")
  message("BEXT_TEST_PLIEF is not set")
  return()
endif()
set(PLIEF "$ENV{BEXT_TEST_PLIEF}")
bext_test_reset("${TEST_ROOT}")

get_filename_component(dependency_name "${DEPENDENCY}" NAME)
file(COPY_FILE "${DEPENDENCY}" "${TEST_ROOT}/${dependency_name}")
foreach(tag RUNPATH RPATH)
  file(COPY_FILE "${SUBJECT}" "${TEST_ROOT}/${tag}.so")
  set(subject "${TEST_ROOT}/${tag}.so")
  set(first_size)
  foreach(relative lib configure-library-path lib configure-library-path/install-library-path)
    set(library_dir "${TEST_ROOT}/${relative}")
    file(MAKE_DIRECTORY "${library_dir}")
    file(COPY_FILE "${DEPENDENCY}" "${library_dir}/${dependency_name}")
    set(options)
    if(tag STREQUAL RPATH)
      list(APPEND options --force-rpath)
    endif()
    execute_process(COMMAND "${PLIEF}" ${options} --set-rpath "${library_dir}" "${subject}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "plief ${tag} rewrite failed: ${output}${error}")
    endif()
    execute_process(COMMAND "${PLIEF}" ${options} --print-rpath "${subject}"
      RESULT_VARIABLE result OUTPUT_VARIABLE actual ERROR_VARIABLE error)
    string(STRIP "${actual}" actual)
    if(NOT result EQUAL 0 OR NOT actual STREQUAL library_dir)
      message(FATAL_ERROR "plief reported '${actual}' instead of '${library_dir}': ${error}")
    endif()
    file(SIZE "${subject}" size)
    if(DEFINED first_size AND size GREATER first_size)
      message(FATAL_ERROR "Repeated ${tag} rewrite grew from ${first_size} to ${size} bytes")
    endif()
    set(first_size "${size}")
    execute_process(COMMAND "${LOADER}" "${subject}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Rewritten ${tag} library did not load: ${output}${error}")
    endif()
  endforeach()
endforeach()
