include("${CMAKE_CURRENT_LIST_DIR}/CMakeTestHelpers.cmake")
bext_test_reset("${TEST_ROOT}")
set(source "${TEST_ROOT}/source")
file(MAKE_DIRECTORY "${source}")
file(WRITE "${source}/aliases.3" "API manual\n")
file(WRITE "${source}/command.n" "Command manual\n")
file(WRITE "${source}/installer.sh" "cp \"$1\" \"$2/first.3\"\nln \"$2/first.3\" \"$2/second.3\"\n")
file(WRITE "${source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.26)
project(manpage_ownership NONE)
include("@SOURCE_ROOT@/CMake/Utils.cmake")
bext_component_manpage_ownership(core
  INSTALL_SCRIPT "${CMAKE_CURRENT_SOURCE_DIR}/installer.sh"
  "${CMAKE_CURRENT_SOURCE_DIR}/*.3")
bext_component_manpage_ownership(extension "${CMAKE_CURRENT_SOURCE_DIR}/*.n")
get_property(rules GLOBAL PROPERTY BEXT_COMPONENT_OWNERSHIP_RULES)
foreach(manual man/man3/first.3 share/man/man3/second.3 man/mann/command.n)
  set(owners)
  foreach(rule IN LISTS rules)
    string(REPLACE "|" ";" fields "${rule}")
    list(POP_FRONT fields owner)
    list(JOIN fields "|" pattern)
    if(manual MATCHES "${pattern}")
      list(APPEND owners "${owner}")
    endif()
  endforeach()
  list(LENGTH owners owner_count)
  if(NOT owner_count EQUAL 1)
    message(FATAL_ERROR "Expected one owner for ${manual}: ${owners}")
  endif()
endforeach()
foreach(manual man/man3/unrelated.3 man/man3/aliases.3)
  foreach(rule IN LISTS rules)
    string(REGEX REPLACE "^[^|]+[|]" "" pattern "${rule}")
    if(manual MATCHES "${pattern}")
      message(FATAL_ERROR "Ownership claimed an uninstalled page: ${manual}")
    endif()
  endforeach()
endforeach()
]=])
file(READ "${source}/CMakeLists.txt" project)
string(REPLACE "@SOURCE_ROOT@" "${SOURCE_ROOT}" project "${project}")
file(WRITE "${source}/CMakeLists.txt" "${project}")

execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${TEST_ROOT}/build"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Manpage ownership configure failed: ${output}${error}")
endif()
if(EXISTS "${TEST_ROOT}/build/CMakeFiles/core-manpages")
  message(FATAL_ERROR "Manpage enumeration staging was not removed")
endif()

file(WRITE "${source}/installer.sh" "echo failed-enumeration >&2\nexit 1\n")
file(REMOVE_RECURSE "${TEST_ROOT}/build")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${TEST_ROOT}/build"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0)
  message(FATAL_ERROR "Failed manpage installer was accepted")
endif()
set(diagnostic "${output}${error}")
bext_test_require_contains("${diagnostic}" "Unable to enumerate manual ownership"
  "Manpage failure diagnostic")
bext_test_require_contains("${diagnostic}" "failed-enumeration" "Installer failure diagnostic")
