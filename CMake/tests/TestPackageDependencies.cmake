function(write_manifest tree)
  set(paths ${ARGN})
  if(tree STREQUAL "noinstall")
    list(PREPEND paths "${tool_relative}")
  endif()
  list(JOIN paths "\",\"" paths)
  file(WRITE "${prefix}/bext-${tree}-manifest.json" "{\"files\":[\"${paths}\"]}")
endfunction()

set(recorded_paths include/LIEF/PE/Binary.h include/eigen3/Eigen/LU ab/owned)
foreach(tree install noinstall)
  foreach(path IN LISTS recorded_paths)
    file(WRITE "${prefix}/${tree}/${path}" "${path}")
  endforeach()
  write_manifest(${tree} ${recorded_paths})
endforeach()
package(false TRUE)
read_archive(members)
foreach(tree install noinstall)
  foreach(path IN LISTS recorded_paths)
    bext_test_require_contains("${members}" "${tree}/${path}\n" "Two-character archive paths")
  endforeach()
endforeach()

if(UNIX)
  set(framework lib/QtConcurrent.framework)
  set(framework_header "${framework}/Versions/A/Headers/QtConcurrent.h")
  set(framework_links "${framework}/Versions/Current" "${framework}/Headers")
  set(link_targets A Versions/Current/Headers)
  foreach(tree install noinstall)
    file(WRITE "${prefix}/${tree}/${framework_header}" "framework header")
    file(WRITE "${prefix}/${tree}/${framework}/Versions/A/Headers/unrecorded.h" "unrecorded")
    foreach(link target IN ZIP_LISTS framework_links link_targets)
      file(CREATE_LINK "${target}" "${prefix}/${tree}/${link}" SYMBOLIC)
    endforeach()
    file(CREATE_LINK "tracked" "${prefix}/${tree}/file-link" SYMBOLIC)
    file(WRITE "${prefix}/${tree}/tracked" "tracked")
    write_manifest(${tree} ${recorded_paths} ${framework_header} ${framework_links}
      file-link tracked)
  endforeach()
  package(false TRUE)
  read_archive(members)
  bext_test_require_not_contains("${members}" "unrecorded.h" "Unrecorded framework output")
  set(extracted "${TEST_ROOT}/extracted")
  file(MAKE_DIRECTORY "${extracted}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xfz "${archive}"
    WORKING_DIRECTORY "${extracted}" COMMAND_ERROR_IS_FATAL ANY)
  foreach(tree install noinstall)
    foreach(link target IN ZIP_LISTS framework_links link_targets)
      set(path "${extracted}/${tree}/${link}")
      if(NOT IS_SYMLINK "${path}")
        message(FATAL_ERROR "Archive did not preserve framework symlink: ${tree}/${link}")
      endif()
      file(READ_SYMLINK "${path}" actual_target)
      if(NOT actual_target STREQUAL target)
        message(FATAL_ERROR "Archive changed framework symlink target: ${actual_target}")
      endif()
    endforeach()
    if(NOT IS_SYMLINK "${extracted}/${tree}/file-link")
      message(FATAL_ERROR "Archive did not preserve file symlink: ${tree}/file-link")
    endif()
    file(READ "${extracted}/${tree}/${framework}/Headers/QtConcurrent.h" header)
    if(NOT header STREQUAL "framework header")
      message(FATAL_ERROR "Archived framework header is unreadable through its symlinks")
    endif()
  endforeach()
endif()

file(WRITE "${prefix}/outside" "outside")
foreach(tree install noinstall)
  write_manifest(install ${recorded_paths})
  write_manifest(noinstall ${recorded_paths})
  file(MAKE_DIRECTORY "${prefix}/${tree}/directory")
  file(WRITE "${prefix}/${tree}/tracked" "tracked")
  set(invalid_paths missing directory ../outside "${prefix}/outside" ab/../tracked)
  if(UNIX)
    file(CREATE_LINK "missing" "${prefix}/${tree}/dangling-link" SYMBOLIC)
    list(APPEND invalid_paths dangling-link)
  endif()
  foreach(path IN LISTS invalid_paths)
    write_manifest(${tree} "${path}")
    package(false FALSE)
    bext_test_require_contains("${package_error}" "Invalid or missing" "Invalid archive member")
    bext_test_require_contains("${package_error}" "${path}" "Invalid archive member path")
    if(EXISTS "${archive}")
      message(FATAL_ERROR "Invalid archive member left an archive: ${tree}/${path}")
    endif()
  endforeach()
endforeach()
