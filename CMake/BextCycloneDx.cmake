include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/BextSbomJson.cmake")

function(_bext_json_array_indices output document field)
  string(JSON count LENGTH "${document}" "${field}")
  set(indices)
  while(count GREATER 0)
    math(EXPR count "${count} - 1")
    list(PREPEND indices "${count}")
  endwhile()
  set(${output} "${indices}" PARENT_SCOPE)
endfunction()

function(_bext_cdx_component_tree out id)
  set(component "${cdx_component_${id}}")
  set(children "[]")
  set(index 0)
  foreach(child IN LISTS cdx_children_${id})
    _bext_cdx_component_tree(child_json "${child}")
    string(JSON children SET "${children}" ${index} "${child_json}")
    math(EXPR index "${index} + 1")
  endforeach()
  if(index GREATER 0)
    string(JSON component SET "${component}" components "${children}")
  endif()
  set(${out} "${component}" PARENT_SCOPE)
endfunction()

# Both serializations consume the same resolved inventory. This writer handles
# bext's source inventory, rather than attempting general SPDX conversion.
function(bext_write_cyclonedx output inventory)
  file(REMOVE "${output}" "${output}.tmp")
  string(JSON namespace GET "${inventory}" documentNamespace)
  string(JSON created GET "${inventory}" creationInfo created)
  string(JSON name GET "${inventory}" name)
  # RFC 4122's URL namespace gives reproducible serials for inventory namespaces.
  set(url_uuid_namespace "6ba7b811-9dad-11d1-80b4-00c04fd430c8")
  string(UUID serial NAMESPACE "${url_uuid_namespace}" NAME "${namespace}" TYPE SHA1)
  foreach(field namespace created name)
    _bext_json_string(${field}_json "${${field}}")
  endforeach()
  set(bom "{\"$schema\":\"https://cyclonedx.org/schema/bom-1.6.schema.json\",\"bomFormat\":\"CycloneDX\",\"specVersion\":\"1.6\",\"serialNumber\":\"urn:uuid:${serial}\",\"version\":1}")
  set(metadata "{\"timestamp\":${created_json},\"lifecycles\":[{\"phase\":\"pre-build\"}],\"component\":{\"type\":\"application\",\"bom-ref\":${namespace_json},\"name\":${name_json}},\"tools\":{\"components\":[{\"type\":\"application\",\"name\":\"bext-GenerateSbom.cmake\"}]},\"licenses\":[{\"license\":{\"id\":\"CC0-1.0\"}}]}")
  string(JSON bom SET "${bom}" metadata "${metadata}")

  string(JSON license_count ERROR_VARIABLE no_licenses LENGTH "${inventory}" hasExtractedLicensingInfos)
  if(NOT no_licenses AND license_count GREATER 0)
    math(EXPR last "${license_count} - 1")
    foreach(index RANGE ${last})
      string(JSON license GET "${inventory}" hasExtractedLicensingInfos ${index})
      string(JSON id GET "${license}" licenseId)
      string(JSON text GET "${license}" extractedText)
      string(JSON license_name GET "${license}" name)
      _bext_json_string(text_json "${text}")
      _bext_json_string(license_name_json "${license_name}")
      set(cdx_license_${id} "{\"license\":{\"name\":${license_name_json},\"text\":{\"contentType\":\"text/plain\",\"content\":${text_json}},\"licensing\":{\"altIds\":[\"${id}\"]}}}")
    endforeach()
  endif()

  set(package_ids)
  _bext_json_array_indices(package_indices "${inventory}" packages)
  foreach(index IN LISTS package_indices)
    string(JSON package GET "${inventory}" packages ${index})
    string(JSON id GET "${package}" SPDXID)
    if(id IN_LIST package_ids)
      message(FATAL_ERROR "Duplicate SBOM package ${id}")
    endif()
    list(APPEND package_ids "${id}")
    string(JSON purpose GET "${package}" primaryPackagePurpose)
    string(TOLOWER "${purpose}" type)
    if(purpose MATCHES "^(CONTAINER|SOURCE|OTHER)$")
      # A source aggregate is not a runtime container image.
      set(type "library")
    elseif(purpose STREQUAL "ARCHIVE")
      set(type "file")
    elseif(purpose STREQUAL "INSTALL")
      set(type "application")
    endif()
    set(component "{\"type\":\"${type}\",\"bom-ref\":\"${id}\"}")
    foreach(pair "name|name" "versionInfo|version" "copyrightText|copyright")
      string(REPLACE "|" ";" fields "${pair}")
      list(GET fields 0 source)
      list(GET fields 1 target)
      string(JSON value GET "${package}" "${source}")
      if(NOT value STREQUAL "NOASSERTION")
        _bext_json_string(value_json "${value}")
        string(JSON component SET "${component}" "${target}" "${value_json}")
      endif()
    endforeach()
    set(properties "[]")
    set(property_index 0)
    string(JSON annotation_count ERROR_VARIABLE no_annotations LENGTH "${package}" annotations)
    if(NOT no_annotations)
      math(EXPR last_annotation "${annotation_count} - 1")
      if(annotation_count GREATER 0)
        foreach(annotation_index RANGE ${last_annotation})
          string(JSON annotator GET "${package}" annotations ${annotation_index} annotator)
          if(annotator STREQUAL "Tool: bext:membership")
            string(JSON membership GET "${package}" annotations ${annotation_index} comment)
            _bext_json_string(membership_json "${membership}")
            string(JSON properties SET "${properties}" ${property_index} "{\"name\":\"bext:membership\",\"value\":${membership_json}}")
            math(EXPR property_index "${property_index} + 1")
          endif()
        endforeach()
      endif()
    endif()
    foreach(field primaryPackagePurpose packageSourceInfo comment licenseDeclared licenseConcluded copyrightText)
      string(JSON value GET "${package}" "${field}")
      _bext_json_string(value_json "${value}")
      string(JSON properties SET "${properties}" ${property_index} "{\"name\":\"bext:spdx:${field}\",\"value\":${value_json}}")
      math(EXPR property_index "${property_index} + 1")
    endforeach()
    string(JSON component SET "${component}" properties "${properties}")
    string(JSON download GET "${package}" downloadLocation)
    if(NOT download MATCHES "^(NONE|NOASSERTION)$")
      _bext_json_string(download_json "${download}")
      string(JSON component SET "${component}" externalReferences "[{\"type\":\"distribution\",\"url\":${download_json}}]")
    endif()
    string(JSON ref_count ERROR_VARIABLE no_refs LENGTH "${package}" externalRefs)
    if(NOT no_refs AND ref_count GREATER 0)
      math(EXPR ref_last "${ref_count} - 1")
      foreach(ref_index RANGE ${ref_last})
        string(JSON ref_type GET "${package}" externalRefs ${ref_index} referenceType)
        if(ref_type STREQUAL "purl")
          set(field "purl")
        elseif(ref_type STREQUAL "cpe23Type")
          set(field "cpe")
        else()
          message(FATAL_ERROR "Unsupported source inventory reference ${ref_type}")
        endif()
        string(JSON value GET "${package}" externalRefs ${ref_index} referenceLocator)
        _bext_json_string(value_json "${value}")
        string(JSON component SET "${component}" "${field}" "${value_json}")
      endforeach()
    endif()
    string(JSON declared GET "${package}" licenseDeclared)
    string(JSON concluded GET "${package}" licenseConcluded)
    set(expression "${concluded}")
    set(acknowledgement "concluded")
    if(expression STREQUAL "NOASSERTION")
      set(expression "${declared}")
      set(acknowledgement "declared")
    endif()
    if(NOT expression MATCHES "^(NONE|NOASSERTION)$")
      _bext_json_string(expression_json "${expression}")
      string(JSON component SET "${component}" licenses "[{\"expression\":${expression_json},\"acknowledgement\":\"${acknowledgement}\"}]")
    endif()
    string(REGEX MATCHALL "LicenseRef-[A-Za-z0-9.-]+" license_ids "${declared} ${concluded}")
    list(REMOVE_DUPLICATES license_ids)
    set(license_evidence "[]")
    set(license_index 0)
    foreach(license_id IN LISTS license_ids)
      if(NOT DEFINED cdx_license_${license_id})
        message(FATAL_ERROR "Undefined custom license ${license_id}")
      endif()
      string(JSON license_evidence SET "${license_evidence}" ${license_index} "${cdx_license_${license_id}}")
      math(EXPR license_index "${license_index} + 1")
    endforeach()
    if(license_index GREATER 0)
      string(JSON component SET "${component}" evidence "{\"licenses\":${license_evidence}}")
    endif()
    set(cdx_component_${id} "${component}")
    set(cdx_dependencies_${id})
    set(cdx_children_${id})
  endforeach()

  _bext_json_array_indices(relationship_indices "${inventory}" relationships)
  foreach(index IN LISTS relationship_indices)
    string(JSON relationship GET "${inventory}" relationships ${index})
    string(JSON source GET "${relationship}" spdxElementId)
    string(JSON target GET "${relationship}" relatedSpdxElement)
    string(JSON type GET "${relationship}" relationshipType)
    if(type STREQUAL "DESCRIBES")
      continue()
    endif()
    if(NOT source IN_LIST package_ids OR NOT target IN_LIST package_ids)
      message(FATAL_ERROR "Unknown SBOM relationship endpoint: ${source} ${target}")
    endif()
    if(type STREQUAL "CONTAINS")
      if(DEFINED cdx_parent_${target} AND NOT cdx_parent_${target} STREQUAL source)
        message(FATAL_ERROR "Multiple containment parents for ${target}")
      endif()
      set(cdx_parent_${target} "${source}")
      list(APPEND cdx_children_${source} "${target}")
    elseif(type STREQUAL "DEPENDS_ON")
      list(APPEND cdx_dependencies_${source} "${target}")
    else()
      message(FATAL_ERROR "Unsupported SBOM relationship ${type}")
    endif()
  endforeach()

  set(components "[]")
  set(dependencies "[]")
  set(root_dependencies "[]")
  set(component_index 0)
  set(dependency_index 0)
  foreach(id IN LISTS package_ids)
    # Check even disconnected cycles before constructing the containment forest.
    set(ancestors)
    set(ancestor "${id}")
    while(DEFINED cdx_parent_${ancestor})
      if(ancestor IN_LIST ancestors)
        message(FATAL_ERROR "Cyclic SBOM containment at ${ancestor}")
      endif()
      list(APPEND ancestors "${ancestor}")
      set(ancestor "${cdx_parent_${ancestor}}")
    endwhile()
    if(NOT DEFINED cdx_parent_${id})
      _bext_cdx_component_tree(component "${id}")
      string(JSON components SET "${components}" ${component_index} "${component}")
      string(JSON root_dependencies SET "${root_dependencies}" ${component_index} "\"${id}\"")
      math(EXPR component_index "${component_index} + 1")
    endif()
    set(depends_on "[]")
    set(index 0)
    list(REMOVE_DUPLICATES cdx_dependencies_${id})
    foreach(dependency IN LISTS cdx_dependencies_${id})
      string(JSON depends_on SET "${depends_on}" ${index} "\"${dependency}\"")
      math(EXPR index "${index} + 1")
    endforeach()
    string(JSON dependencies SET "${dependencies}" ${dependency_index} "{\"ref\":\"${id}\",\"dependsOn\":${depends_on}}")
    math(EXPR dependency_index "${dependency_index} + 1")
  endforeach()
  string(JSON dependencies SET "${dependencies}" ${dependency_index} "{\"ref\":${namespace_json},\"dependsOn\":${root_dependencies}}")
  string(JSON bom SET "${bom}" components "${components}")
  string(JSON bom SET "${bom}" dependencies "${dependencies}")
  get_filename_component(directory "${output}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  file(WRITE "${output}.tmp" "${bom}\n")
  file(RENAME "${output}.tmp" "${output}")
  message(STATUS "Generated CycloneDX 1.6 SBOM: ${output}")
endfunction()
