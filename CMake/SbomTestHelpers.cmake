# Shared assertions for dependency-local source-inventory regression checks.
function(bext_test_sbom_package output sbom identifier)
  string(JSON count LENGTH "${sbom}" packages)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON package GET "${sbom}" packages ${index})
      string(JSON id GET "${package}" SPDXID)
      if(id STREQUAL identifier)
        set(${output} "${package}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endif()
  message(FATAL_ERROR "Expected SBOM package was not generated: ${identifier}")
endfunction()

function(bext_test_sbom_field package field expected)
  string(JSON actual GET "${package}" "${field}")
  if(NOT actual STREQUAL expected)
    string(JSON id GET "${package}" SPDXID)
    message(FATAL_ERROR "${id}: expected ${field} '${expected}', got '${actual}'")
  endif()
endfunction()

function(bext_test_sbom_reference package type locator)
  string(JSON count LENGTH "${package}" externalRefs)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON actual_type GET "${package}" externalRefs ${index} referenceType)
      string(JSON actual_locator GET "${package}" externalRefs ${index} referenceLocator)
      if(actual_type STREQUAL type AND actual_locator STREQUAL locator)
        return()
      endif()
    endforeach()
  endif()
  string(JSON id GET "${package}" SPDXID)
  message(FATAL_ERROR "${id}: expected ${type} reference was not generated: ${locator}")
endfunction()

function(bext_test_sbom_contains sbom parent child)
  string(JSON count LENGTH "${sbom}" relationships)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON relation GET "${sbom}" relationships ${index})
      string(JSON type GET "${relation}" relationshipType)
      string(JSON source GET "${relation}" spdxElementId)
      string(JSON target GET "${relation}" relatedSpdxElement)
      if(type STREQUAL "CONTAINS" AND source STREQUAL parent AND target STREQUAL child)
        return()
      endif()
    endforeach()
  endif()
  message(FATAL_ERROR "SBOM containment was not generated: ${parent} CONTAINS ${child}")
endfunction()
