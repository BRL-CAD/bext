cmake_minimum_required(VERSION 3.26)

if (NOT DEFINED BEXT_SBOM_INPUT OR NOT EXISTS "${BEXT_SBOM_INPUT}")
  message(FATAL_ERROR "BEXT_SBOM_INPUT must name an existing SPDX JSON file")
endif()

file(READ "${BEXT_SBOM_INPUT}" sbom)
foreach(field spdxVersion dataLicense SPDXID name documentNamespace creationInfo packages relationships)
  string(JSON field_type ERROR_VARIABLE json_error TYPE "${sbom}" "${field}")
  if (json_error)
    message(FATAL_ERROR "SBOM is missing required field ${field}: ${json_error}")
  endif()
endforeach()
string(JSON spdx_version GET "${sbom}" spdxVersion)
if (NOT spdx_version STREQUAL "SPDX-2.3")
  message(FATAL_ERROR "Expected SPDX-2.3, found ${spdx_version}")
endif()

string(JSON package_count LENGTH "${sbom}" packages)
set(package_ids)
set(file_ids)
set(extracted_license_ids)
string(JSON extracted_license_count ERROR_VARIABLE extracted_license_error LENGTH "${sbom}" hasExtractedLicensingInfos)
if (NOT extracted_license_error)
  math(EXPR extracted_license_last "${extracted_license_count} - 1")
  foreach(index RANGE ${extracted_license_last})
    string(JSON license_id GET "${sbom}" hasExtractedLicensingInfos ${index} licenseId)
    string(JSON extracted_text GET "${sbom}" hasExtractedLicensingInfos ${index} extractedText)
    if (NOT license_id MATCHES "^LicenseRef-" OR extracted_text STREQUAL "")
      message(FATAL_ERROR "Invalid extracted license entry ${index}")
    endif()
    list(APPEND extracted_license_ids "${license_id}")
  endforeach()
endif()
math(EXPR package_last "${package_count} - 1")
foreach(index RANGE ${package_last})
  foreach(field name SPDXID versionInfo downloadLocation filesAnalyzed primaryPackagePurpose licenseConcluded licenseDeclared copyrightText)
    string(JSON value ERROR_VARIABLE json_error GET "${sbom}" packages ${index} "${field}")
    if (json_error OR value STREQUAL "")
      message(FATAL_ERROR "Package ${index} has no valid ${field}")
    endif()
  endforeach()
  string(JSON package_id GET "${sbom}" packages ${index} SPDXID)
  if (package_id IN_LIST package_ids)
    message(FATAL_ERROR "Duplicate package SPDXID: ${package_id}")
  endif()
  list(APPEND package_ids "${package_id}")
  string(JSON package_purpose GET "${sbom}" packages ${index} primaryPackagePurpose)
  if (NOT package_purpose MATCHES "^(APPLICATION|FRAMEWORK|LIBRARY|CONTAINER|OPERATING-SYSTEM|DEVICE|FIRMWARE|SOURCE|ARCHIVE|FILE|INSTALL|OTHER)$")
    message(FATAL_ERROR "Package ${package_id} has invalid primaryPackagePurpose ${package_purpose}")
  endif()
  foreach(license_field licenseDeclared licenseConcluded)
    string(JSON license_expression GET "${sbom}" packages ${index} ${license_field})
    string(REGEX MATCHALL "LicenseRef-[A-Za-z0-9.-]+" custom_licenses "${license_expression}")
    foreach(custom_license ${custom_licenses})
      if (NOT custom_license IN_LIST extracted_license_ids)
        message(FATAL_ERROR "Package ${package_id} ${license_field} references undefined custom license ${custom_license}")
      endif()
    endforeach()
  endforeach()

  string(JSON external_ref_count ERROR_VARIABLE external_ref_error LENGTH "${sbom}" packages ${index} externalRefs)
  if (NOT external_ref_error)
    math(EXPR external_ref_last "${external_ref_count} - 1")
    foreach(ref_index RANGE ${external_ref_last})
      string(JSON reference_type GET "${sbom}" packages ${index} externalRefs ${ref_index} referenceType)
      string(JSON reference_locator GET "${sbom}" packages ${index} externalRefs ${ref_index} referenceLocator)
      if (reference_type STREQUAL "purl" AND NOT reference_locator MATCHES "^pkg:[a-z0-9.+-]+/[^@]+@[^@]+$")
        message(FATAL_ERROR "Package ${package_id} has invalid PURL ${reference_locator}")
      elseif(reference_type STREQUAL "cpe23Type")
        string(REPLACE ":" ";" cpe_fields "${reference_locator}")
        list(LENGTH cpe_fields cpe_field_count)
        if(NOT reference_locator MATCHES "^cpe:2\\.3:[aho]:[!-~]+$" OR NOT cpe_field_count EQUAL 13)
          message(FATAL_ERROR "Package ${package_id} has invalid CPE ${reference_locator}")
        endif()
      endif()
    endforeach()
  endif()
endforeach()

string(JSON file_count ERROR_VARIABLE file_count_error LENGTH "${sbom}" files)
if(NOT file_count_error AND file_count GREATER 0)
  math(EXPR file_last "${file_count} - 1")
  foreach(index RANGE ${file_last})
    foreach(field fileName SPDXID licenseConcluded copyrightText)
      string(JSON value ERROR_VARIABLE json_error GET "${sbom}" files ${index} "${field}")
      if(json_error OR value STREQUAL "")
        message(FATAL_ERROR "File ${index} has no valid ${field}")
      endif()
    endforeach()
    string(JSON file_id GET "${sbom}" files ${index} SPDXID)
    if(file_id IN_LIST file_ids)
      message(FATAL_ERROR "Duplicate file SPDXID: ${file_id}")
    endif()
    list(APPEND file_ids "${file_id}")
    string(JSON checksum_count LENGTH "${sbom}" files ${index} checksums)
    if(checksum_count LESS 1)
      message(FATAL_ERROR "File ${file_id} has no checksum")
    endif()
  endforeach()
endif()

string(JSON relationship_count LENGTH "${sbom}" relationships)
set(described_ids)
math(EXPR relationship_last "${relationship_count} - 1")
foreach(index RANGE ${relationship_last})
  string(JSON source_id GET "${sbom}" relationships ${index} spdxElementId)
  string(JSON relationship_type GET "${sbom}" relationships ${index} relationshipType)
  string(JSON target_id GET "${sbom}" relationships ${index} relatedSpdxElement)
  if (NOT source_id STREQUAL "SPDXRef-DOCUMENT" AND NOT source_id IN_LIST package_ids)
    message(FATAL_ERROR "Relationship ${index} has unknown source ${source_id}")
  endif()
  if (NOT target_id STREQUAL "SPDXRef-DOCUMENT" AND
      NOT target_id IN_LIST package_ids AND NOT target_id IN_LIST file_ids)
    message(FATAL_ERROR "Relationship ${index} has unknown target ${target_id}")
  endif()
  if (NOT relationship_type MATCHES "^(DESCRIBES|DEPENDS_ON|CONTAINS)$")
    message(FATAL_ERROR "Relationship ${index} has unsupported type ${relationship_type}")
  endif()
  if (source_id STREQUAL "SPDXRef-DOCUMENT" AND relationship_type STREQUAL "DESCRIBES")
    list(APPEND described_ids "${target_id}")
  endif()
endforeach()

foreach(package_id ${package_ids})
  if (NOT package_id IN_LIST described_ids)
    message(FATAL_ERROR "Document does not describe package ${package_id}")
  endif()
endforeach()
message(STATUS "Validated SPDX 2.3 SBOM: ${BEXT_SBOM_INPUT}")
