# Refresh SPDX tag/value integrity fields after installed artifacts are processed.
# Component, licensing, source relationships, and document identifiers are retained.
function(bext_refresh_spdx root)
  cmake_parse_arguments(PARSE_ARGV 1 refresh "PRUNE_MISSING" "" "")
  if(refresh_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown SPDX refresh arguments: ${refresh_UNPARSED_ARGUMENTS}")
  endif()
  file(GLOB documents "${root}/sbom/*.spdx")
  foreach(document IN LISTS documents)
    file(READ "${document}" content)
    string(REGEX MATCHALL "FileName: [^\n]+\nSPDXID: [^\n]+\nFileType: [^\n]+\nFileChecksum: SHA1: [a-f0-9]+" records "${content}")
    foreach(record IN LISTS records)
      string(REGEX MATCH "FileName: ([^\n]+)" unused "${record}")
      set(relative "${CMAKE_MATCH_1}")
      cmake_path(ABSOLUTE_PATH relative BASE_DIRECTORY "${root}" NORMALIZE OUTPUT_VARIABLE path)
      cmake_path(IS_PREFIX root "${path}" NORMALIZE inside)
      if(NOT inside OR (NOT EXISTS "${path}" AND NOT refresh_PRUNE_MISSING))
        message(FATAL_ERROR "SPDX file is missing or outside the install tree: ${relative}")
      endif()
      if(NOT EXISTS "${path}")
        # A consumer may omit producer build tools. Remove their file elements
        # and edges before recalculating the installed subset's integrity.
        string(REGEX MATCH "SPDXID: ([^\n]+)" unused "${record}")
        set(removed_id "${CMAKE_MATCH_1}")
        string(FIND "${content}" "${record}" start)
        string(SUBSTRING "${content}" ${start} -1 suffix)
        string(FIND "${suffix}" "\n\n" end)
        if(end LESS 0)
          message(FATAL_ERROR "Unterminated SPDX file element: ${relative}")
        endif()
        math(EXPR end "${end} + 2")
        string(SUBSTRING "${suffix}" 0 ${end} block)
        string(REGEX MATCHALL "<text>" text_starts "${block}")
        string(REGEX MATCHALL "</text>" text_ends "${block}")
        list(LENGTH text_starts start_count)
        list(LENGTH text_ends end_count)
        if(NOT start_count EQUAL end_count)
          message(FATAL_ERROR "Unsupported blank lines in SPDX file text: ${relative}")
        endif()
        string(REPLACE "${block}" "" content "${content}")
        string(REGEX MATCHALL "Relationship: [^\n]+" relationships "${content}")
        foreach(relationship IN LISTS relationships)
          string(REGEX MATCH "^Relationship: ([^ ]+) [^ ]+ ([^ ]+)$" unused "${relationship}")
          if(CMAKE_MATCH_1 STREQUAL removed_id OR CMAKE_MATCH_2 STREQUAL removed_id)
            string(REPLACE "${relationship}\n" "" content "${content}")
          endif()
        endforeach()
        continue()
      endif()
      file(SHA1 "${path}" checksum)
      string(REGEX MATCH "SPDXID: ([^\n]+)" unused "${record}")
      set(file_hash_${CMAKE_MATCH_1} "${checksum}")
      string(REGEX REPLACE "FileChecksum: SHA1: [a-f0-9]+" "FileChecksum: SHA1: ${checksum}" updated "${record}")
      string(REPLACE "${record}" "${updated}" content "${content}")
    endforeach()
    string(REGEX MATCHALL "PackageName: [^\n]+\nSPDXID: [^\n]+" packages "${content}")
    foreach(package IN LISTS packages)
      string(REGEX MATCH "SPDXID: ([^\n]+)" unused "${package}")
      set(id "${CMAKE_MATCH_1}")
      string(REGEX MATCHALL "Relationship: ${id} CONTAINS SPDXRef-PackagedFile-[^\n]+" relations "${content}")
      list(REMOVE_DUPLICATES relations)
      set(hashes)
      foreach(relation IN LISTS relations)
        string(REGEX REPLACE "^Relationship: ${id} CONTAINS " "" file_id "${relation}")
        if(NOT DEFINED file_hash_${file_id})
          message(FATAL_ERROR "SPDX checksum missing for ${file_id}")
        endif()
        list(APPEND hashes "${file_hash_${file_id}}")
      endforeach()
      list(SORT hashes)
      list(JOIN hashes "" concatenated)
      string(SHA1 verification "${concatenated}")
      string(FIND "${content}" "${package}" start)
      string(SUBSTRING "${content}" ${start} -1 suffix)
      string(FIND "${suffix}" "\nPackageName:" end)
      if(end LESS 0)
        set(block "${suffix}")
      else()
        string(SUBSTRING "${suffix}" 0 ${end} block)
      endif()
      string(REGEX REPLACE "PackageVerificationCode: [a-f0-9]+" "PackageVerificationCode: ${verification}" updated "${block}")
      string(REPLACE "${block}" "${updated}" content "${content}")
    endforeach()
    file(WRITE "${document}.tmp" "${content}")
    file(COPY_FILE "${document}.tmp" "${document}" ONLY_IF_DIFFERENT)
    file(REMOVE "${document}.tmp")
  endforeach()
  # ExternalDocumentRef hashes cover the final referenced document.  Dependencies
  # form a DAG; repeat until hashes settle, failing on cycles or unresolved refs.
  list(LENGTH documents limit)
  foreach(pass RANGE 0 ${limit})
    set(changed FALSE)
    foreach(document IN LISTS documents)
      file(READ "${document}" content)
      string(REGEX MATCHALL "ExternalDocumentRef: [^\n]+ SHA1: [a-f0-9]+" references "${content}")
      foreach(reference IN LISTS references)
        string(REGEX MATCH "ExternalDocumentRef: [^ ]+ ([^ ]+) SHA1:" unused "${reference}")
        set(namespace "${CMAKE_MATCH_1}")
        set(found FALSE)
        foreach(candidate IN LISTS documents)
          file(STRINGS "${candidate}" candidate_namespace REGEX "^DocumentNamespace:")
          if(candidate_namespace STREQUAL "DocumentNamespace: ${namespace}")
            file(SHA1 "${candidate}" checksum)
            string(REGEX REPLACE "SHA1: [a-f0-9]+$" "SHA1: ${checksum}" updated "${reference}")
            string(REPLACE "${reference}" "${updated}" content "${content}")
            set(found TRUE)
            break()
          endif()
        endforeach()
        if(NOT found)
          message(FATAL_ERROR "SPDX referenced document not installed: ${namespace}")
        endif()
        if(NOT reference STREQUAL updated)
          set(changed TRUE)
        endif()
      endforeach()
      file(WRITE "${document}.tmp" "${content}")
      file(COPY_FILE "${document}.tmp" "${document}" ONLY_IF_DIFFERENT)
      file(REMOVE "${document}.tmp")
    endforeach()
    if(NOT changed)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Cyclic SPDX external document references")
endfunction()
