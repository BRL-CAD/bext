cmake_minimum_required(VERSION 3.26)

foreach(field BEXT_INSTALL_ROOT BEXT_NOINSTALL_ROOT BEXT_BINARY_ROOT
    BEXT_ACTIVE_COMPONENTS BEXT_COMPONENT_MANIFEST BEXT_NOINSTALL_MANIFEST
    BEXT_PACKAGE_COMPONENT_MANIFEST BEXT_SYSTEM_NAME)
  if(NOT DEFINED ${field} OR "${${field}}" STREQUAL "")
    message(FATAL_ERROR "${field} is required")
  endif()
endforeach()

function(bext_track_noinstall path component)
  string(REPLACE "\\" "/" path "${path}")
  if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)[.][.](/|$)")
    return()
  endif()
  if(NOT EXISTS "${BEXT_NOINSTALL_ROOT}/${path}" OR
      IS_DIRECTORY "${BEXT_NOINSTALL_ROOT}/${path}")
    return()
  endif()
  string(SHA256 key "${path}")
  if(DEFINED noinstall_component_${key})
    if(NOT "${noinstall_component_${key}}" STREQUAL "${component}")
      message(FATAL_ERROR "Conflicting noinstall ownership for ${path}")
    endif()
    return()
  endif()
  set(noinstall_component_${key} "${component}" PARENT_SCOPE)
  set(noinstall_files ${noinstall_files} "${path}" PARENT_SCOPE)
  set(noinstall_records ${noinstall_records} "${path}|${component}" PARENT_SCOPE)
endfunction()

function(bext_json_escape out value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\n" value "${value}")
  string(REPLACE "\r" "\r" value "${value}")
  string(REPLACE "\t" "\t" value "${value}")
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

file(STRINGS "${BEXT_ACTIVE_COMPONENTS}" active_components)
file(GLOB_RECURSE native_install_manifests LIST_DIRECTORIES false
  "${BEXT_BINARY_ROOT}/*/install_manifest.txt")
set(noinstall_files)
set(noinstall_records)
foreach(native_manifest IN LISTS native_install_manifests)
  file(RELATIVE_PATH manifest_relative "${BEXT_BINARY_ROOT}" "${native_manifest}")
  string(REPLACE "\\" "/" manifest_relative "${manifest_relative}")
  string(REGEX REPLACE "/.*$" "" component "${manifest_relative}")
  string(TOLOWER "${component}" component)
  if(NOT component IN_LIST active_components)
    continue()
  endif()
  file(STRINGS "${native_manifest}" installed_paths)
  foreach(installed_path IN LISTS installed_paths)
    file(RELATIVE_PATH relative "${BEXT_NOINSTALL_ROOT}" "${installed_path}")
    bext_track_noinstall("${relative}" "${component}")
  endforeach()
endforeach()

file(GLOB_RECURSE supply_chain_files LIST_DIRECTORIES false
  RELATIVE "${BEXT_NOINSTALL_ROOT}" "${BEXT_NOINSTALL_ROOT}/share/bext/*")
foreach(relative IN LISTS supply_chain_files)
  bext_track_noinstall("${relative}" "bext-supply-chain")
endforeach()
if(WIN32)
  set(supply_chain_tool "bin/bext_supply_chain.exe")
else()
  set(supply_chain_tool "bin/bext_supply_chain")
endif()
bext_track_noinstall("${supply_chain_tool}" "bext-supply-chain")
bext_track_noinstall("share/doc/legal/bext-supply-chain-public-domain.txt" "bext-supply-chain")
bext_track_noinstall("share/doc/legal/nlohmann-json.txt" "nlohmann-json")
bext_track_noinstall("build-stamp" "bext-supply-chain")
list(REMOVE_DUPLICATES noinstall_files)
list(SORT noinstall_files)
list(SORT noinstall_records)

file(GLOB_RECURSE actual_noinstall_files LIST_DIRECTORIES false
  RELATIVE "${BEXT_NOINSTALL_ROOT}" "${BEXT_NOINSTALL_ROOT}/*")
set(untracked_noinstall_files ${actual_noinstall_files})
if(noinstall_files)
  list(REMOVE_ITEM untracked_noinstall_files ${noinstall_files})
endif()
list(SORT untracked_noinstall_files)
set(untracked_report "${BEXT_BINARY_ROOT}/bext-untracked-noinstall-files.txt")
if(untracked_noinstall_files)
  string(REPLACE ";" "\n" report "${untracked_noinstall_files}")
  file(WRITE "${untracked_report}.tmp" "${report}\n")
  file(COPY_FILE "${untracked_report}.tmp" "${untracked_report}" ONLY_IF_DIFFERENT)
  file(REMOVE "${untracked_report}.tmp")
  list(LENGTH untracked_noinstall_files count)
  message(STATUS "Excluded ${count} untracked noinstall files; see ${untracked_report}")
else()
  file(REMOVE "${untracked_report}")
endif()

set(noinstall_entries "")
set(separator "")
foreach(path IN LISTS noinstall_files)
  bext_json_escape(path_json "${path}")
  string(APPEND noinstall_entries "${separator}    \"${path_json}\"")
  set(separator ",\n")
endforeach()
file(WRITE "${BEXT_NOINSTALL_MANIFEST}.tmp"
  "{\n  \"schema\": 1,\n  \"platform\": \"${BEXT_SYSTEM_NAME}\",\n  \"install_root\": \"noinstall\",\n  \"generated_by\": \"bext\",\n  \"files\": [\n${noinstall_entries}\n  ]\n}\n")
file(COPY_FILE "${BEXT_NOINSTALL_MANIFEST}.tmp" "${BEXT_NOINSTALL_MANIFEST}" ONLY_IF_DIFFERENT)
file(REMOVE "${BEXT_NOINSTALL_MANIFEST}.tmp")

file(READ "${BEXT_COMPONENT_MANIFEST}" install_manifest)
set(package_manifest "${install_manifest}")
string(REGEX REPLACE "\"install_root\"[ \t\r\n]*:[ \t\r\n]*\"install\""
  "\"install_root\": \".\""
  package_manifest "${package_manifest}")
string(REGEX REPLACE "\"path\"[ \t\r\n]*:[ \t\r\n]*\""
  "\"path\": \"install/"
  package_manifest "${package_manifest}")
string(JSON install_file_count LENGTH "${install_manifest}" files)
set(file_entries "")
if(install_file_count GREATER 0)
  set(separator ",\n")
else()
  set(separator "")
endif()
foreach(record IN LISTS noinstall_records)
  string(FIND "${record}" "|" split)
  string(SUBSTRING "${record}" 0 ${split} path)
  math(EXPR component_start "${split} + 1")
  string(SUBSTRING "${record}" ${component_start} -1 component)
  bext_json_escape(path_json "noinstall/${path}")
  bext_json_escape(component_json "${component}")
  string(APPEND file_entries
    "${separator}    {\"path\": \"${path_json}\", \"component\": \"${component_json}\"}")
  set(separator ",\n")
endforeach()
string(REGEX REPLACE
  "[]][ \t\r\n]*,[ \t\r\n]*\"packages\"[ \t\r\n]*:[ \t\r\n]*[[]"
  "${file_entries}\n  ],\n  \"packages\": [" package_manifest "${package_manifest}")

set(package_entries "")
set(package_separator "")
string(JSON install_package_count LENGTH "${install_manifest}" packages)
if(install_package_count GREATER 0)
  set(package_separator ",\n")
endif()
if(NOT install_manifest MATCHES
    "\"component\"[ \t\r\n]*:[ \t\r\n]*\"bext-supply-chain\"")
  string(APPEND package_entries
    "${package_separator}    {\"component\": \"bext-supply-chain\", \"id\": \"CMake/SupplyChain\", \"spdx_id\": \"SPDXRef-Package-bext-supply-chain\", \"primary\": true, \"output\": \"noinstall\"}")
  set(package_separator ",\n")
endif()
if(NOT install_manifest MATCHES
    "\"component\"[ \t\r\n]*:[ \t\r\n]*\"nlohmann-json\"")
  string(APPEND package_entries
    "${package_separator}    {\"component\": \"nlohmann-json\", \"id\": \"CMake/json.hpp\", \"spdx_id\": \"SPDXRef-Package-nlohmann-json\", \"primary\": true, \"output\": \"noinstall\"}")
endif()
string(REGEX MATCH "[]][ \t\r\n]*\}[ \t\r\n]*$" package_suffix "${package_manifest}")
if(package_suffix STREQUAL "")
  message(FATAL_ERROR "Unable to locate the package array in ${BEXT_COMPONENT_MANIFEST}")
endif()
string(FIND "${package_manifest}" "${package_suffix}" package_end REVERSE)
string(SUBSTRING "${package_manifest}" 0 ${package_end} package_prefix)
file(WRITE "${BEXT_PACKAGE_COMPONENT_MANIFEST}.tmp"
  "${package_prefix}${package_entries}${package_suffix}")
file(COPY_FILE "${BEXT_PACKAGE_COMPONENT_MANIFEST}.tmp"
  "${BEXT_PACKAGE_COMPONENT_MANIFEST}" ONLY_IF_DIFFERENT)
file(REMOVE "${BEXT_PACKAGE_COMPONENT_MANIFEST}.tmp")
message(STATUS "Generated bext noinstall manifest: ${BEXT_NOINSTALL_MANIFEST}")
message(STATUS "Generated bext package component manifest: ${BEXT_PACKAGE_COMPONENT_MANIFEST}")
