# Derive bext dependency metadata from the existing build files.  This module
# combines directory-local BextPackage.cmake descriptors, build declarations,
# .deps files, and .gitmodules. HEAD describes a committed inventory; INDEX
# validates staged changes.

function(bext_inventory_read_file out source_dir path)
  get_property(revision GLOBAL PROPERTY BEXT_INVENTORY_REVISION)
  execute_process(
    COMMAND git show "${revision}:${path}"
    WORKING_DIRECTORY "${source_dir}"
    RESULT_VARIABLE result OUTPUT_VARIABLE content ERROR_VARIABLE error
    ENCODING UTF-8
  )
  if (NOT result EQUAL 0)
    message(FATAL_ERROR "Unable to read metadata ${path} from ${BEXT_INVENTORY_MODE}: ${error}")
  endif ()
  set(${out} "${content}" PARENT_SCOPE)
endfunction()

function(_bext_inventory_read_lines out source_dir path)
  bext_inventory_read_file(content "${source_dir}" "${path}")
  string(REPLACE ";" "\\;" lines "${content}")
  string(REPLACE "\r" "" lines "${lines}")
  string(REPLACE "\n" ";" lines "${lines}")
  set(${out} "${lines}" PARENT_SCOPE)
endfunction()

function(_bext_inventory_has_file out path)
  get_property(files GLOBAL PROPERTY BEXT_INVENTORY_FILES)
  list(FIND files "${path}" index)
  if (index EQUAL -1)
    set(${out} FALSE PARENT_SCOPE)
  else ()
    set(${out} TRUE PARENT_SCOPE)
  endif ()
endfunction()
# Canonical identity and license assertions live in directory-local BextPackage.cmake files.

function(_bext_inventory_key out value)
  string(TOUPPER "${value}" key)
  string(REGEX REPLACE "[^A-Z0-9]" "_" key "${key}")
  set(${out} "${key}" PARENT_SCOPE)
endfunction()

function(_bext_inventory_set project field value)
  _bext_inventory_key(key "${project}")
  set_property(GLOBAL PROPERTY "BEXT_INVENTORY_${key}_${field}" "${value}")
endfunction()

function(bext_inventory_get out project field)
  _bext_inventory_key(key "${project}")
  get_property(value GLOBAL PROPERTY "BEXT_INVENTORY_${key}_${field}")
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(bext_inventory_spdx_id out source)
  string(REGEX REPLACE "[^A-Za-z0-9.-]" "-" id "${source}")
  set(${out} "SPDXRef-Package-${id}" PARENT_SCOPE)
endfunction()

function(bext_inventory_package_records out)
  set(records)
  foreach(project ${BEXT_INVENTORY_PROJECTS})
    bext_inventory_get(paths "${project}" SUBMODULE_PATHS)
    set(primary TRUE)
    foreach(path ${paths})
      bext_inventory_spdx_id(spdx_id "${path}")
      list(APPEND records "${project}|${path}|${spdx_id}|${primary}")
      set(primary FALSE)
    endforeach()
  endforeach()
  get_property(subcomponents GLOBAL PROPERTY BEXT_SBOM_SUBCOMPONENTS)
  foreach(subcomponent ${subcomponents})
    bext_inventory_get(parent "${subcomponent}" SBOM_PARENT)
    set(project "")
    foreach(candidate ${BEXT_INVENTORY_PROJECTS})
      bext_inventory_get(paths "${candidate}" SUBMODULE_PATHS)
      if(parent IN_LIST paths)
        set(project "${candidate}")
        break()
      endif()
    endforeach()
    if(NOT project)
      message(FATAL_ERROR "No package project owns SBOM subcomponent ${subcomponent}")
    endif()
    bext_inventory_spdx_id(spdx_id "${subcomponent}")
    list(APPEND records "${project}|${subcomponent}|${spdx_id}|FALSE")
  endforeach()
  set(${out} "${records}" PARENT_SCOPE)
endfunction()

function(bext_package project)
  cmake_parse_arguments(P "" "OUTPUT" "GROUPS;LEGAL_NAMES;PROVIDERS" ${ARGN})
  if(P_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown package descriptor arguments for ${project}: ${P_UNPARSED_ARGUMENTS}")
  endif()
  get_property(expected_project GLOBAL PROPERTY BEXT_DESCRIPTOR_EXPECTED_PROJECT)
  if(expected_project AND NOT project STREQUAL expected_project)
    message(FATAL_ERROR "Descriptor for ${expected_project} declares package ${project}")
  endif()
  if(P_LEGAL_NAMES)
    set(legal_names "${P_LEGAL_NAMES}")
  else()
    set(legal_names "${project}")
  endif()
  _bext_inventory_set("${project}" LEGAL_NAMES "${legal_names}")
  if(NOT P_OUTPUT MATCHES "^(install|noinstall)$")
    message(FATAL_ERROR "Package ${project} must declare OUTPUT install or noinstall")
  endif()
  _bext_inventory_set("${project}" OUTPUT "${P_OUTPUT}")
  _bext_inventory_set("${project}" GROUPS "${P_GROUPS}")
  _bext_inventory_set("${project}" PROVIDERS "${P_PROVIDERS}")
  _bext_inventory_set("${project}" DESCRIPTOR_LOADED TRUE)
endfunction()

function(bext_load_package_descriptor source_dir project)
  set(BEXT_PACKAGE_DIR "${source_dir}/${project}")
  set(descriptor "${BEXT_PACKAGE_DIR}/BextPackage.cmake")
  if(ARGV2 STREQUAL "SNAPSHOT")
    _bext_inventory_has_file(has_descriptor "${project}/BextPackage.cmake")
  else()
    set(has_descriptor FALSE)
    if(EXISTS "${descriptor}")
      set(has_descriptor TRUE)
    endif()
  endif()
  if(NOT has_descriptor)
    message(FATAL_ERROR "Project ${project} has no BextPackage.cmake descriptor")
  endif()
  set_property(GLOBAL PROPERTY BEXT_DESCRIPTOR_EXPECTED_PROJECT "${project}")
  _bext_inventory_set("${project}" DESCRIPTOR_LOADED FALSE)
  if(ARGV2 STREQUAL "SNAPSHOT")
    set(BEXT_PACKAGE_BUILD_ONLY FALSE)
    bext_inventory_read_file(descriptor_text "${source_dir}" "${project}/BextPackage.cmake")
    cmake_language(EVAL CODE "${descriptor_text}")
  else()
    set(BEXT_PACKAGE_BUILD_ONLY TRUE)
    include("${descriptor}")
  endif()
  set_property(GLOBAL PROPERTY BEXT_DESCRIPTOR_EXPECTED_PROJECT "")
  bext_inventory_get(descriptor_loaded "${project}" DESCRIPTOR_LOADED)
  if(NOT descriptor_loaded)
    message(FATAL_ERROR "${descriptor} does not declare bext_package(${project})")
  endif()
endfunction()

function(bext_sbom_component source)
  cmake_parse_arguments(M "" "NAME;VERSION;UPSTREAM_URL;DOWNLOAD_LOCATION;PURL;PURL_BASE;PURL_SUBPATH;CPE;CPE_STATUS;CPE_PRODUCT_EVIDENCE;CPE_COMMENT;COPYRIGHT_TEXT;COPYRIGHT_FILE;COPYRIGHT_SHA256;COPYRIGHT_REVIEWED_REVISION;LICENSE;LICENSE_CONCLUDED;LICENSE_NAME;LICENSE_FILE;LICENSE_SHA256;LICENSE_SOURCE_FILE;LICENSE_SOURCE_SHA256;LICENSE_COMMENT;PURPOSE;SCOPE;REVIEWED_REVISION" "LICENSE_FILES;LICENSE_SHA256S" ${ARGN})
  if (M_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown SBOM metadata arguments for ${source}: ${M_UNPARSED_ARGUMENTS}")
  endif()
  get_property(metadata_sources GLOBAL PROPERTY BEXT_SBOM_METADATA_SOURCES)
  list(APPEND metadata_sources "${source}")
  list(REMOVE_DUPLICATES metadata_sources)
  set_property(GLOBAL PROPERTY BEXT_SBOM_METADATA_SOURCES "${metadata_sources}")
  foreach(field NAME VERSION UPSTREAM_URL DOWNLOAD_LOCATION PURL PURL_BASE PURL_SUBPATH CPE CPE_STATUS CPE_PRODUCT_EVIDENCE CPE_COMMENT COPYRIGHT_TEXT COPYRIGHT_FILE COPYRIGHT_SHA256 COPYRIGHT_REVIEWED_REVISION LICENSE LICENSE_CONCLUDED LICENSE_NAME LICENSE_FILE LICENSE_SHA256 LICENSE_SOURCE_FILE LICENSE_SOURCE_SHA256 LICENSE_COMMENT PURPOSE SCOPE REVIEWED_REVISION LICENSE_FILES LICENSE_SHA256S)
    if (DEFINED M_${field})
      _bext_inventory_set("${source}" "SBOM_${field}" "${M_${field}}")
    endif()
  endforeach()
endfunction()

function(bext_sbom_subcomponent source component)
  set(key "${source}#${component}")
  bext_sbom_component("${key}" ${ARGN})
  _bext_inventory_set("${key}" SBOM_PARENT "${source}")
  _bext_inventory_set("${key}" SBOM_COMPONENT "${component}")
  get_property(subcomponents GLOBAL PROPERTY BEXT_SBOM_SUBCOMPONENTS)
  list(APPEND subcomponents "${key}")
  list(REMOVE_DUPLICATES subcomponents)
  set_property(GLOBAL PROPERTY BEXT_SBOM_SUBCOMPONENTS "${subcomponents}")
endfunction()

function(_bext_inventory_license_path out source_dir base path)
  if (path MATCHES "^@/(.+)$")
    set(license_path "${source_dir}/${CMAKE_MATCH_1}")
  else()
    set(license_path "${source_dir}/${base}/${path}")
  endif()
  cmake_path(NORMAL_PATH license_path)
  set(${out} "${license_path}" PARENT_SCOPE)
endfunction()

function(_bext_inventory_evidence_exists out source_dir base path)
  _bext_inventory_license_path(evidence_path "${source_dir}" "${base}" "${path}")
  file(RELATIVE_PATH relative_path "${source_dir}" "${evidence_path}")
  _bext_inventory_has_file(in_snapshot "${relative_path}")
  if(in_snapshot OR EXISTS "${evidence_path}")
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(_bext_inventory_read_evidence out source_dir base path)
  _bext_inventory_license_path(evidence_path "${source_dir}" "${base}" "${path}")
  file(RELATIVE_PATH relative_path "${source_dir}" "${evidence_path}")
  _bext_inventory_has_file(in_snapshot "${relative_path}")
  if(in_snapshot)
    bext_inventory_read_file(content "${source_dir}" "${relative_path}")
  else()
    file(READ "${evidence_path}" content)
  endif()
  set(${out} "${content}" PARENT_SCOPE)
endfunction()

function(_bext_inventory_submodule_lookup out_url out_sha source_dir path)
  get_property(entries GLOBAL PROPERTY BEXT_INVENTORY_SUBMODULES)
  foreach(entry ${entries})
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 entry_path)
    if ("${entry_path}" STREQUAL "${path}")
      list(GET parts 1 entry_url)
      get_property(revision GLOBAL PROPERTY BEXT_INVENTORY_REVISION)
      if (BEXT_INVENTORY_MODE STREQUAL "INDEX")
        set(command git --literal-pathspecs ls-files --stage -- "${path}")
        set(pattern "^160000 ([0-9a-f]+) 0\t[^\n]+$")
      else ()
        set(command git --literal-pathspecs ls-tree "${revision}" -- "${path}")
        set(pattern "^160000 commit ([0-9a-f]+)\t[^\n]+$")
      endif ()
      execute_process(
        COMMAND ${command}
        WORKING_DIRECTORY "${source_dir}"
        RESULT_VARIABLE tree_result
        OUTPUT_VARIABLE tree_line
        OUTPUT_STRIP_TRAILING_WHITESPACE
      )
      if (NOT tree_result EQUAL 0 OR NOT tree_line MATCHES "${pattern}")
        message(FATAL_ERROR "Unable to read pinned commit for submodule ${path} from ${BEXT_INVENTORY_MODE}; stage its gitlink for INDEX validation")
      endif()
      set(${out_url} "${entry_url}" PARENT_SCOPE)
      set(${out_sha} "${CMAKE_MATCH_1}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out_url} "" PARENT_SCOPE)
  set(${out_sha} "" PARENT_SCOPE)
endfunction()

function(bext_collect_dependency_inventory source_dir)
  get_filename_component(source_dir "${source_dir}" ABSOLUTE)
  if (NOT DEFINED BEXT_INVENTORY_MODE)
    set(BEXT_INVENTORY_MODE HEAD)
  endif ()
  if (BEXT_INVENTORY_MODE STREQUAL "HEAD")
    execute_process(COMMAND git rev-parse --verify HEAD
      WORKING_DIRECTORY "${source_dir}" RESULT_VARIABLE result
      OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE)
    if (NOT result EQUAL 0)
      message(FATAL_ERROR "Unable to resolve HEAD in ${source_dir}")
    endif ()
    set(command git ls-tree -r --name-only "${revision}")
  elseif (BEXT_INVENTORY_MODE STREQUAL "INDEX")
    # git show :0:path selects stage zero and rejects conflicted entries.
    set(revision ":0")
    set(command git ls-files)
  else ()
    message(FATAL_ERROR "Unknown BEXT_INVENTORY_MODE ${BEXT_INVENTORY_MODE}; expected HEAD or INDEX")
  endif ()
  set_property(GLOBAL PROPERTY BEXT_INVENTORY_REVISION "${revision}")
  execute_process(COMMAND ${command} WORKING_DIRECTORY "${source_dir}"
    RESULT_VARIABLE result OUTPUT_VARIABLE files OUTPUT_STRIP_TRAILING_WHITESPACE)
  if (NOT result EQUAL 0)
    message(FATAL_ERROR "Unable to list ${BEXT_INVENTORY_MODE} metadata in ${source_dir}")
  endif ()
  string(REPLACE "\n" ";" files "${files}")
  set_property(GLOBAL PROPERTY BEXT_INVENTORY_FILES "${files}")
  set_property(GLOBAL PROPERTY BEXT_SBOM_METADATA_SOURCES "")
  set_property(GLOBAL PROPERTY BEXT_SBOM_SUBCOMPONENTS "")

  # Read submodule paths and URLs without requiring submodules to be populated.
  _bext_inventory_read_lines(gitmodule_lines "${source_dir}" .gitmodules)
  set(submodules)
  set(current_path "")
  foreach(line ${gitmodule_lines})
    string(STRIP "${line}" line)
    if (line MATCHES "^path = (.+)$")
      set(current_path "${CMAKE_MATCH_1}")
    elseif(line MATCHES "^url = (.+)$" AND current_path)
      list(APPEND submodules "${current_path}|${CMAKE_MATCH_1}")
      set(current_path "")
    endif()
  endforeach()
  set_property(GLOBAL PROPERTY BEXT_INVENTORY_SUBMODULES "${submodules}")

  get_property(snapshot_files GLOBAL PROPERTY BEXT_INVENTORY_FILES)
  set(descriptor_files)
  foreach(snapshot_file IN LISTS snapshot_files)
    if(snapshot_file MATCHES "^[^/]+/BextPackage[.]cmake$")
      list(APPEND descriptor_files "${snapshot_file}")
    endif()
  endforeach()
  set(projects)
  foreach(descriptor ${descriptor_files})
    get_filename_component(project "${descriptor}" DIRECTORY)
    list(APPEND projects "${project}")
  endforeach()
  list(REMOVE_DUPLICATES projects)

  foreach(project ${projects})
    bext_load_package_descriptor("${source_dir}" "${project}" SNAPSHOT)
    bext_inventory_get(groups "${project}" GROUPS)
    if(NOT groups)
      _bext_inventory_set("${project}" GROUPS "always considered")
    endif()
  endforeach()

  set(all_providers)
  foreach(project ${projects})
    set(wrapper "${project}/CMakeLists.txt")
    _bext_inventory_has_file(has_wrapper "${wrapper}")
    if (NOT has_wrapper)
      message(FATAL_ERROR "Project ${project} has no wrapper CMakeLists.txt")
    endif()
    bext_inventory_read_file(wrapper_text "${source_dir}" "${wrapper}")
    bext_inventory_get(output_class "${project}" OUTPUT)

    set(deps)
    set(depfile "${project}/${project}.deps")
    _bext_inventory_has_file(has_deps "${depfile}")
    if (has_deps)
      _bext_inventory_read_lines(dep_lines "${source_dir}" "${depfile}")
      foreach(dep ${dep_lines})
        string(STRIP "${dep}" dep)
        if (dep AND NOT dep MATCHES "^#")
          string(TOLOWER "${dep}" dep)
          string(REPLACE "_" "-" dep "${dep}")
          list(APPEND deps "${dep}")
        endif()
      endforeach()
    endif()
    list(REMOVE_DUPLICATES deps)
    _bext_inventory_set("${project}" DEPS "${deps}")

    set(paths)
    set(urls)
    set(shas)
    set(providers)
    set(local_source_path "")
    if(wrapper_text MATCHES "bext_local_source\\([A-Za-z0-9_+-]+ +([A-Za-z0-9_+./-]+) +([^ )]+) +([0-9a-f]+)\\)")
      set(local_source_path "${project}/${CMAKE_MATCH_1}")
      set(local_source_url "${CMAKE_MATCH_2}")
      set(local_source_sha "${CMAKE_MATCH_3}")
    endif()
    get_property(metadata_sources GLOBAL PROPERTY BEXT_SBOM_METADATA_SOURCES)
    if(local_source_path AND NOT local_source_path IN_LIST metadata_sources)
      list(APPEND metadata_sources "${local_source_path}")
    endif()
    foreach(path ${metadata_sources})
      bext_inventory_get(parent_source "${path}" SBOM_PARENT)
      if(parent_source OR NOT path MATCHES "^${project}/")
        continue()
      endif()
      if(path STREQUAL local_source_path)
        set(url "${local_source_url}")
        set(sha "${local_source_sha}")
      else()
        _bext_inventory_submodule_lookup(url sha "${source_dir}" "${path}")
      endif()
      if (NOT url)
        message(FATAL_ERROR "${project} registers ${path}, but it is absent from .gitmodules")
      endif()
      list(APPEND paths "${path}")
      list(APPEND urls "${url}")
      list(APPEND shas "${sha}")
    endforeach()
    if (NOT paths)
      message(FATAL_ERROR "Project ${project} does not declare an upstream source")
    endif()
    _bext_inventory_set("${project}" SUBMODULE_PATHS "${paths}")

    _bext_inventory_set("${project}" SOURCE_URLS "${urls}")
    _bext_inventory_set("${project}" SOURCE_SHAS "${shas}")

    bext_inventory_get(providers "${project}" PROVIDERS)
    foreach(provider ${providers})
      list(APPEND all_providers "${provider}")
    endforeach()
  endforeach()

  get_property(metadata_sources GLOBAL PROPERTY BEXT_SBOM_METADATA_SOURCES)
  foreach(metadata_source ${metadata_sources})
    bext_inventory_get(parent_source "${metadata_source}" SBOM_PARENT)
    if (parent_source)
      set(lookup_source "${parent_source}")
    else()
      set(lookup_source "${metadata_source}")
    endif()
    set(source_known FALSE)
    set(source_revision "")
    foreach(project ${projects})
      bext_inventory_get(project_paths "${project}" SUBMODULE_PATHS)
      list(FIND project_paths "${lookup_source}" metadata_source_index)
      if (NOT metadata_source_index EQUAL -1)
        bext_inventory_get(project_shas "${project}" SOURCE_SHAS)
        list(GET project_shas ${metadata_source_index} source_revision)
        set(source_known TRUE)
        break()
      endif()
    endforeach()
    if (NOT source_known)
      message(FATAL_ERROR "SBOM metadata references unknown source ${metadata_source}")
    endif()

    bext_inventory_get(version "${metadata_source}" SBOM_VERSION)
    bext_inventory_get(purl "${metadata_source}" SBOM_PURL)
    bext_inventory_get(purl_base "${metadata_source}" SBOM_PURL_BASE)
    bext_inventory_get(purl_subpath "${metadata_source}" SBOM_PURL_SUBPATH)
    bext_inventory_get(cpe "${metadata_source}" SBOM_CPE)
    bext_inventory_get(cpe_status "${metadata_source}" SBOM_CPE_STATUS)
    bext_inventory_get(cpe_product_evidence "${metadata_source}" SBOM_CPE_PRODUCT_EVIDENCE)
    bext_inventory_get(cpe_comment "${metadata_source}" SBOM_CPE_COMMENT)
    bext_inventory_get(copyright_text "${metadata_source}" SBOM_COPYRIGHT_TEXT)
    bext_inventory_get(copyright_file "${metadata_source}" SBOM_COPYRIGHT_FILE)
    bext_inventory_get(copyright_sha256 "${metadata_source}" SBOM_COPYRIGHT_SHA256)
    bext_inventory_get(copyright_reviewed_revision "${metadata_source}" SBOM_COPYRIGHT_REVIEWED_REVISION)
    bext_inventory_get(license "${metadata_source}" SBOM_LICENSE)
    bext_inventory_get(license_concluded "${metadata_source}" SBOM_LICENSE_CONCLUDED)
    bext_inventory_get(license_name "${metadata_source}" SBOM_LICENSE_NAME)
    bext_inventory_get(license_file "${metadata_source}" SBOM_LICENSE_FILE)
    bext_inventory_get(license_sha256 "${metadata_source}" SBOM_LICENSE_SHA256)
    bext_inventory_get(license_files "${metadata_source}" SBOM_LICENSE_FILES)
    bext_inventory_get(license_sha256s "${metadata_source}" SBOM_LICENSE_SHA256S)
    bext_inventory_get(license_source_file "${metadata_source}" SBOM_LICENSE_SOURCE_FILE)
    bext_inventory_get(license_source_sha256 "${metadata_source}" SBOM_LICENSE_SOURCE_SHA256)
    bext_inventory_get(purpose "${metadata_source}" SBOM_PURPOSE)
    bext_inventory_get(scope "${metadata_source}" SBOM_SCOPE)
    bext_inventory_get(reviewed_revision "${metadata_source}" SBOM_REVIEWED_REVISION)
    if (reviewed_revision AND NOT reviewed_revision STREQUAL source_revision)
      message(FATAL_ERROR "SBOM metadata for ${metadata_source} was reviewed at ${reviewed_revision}, but the pinned source is ${source_revision}")
    endif()
    if (copyright_reviewed_revision AND NOT copyright_reviewed_revision STREQUAL source_revision)
      message(FATAL_ERROR "SBOM copyright metadata for ${metadata_source} was reviewed at ${copyright_reviewed_revision}, but the pinned source is ${source_revision}")
    endif()
    if (purl AND NOT version)
      message(FATAL_ERROR "SBOM PURL for ${metadata_source} requires VERSION")
    endif()
    if (purl AND purl_base)
      message(FATAL_ERROR "SBOM metadata for ${metadata_source} cannot declare both PURL and PURL_BASE")
    endif()
    if (purl_subpath AND NOT purl_base)
      message(FATAL_ERROR "SBOM metadata for ${metadata_source} requires PURL_BASE when PURL_SUBPATH is set")
    endif()
    if (purl AND NOT purl MATCHES "^pkg:[a-z0-9.+-]+/[^@]+@[^@]+$")
      message(FATAL_ERROR "Invalid package URL for ${metadata_source}: ${purl}")
    endif()
    if (purl_base AND NOT purl_base MATCHES "^pkg:[a-z0-9.+-]+/[^@?]+$")
      message(FATAL_ERROR "Invalid package URL base for ${metadata_source}: ${purl_base}")
    endif()
    if (purl_subpath AND (purl_subpath MATCHES "^/" OR purl_subpath MATCHES "(^|/)\\.\\.(/|$)" OR purl_subpath MATCHES "[?#\\\\]"))
      message(FATAL_ERROR "Invalid package URL subpath for ${metadata_source}: ${purl_subpath}")
    endif()
    if(NOT cpe_status)
      set(cpe_status "UNRESOLVED")
    endif()
    if(NOT cpe_status MATCHES "^(NVD_EXACT|NVD_PRODUCT|NOT_APPLICABLE|UNRESOLVED)$")
      message(FATAL_ERROR "Invalid CPE_STATUS for ${metadata_source}: ${cpe_status}")
    endif()
    if(cpe)
      string(REPLACE ":" ";" cpe_fields "${cpe}")
      list(LENGTH cpe_fields cpe_field_count)
      if(NOT cpe MATCHES "^cpe:2\\.3:[aho]:[!-~]+$" OR NOT cpe_field_count EQUAL 13)
        message(FATAL_ERROR "Invalid CPE 2.3 formatted string for ${metadata_source}: ${cpe}")
      endif()
      if(NOT cpe_status MATCHES "^NVD_(EXACT|PRODUCT)$")
        message(FATAL_ERROR "SBOM CPE for ${metadata_source} requires CPE_STATUS NVD_EXACT or NVD_PRODUCT")
      endif()
      if(NOT version)
        message(FATAL_ERROR "SBOM CPE for ${metadata_source} requires VERSION")
      endif()
      list(GET cpe_fields 5 cpe_version)
      if(cpe_version MATCHES "^[*-]$" OR NOT cpe_version STREQUAL version)
        message(FATAL_ERROR "SBOM CPE version for ${metadata_source} must equal VERSION ${version}, not ${cpe_version}")
      endif()
    elseif(cpe_status MATCHES "^NVD_(EXACT|PRODUCT)$")
      message(FATAL_ERROR "CPE_STATUS ${cpe_status} for ${metadata_source} requires CPE")
    endif()
    if(cpe_status STREQUAL "NVD_PRODUCT")
      if(NOT cpe_product_evidence)
        message(FATAL_ERROR "CPE_STATUS NVD_PRODUCT for ${metadata_source} requires CPE_PRODUCT_EVIDENCE")
      endif()
      string(REPLACE ":" ";" cpe_evidence_fields "${cpe_product_evidence}")
      list(LENGTH cpe_evidence_fields cpe_evidence_field_count)
      if(NOT cpe_product_evidence MATCHES "^cpe:2\\.3:[aho]:[!-~]+$" OR NOT cpe_evidence_field_count EQUAL 13)
        message(FATAL_ERROR "Invalid CPE_PRODUCT_EVIDENCE for ${metadata_source}: ${cpe_product_evidence}")
      endif()
      foreach(cpe_identity_index RANGE 2 4)
        list(GET cpe_fields ${cpe_identity_index} cpe_identity_field)
        list(GET cpe_evidence_fields ${cpe_identity_index} cpe_evidence_identity_field)
        if(NOT cpe_identity_field STREQUAL cpe_evidence_identity_field)
          message(FATAL_ERROR "CPE product identity for ${metadata_source} does not match CPE_PRODUCT_EVIDENCE")
        endif()
      endforeach()
    elseif(cpe_product_evidence)
      message(FATAL_ERROR "CPE_PRODUCT_EVIDENCE for ${metadata_source} is only valid with CPE_STATUS NVD_PRODUCT")
    endif()
    if(cpe_status STREQUAL "NOT_APPLICABLE" AND NOT cpe_comment)
      message(FATAL_ERROR "CPE_STATUS NOT_APPLICABLE for ${metadata_source} requires CPE_COMMENT")
    endif()
    if (copyright_text AND copyright_file)
      message(FATAL_ERROR "SBOM metadata for ${metadata_source} cannot declare both COPYRIGHT_TEXT and COPYRIGHT_FILE")
    endif()
    if ((copyright_file AND NOT copyright_sha256) OR (copyright_sha256 AND NOT copyright_file))
      message(FATAL_ERROR "SBOM copyright evidence for ${metadata_source} requires COPYRIGHT_FILE and COPYRIGHT_SHA256 together")
    endif()
    if (copyright_reviewed_revision AND NOT copyright_text AND NOT copyright_file)
      message(FATAL_ERROR "SBOM copyright metadata for ${metadata_source} has COPYRIGHT_REVIEWED_REVISION without an assertion")
    endif()
    if (copyright_file)
      string(LENGTH "${copyright_sha256}" copyright_sha256_length)
      if (NOT copyright_sha256_length EQUAL 64 OR NOT copyright_sha256 MATCHES "^[0-9A-Fa-f]+$")
        message(FATAL_ERROR "Invalid copyright SHA-256 for ${metadata_source}: ${copyright_sha256}")
      endif()
      _bext_inventory_license_path(copyright_path "${source_dir}" "${lookup_source}" "${copyright_file}")
      _bext_inventory_evidence_exists(has_copyright "${source_dir}" "${lookup_source}" "${copyright_file}")
      if (copyright_file MATCHES "^@/" OR EXISTS "${source_dir}/${lookup_source}/.git")
        if (NOT has_copyright)
          message(FATAL_ERROR "Declared copyright file for ${metadata_source} is missing: ${copyright_path}")
        endif()
        _bext_inventory_read_evidence(copyright_file_text "${source_dir}" "${lookup_source}" "${copyright_file}")
        string(REPLACE "\r\n" "\n" copyright_file_text "${copyright_file_text}")
        string(SHA256 actual_copyright_sha256 "${copyright_file_text}")
        string(TOLOWER "${actual_copyright_sha256}" actual_copyright_sha256)
        string(TOLOWER "${copyright_sha256}" expected_copyright_sha256)
        if (NOT actual_copyright_sha256 STREQUAL expected_copyright_sha256)
          message(FATAL_ERROR "Copyright file for ${metadata_source} changed; review it and update COPYRIGHT_SHA256 to ${actual_copyright_sha256}")
        endif()
      endif()
    endif()
    if (license AND NOT license MATCHES "^[A-Za-z0-9.+() -]+$")
      message(FATAL_ERROR "Invalid SPDX license expression for ${metadata_source}: ${license}")
    endif()
    if (license_concluded AND NOT license_concluded MATCHES "^[A-Za-z0-9.+() -]+$")
      message(FATAL_ERROR "Invalid concluded SPDX license expression for ${metadata_source}: ${license_concluded}")
    endif()
    if ((NOT "${license_file}" STREQUAL "" AND "${license_sha256}" STREQUAL "") OR
        (NOT "${license_sha256}" STREQUAL "" AND "${license_file}" STREQUAL ""))
      message(FATAL_ERROR "SBOM license verification for ${metadata_source} requires LICENSE_FILE and LICENSE_SHA256 together")
    endif()
    if ((NOT "${license_source_file}" STREQUAL "" AND "${license_source_sha256}" STREQUAL "") OR
        (NOT "${license_source_sha256}" STREQUAL "" AND "${license_source_file}" STREQUAL ""))
      message(FATAL_ERROR "SBOM source-license verification for ${metadata_source} requires LICENSE_SOURCE_FILE and LICENSE_SOURCE_SHA256 together")
    endif()
    if (license_file)
      list(APPEND license_files "${license_file}")
      list(APPEND license_sha256s "${license_sha256}")
    endif()
    list(LENGTH license_files license_file_count)
    list(LENGTH license_sha256s license_hash_count)
    if (NOT license_file_count EQUAL license_hash_count)
      message(FATAL_ERROR "SBOM license evidence for ${metadata_source} has ${license_file_count} files and ${license_hash_count} hashes")
    endif()
    if (license AND NOT license_files)
      message(FATAL_ERROR "Declared SPDX license for ${metadata_source} requires a pinned LICENSE_FILE")
    endif()
    set(has_repository_license_evidence FALSE)
    foreach(license_evidence_file IN LISTS license_files)
      if (license_evidence_file MATCHES "^@/")
        set(has_repository_license_evidence TRUE)
        break()
      endif()
    endforeach()
    if (has_repository_license_evidence AND NOT reviewed_revision)
      message(FATAL_ERROR
        "Repository-local license evidence for ${metadata_source} requires REVIEWED_REVISION")
    endif()
    if (license MATCHES "^LicenseRef-" AND NOT license_name)
      message(FATAL_ERROR "Custom license ${license} for ${metadata_source} requires LICENSE_NAME")
    endif()
    if (purpose AND NOT purpose MATCHES "^(APPLICATION|FRAMEWORK|LIBRARY|CONTAINER|OPERATING-SYSTEM|DEVICE|FIRMWARE|SOURCE|ARCHIVE|FILE|INSTALL|OTHER)$")
      message(FATAL_ERROR "Invalid SPDX package purpose for ${metadata_source}: ${purpose}")
    endif()
    if (scope AND NOT scope MATCHES "^(BUILD|RUNTIME|BOTH)$")
      message(FATAL_ERROR "Invalid dependency scope for ${metadata_source}: ${scope}")
    endif()
    if (license_files)
      math(EXPR license_file_last "${license_file_count} - 1")
      foreach(license_index RANGE ${license_file_last})
        list(GET license_files ${license_index} license_file)
        list(GET license_sha256s ${license_index} license_sha256)
        string(LENGTH "${license_sha256}" license_sha256_length)
        if (NOT license_sha256_length EQUAL 64 OR NOT license_sha256 MATCHES "^[0-9A-Fa-f]+$")
          message(FATAL_ERROR "Invalid license SHA-256 for ${metadata_source}: ${license_sha256}")
        endif()
        _bext_inventory_license_path(license_path "${source_dir}" "${lookup_source}" "${license_file}")
        _bext_inventory_evidence_exists(has_license "${source_dir}" "${lookup_source}" "${license_file}")
        if (license MATCHES "LicenseRef-" OR license_file MATCHES "^@/" OR EXISTS "${source_dir}/${lookup_source}/.git")
          if (NOT has_license)
            message(FATAL_ERROR "Declared license file for ${metadata_source} is missing: ${license_path}")
          endif()
          _bext_inventory_read_evidence(license_text "${source_dir}" "${lookup_source}" "${license_file}")
          string(REPLACE "\r\n" "\n" license_text "${license_text}")
          string(SHA256 actual_license_sha256 "${license_text}")
          string(TOLOWER "${actual_license_sha256}" actual_license_sha256)
          string(TOLOWER "${license_sha256}" expected_license_sha256)
          if (NOT actual_license_sha256 STREQUAL expected_license_sha256)
            message(FATAL_ERROR "License file for ${metadata_source} changed; review its SPDX expression and update LICENSE_SHA256 to ${actual_license_sha256}")
          endif()
        endif()
      endforeach()
    endif()
    if (license_source_file)
      _bext_inventory_license_path(source_license_path "${source_dir}" "${lookup_source}" "${license_source_file}")
      _bext_inventory_evidence_exists(has_source_license "${source_dir}" "${lookup_source}" "${license_source_file}")
      if (NOT has_source_license AND EXISTS "${source_dir}/${lookup_source}/.git")
        message(FATAL_ERROR "Source license file for ${metadata_source} is missing: ${source_license_path}")
      endif()
      if (has_source_license)
        _bext_inventory_read_evidence(source_license_text "${source_dir}" "${lookup_source}" "${license_source_file}")
        string(REPLACE "\r\n" "\n" source_license_text "${source_license_text}")
        string(SHA256 actual_source_license_sha256 "${source_license_text}")
        string(TOLOWER "${actual_source_license_sha256}" actual_source_license_sha256)
        string(TOLOWER "${license_source_sha256}" expected_source_license_sha256)
        if (NOT actual_source_license_sha256 STREQUAL expected_source_license_sha256)
          message(FATAL_ERROR "Source license for ${metadata_source} changed; review it and update LICENSE_SOURCE_SHA256 to ${actual_source_license_sha256}")
        endif()
      endif()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES all_providers)

  # Validate dependency references and topological consistency.
  foreach(project ${projects})
    bext_inventory_get(deps "${project}" DEPS)
    foreach(dep ${deps})
      list(FIND projects "${dep}" project_index)
      list(FIND all_providers "${dep}" provider_index)
      if (project_index EQUAL -1 AND provider_index EQUAL -1)
        message(FATAL_ERROR "${project}.deps references unknown dependency ${dep}")
      endif()
    endforeach()
  endforeach()

  set(resolved)
  set(remaining ${projects})
  while(remaining)
    set(progress FALSE)
    foreach(project ${remaining})
      bext_inventory_get(deps "${project}" DEPS)
      set(ready TRUE)
      foreach(dep ${deps})
        list(FIND projects "${dep}" dep_project_index)
        if (NOT dep_project_index EQUAL -1)
          list(FIND resolved "${dep}" resolved_index)
          if (resolved_index EQUAL -1)
            set(ready FALSE)
          endif()
        endif()
      endforeach()
      if (ready)
        list(APPEND resolved "${project}")
        list(REMOVE_ITEM remaining "${project}")
        set(progress TRUE)
      endif()
    endforeach()
    if (NOT progress)
      message(FATAL_ERROR "Dependency cycle detected among: ${remaining}")
    endif()
  endwhile()

  # Distributed outputs must install their legal notice alongside the bundle.
  foreach(project ${projects})
    bext_inventory_get(output_class "${project}" OUTPUT)
    bext_inventory_get(legal_names "${project}" LEGAL_NAMES)
    if (output_class STREQUAL "install" AND NOT legal_names)
      message(FATAL_ERROR "Bundled project ${project} has no registered legal material")
    endif()
  endforeach()

  list(SORT projects)
  set(BEXT_INVENTORY_MODE "${BEXT_INVENTORY_MODE}" PARENT_SCOPE)
  set(BEXT_INVENTORY_PROJECTS "${projects}" PARENT_SCOPE)
endfunction()
