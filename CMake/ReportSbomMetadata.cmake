cmake_minimum_required(VERSION 3.26)

if(NOT DEFINED BEXT_SOURCE_DIR)
  message(FATAL_ERROR "BEXT_SOURCE_DIR is required")
endif()
if(NOT DEFINED BEXT_REPORT_OUTPUT)
  message(FATAL_ERROR "BEXT_REPORT_OUTPUT is required")
endif()

include("${BEXT_SOURCE_DIR}/CMake/BextDependencyInventory.cmake")
bext_collect_dependency_inventory("${BEXT_SOURCE_DIR}")

set(copyright_gaps)
set(purl_gaps)
set(license_gaps)
set(concluded_license_gaps)
set(upstream_gaps)
set(cpe_exact)
set(cpe_product)
set(cpe_not_applicable)
set(cpe_unresolved)
get_property(metadata_sources GLOBAL PROPERTY BEXT_SBOM_METADATA_SOURCES)
foreach(source ${metadata_sources})
  bext_inventory_get(name "${source}" SBOM_NAME)
  if(NOT name)
    bext_inventory_get(name "${source}" SBOM_COMPONENT)
  endif()
  if(NOT name)
    set(name "${source}")
  endif()
  bext_inventory_get(version "${source}" SBOM_VERSION)
  if(NOT version)
    set(version "pinned Git revision")
  endif()
  set(entry "- ${name} (`${source}`, ${version})")

  bext_inventory_get(purl "${source}" SBOM_PURL)
  bext_inventory_get(purl_base "${source}" SBOM_PURL_BASE)
  if(NOT purl AND NOT purl_base)
    list(APPEND purl_gaps "${entry}")
  endif()

  bext_inventory_get(license "${source}" SBOM_LICENSE)
  if(NOT license)
    list(APPEND license_gaps "${entry}")
  endif()
  bext_inventory_get(license_concluded "${source}" SBOM_LICENSE_CONCLUDED)
  if(NOT license_concluded)
    list(APPEND concluded_license_gaps "${entry}")
  endif()

  bext_inventory_get(upstream_url "${source}" SBOM_UPSTREAM_URL)
  if(NOT upstream_url)
    list(APPEND upstream_gaps "${entry}")
  endif()

  bext_inventory_get(copyright_text "${source}" SBOM_COPYRIGHT_TEXT)
  bext_inventory_get(copyright_file "${source}" SBOM_COPYRIGHT_FILE)
  if(NOT copyright_text AND NOT copyright_file)
    list(APPEND copyright_gaps "${entry}")
  endif()

  bext_inventory_get(cpe "${source}" SBOM_CPE)
  bext_inventory_get(cpe_status "${source}" SBOM_CPE_STATUS)
  bext_inventory_get(cpe_product_evidence "${source}" SBOM_CPE_PRODUCT_EVIDENCE)
  bext_inventory_get(cpe_comment "${source}" SBOM_CPE_COMMENT)
  if(NOT cpe_status)
    set(cpe_status "UNRESOLVED")
  endif()
  if(cpe_status STREQUAL "NVD_EXACT")
    list(APPEND cpe_exact "${entry}: `${cpe}`")
  elseif(cpe_status STREQUAL "NVD_PRODUCT")
    set(cpe_product_entry "${entry}: `${cpe}` (NVD identity evidence: `${cpe_product_evidence}`)")
    if(cpe_comment)
      string(APPEND cpe_product_entry " — ${cpe_comment}")
    endif()
    list(APPEND cpe_product "${cpe_product_entry}")
  elseif(cpe_status STREQUAL "NOT_APPLICABLE")
    list(APPEND cpe_not_applicable "${entry}: ${cpe_comment}")
  else()
    list(APPEND cpe_unresolved "${entry}")
  endif()
endforeach()

list(SORT copyright_gaps)
list(SORT purl_gaps)
list(SORT license_gaps)
list(SORT concluded_license_gaps)
list(SORT upstream_gaps)
list(SORT cpe_exact)
list(SORT cpe_product)
list(SORT cpe_not_applicable)
list(SORT cpe_unresolved)
list(LENGTH metadata_sources component_count)
list(LENGTH copyright_gaps copyright_gap_count)
list(LENGTH purl_gaps purl_gap_count)
list(LENGTH license_gaps license_gap_count)
list(LENGTH concluded_license_gaps concluded_license_gap_count)
list(LENGTH upstream_gaps upstream_gap_count)
list(LENGTH cpe_exact cpe_exact_count)
list(LENGTH cpe_product cpe_product_count)
list(LENGTH cpe_not_applicable cpe_not_applicable_count)
list(LENGTH cpe_unresolved cpe_unresolved_count)
list(JOIN copyright_gaps "\n" copyright_gap_text)
list(JOIN purl_gaps "\n" purl_gap_text)
list(JOIN license_gaps "\n" license_gap_text)
list(JOIN concluded_license_gaps "\n" concluded_license_gap_text)
list(JOIN upstream_gaps "\n" upstream_gap_text)
list(JOIN cpe_exact "\n" cpe_exact_text)
list(JOIN cpe_product "\n" cpe_product_text)
list(JOIN cpe_not_applicable "\n" cpe_not_applicable_text)
list(JOIN cpe_unresolved "\n" cpe_unresolved_text)
foreach(report_text
    copyright_gap_text
    purl_gap_text
    license_gap_text
    concluded_license_gap_text
    upstream_gap_text
    cpe_exact_text
    cpe_product_text
    cpe_not_applicable_text
    cpe_unresolved_text)
  if("${${report_text}}" STREQUAL "")
    set(${report_text} "_None._")
  endif()
endforeach()

set(report "# SBOM metadata gaps\n\n")
string(APPEND report "Generated from the registered dependency metadata. These are review queues, not validation failures; `NOASSERTION` is preferable to guessed data.\n\n")
string(APPEND report "- Registered packages and subcomponents: ${component_count}\n")
string(APPEND report "- Missing PURLs: ${purl_gap_count}\n")
string(APPEND report "- Missing declared licenses: ${license_gap_count}\n")
string(APPEND report "- Missing concluded-license reviews: ${concluded_license_gap_count}\n")
string(APPEND report "- Missing reviewed copyright assertions: ${copyright_gap_count}\n")
string(APPEND report "- Missing upstream locations: ${upstream_gap_count}\n")
string(APPEND report "- Exact NVD CPE records: ${cpe_exact_count}\n")
string(APPEND report "- Established NVD product identities with local versions: ${cpe_product_count}\n")
string(APPEND report "- CPE not applicable: ${cpe_not_applicable_count}\n")
string(APPEND report "- Unresolved CPE reviews: ${cpe_unresolved_count}\n\n")
string(APPEND report "## PURL review queue\n\n${purl_gap_text}\n\n")
string(APPEND report "## Declared license review queue\n\n${license_gap_text}\n\n")
string(APPEND report "## Concluded license review queue\n\n${concluded_license_gap_text}\n\n")
string(APPEND report "## Copyright review queue\n\n${copyright_gap_text}\n\n")
string(APPEND report "## Upstream location review queue\n\n${upstream_gap_text}\n\n")
string(APPEND report "## Exact NVD CPEs\n\n${cpe_exact_text}\n\n")
string(APPEND report "## Established NVD product identities\n\n${cpe_product_text}\n\n")
string(APPEND report "## CPE not applicable\n\n${cpe_not_applicable_text}\n\n")
string(APPEND report "## CPE review queue\n\n${cpe_unresolved_text}\n")

get_filename_component(report_dir "${BEXT_REPORT_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${report_dir}")
file(WRITE "${BEXT_REPORT_OUTPUT}" "${report}")
message(STATUS
  "Wrote ${BEXT_REPORT_OUTPUT}: ${purl_gap_count} PURL, ${license_gap_count} declared license, "
  "${concluded_license_gap_count} concluded license, ${copyright_gap_count} copyright, "
  "${upstream_gap_count} upstream location, and ${cpe_unresolved_count} unresolved CPE reviews")
