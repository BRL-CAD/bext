cmake_minimum_required(VERSION 3.26)

if (NOT DEFINED BEXT_SOURCE_DIR)
  message(FATAL_ERROR "BEXT_SOURCE_DIR is required")
endif()
if (NOT DEFINED BEXT_SBOM_OUTPUT)
  message(FATAL_ERROR "BEXT_SBOM_OUTPUT is required")
endif()
if(BEXT_CYCLONEDX_OUTPUT)
  get_filename_component(spdx_path "${BEXT_SBOM_OUTPUT}" ABSOLUTE)
  get_filename_component(cdx_path "${BEXT_CYCLONEDX_OUTPUT}" ABSOLUTE)
  if(spdx_path STREQUAL cdx_path)
    message(FATAL_ERROR "SPDX and CycloneDX outputs must be distinct files")
  endif()
endif()
if (DEFINED BEXT_INVENTORY_MODE AND NOT BEXT_INVENTORY_MODE STREQUAL "HEAD")
  message(FATAL_ERROR "SBOM generation requires BEXT_INVENTORY_MODE=HEAD; use GenerateDependencyDocs.cmake with INDEX for staged validation")
endif ()

set(BEXT_SBOM_FINAL_OUTPUT "${BEXT_SBOM_OUTPUT}")
set(BEXT_SBOM_OUTPUT "${BEXT_SBOM_FINAL_OUTPUT}.tmp")
file(REMOVE "${BEXT_SBOM_FINAL_OUTPUT}" "${BEXT_SBOM_OUTPUT}")
if(BEXT_CYCLONEDX_OUTPUT)
  file(REMOVE "${BEXT_CYCLONEDX_OUTPUT}" "${BEXT_CYCLONEDX_OUTPUT}.tmp")
endif()

include("${BEXT_SOURCE_DIR}/CMake/BextDependencyInventory.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/BextSbomJson.cmake")
bext_collect_dependency_inventory("${BEXT_SOURCE_DIR}")

function(_bext_alias_key out value)
  string(TOUPPER "${value}" key)
  string(REGEX REPLACE "[^A-Z0-9]" "_" key "${key}")
  set(${out} "${key}" PARENT_SCOPE)
endfunction()

function(_bext_set_package_alias alias spdx_id)
  _bext_alias_key(key "${alias}")
  set_property(GLOBAL PROPERTY "BEXT_SBOM_ALIAS_${key}" "${spdx_id}")
endfunction()

function(_bext_get_package_alias out alias)
  _bext_alias_key(key "${alias}")
  get_property(spdx_id GLOBAL PROPERTY "BEXT_SBOM_ALIAS_${key}")
  set(${out} "${spdx_id}" PARENT_SCOPE)
endfunction()

get_property(bext_revision GLOBAL PROPERTY BEXT_INVENTORY_REVISION)
set(bext_commit "${bext_revision}")
execute_process(
  COMMAND git status --porcelain --untracked-files=normal
  WORKING_DIRECTORY "${BEXT_SOURCE_DIR}"
  RESULT_VARIABLE git_status_result
  OUTPUT_VARIABLE git_status
  OUTPUT_STRIP_TRAILING_WHITESPACE
)
if (NOT git_status_result EQUAL 0)
  message(FATAL_ERROR "Unable to determine whether the bext source tree is dirty")
endif()
execute_process(
  COMMAND git submodule foreach --quiet --recursive "git status --porcelain --untracked-files=normal"
  WORKING_DIRECTORY "${BEXT_SOURCE_DIR}"
  RESULT_VARIABLE git_submodule_status_result
  OUTPUT_VARIABLE git_submodule_status
  OUTPUT_STRIP_TRAILING_WHITESPACE
)
if (NOT git_submodule_status_result EQUAL 0)
  message(FATAL_ERROR "Unable to determine whether bext submodules are dirty")
endif()
if (git_status OR git_submodule_status)
  if (NOT BEXT_SBOM_ALLOW_DIRTY)
    message(FATAL_ERROR
      "Refusing to generate an SBOM from a dirty bext source tree. "
      "Set BEXT_SBOM_ALLOW_DIRTY=ON only for a deliberate non-release build.")
  endif()
  execute_process(
    COMMAND git diff --binary --full-index --no-ext-diff HEAD --
    WORKING_DIRECTORY "${BEXT_SOURCE_DIR}"
    RESULT_VARIABLE git_diff_result
    OUTPUT_VARIABLE git_diff
  )
  execute_process(
    COMMAND git ls-files --others --exclude-standard -- ":!*/"
    COMMAND git hash-object --stdin-paths --no-filters
    WORKING_DIRECTORY "${BEXT_SOURCE_DIR}"
    RESULTS_VARIABLE git_untracked_results
    OUTPUT_VARIABLE git_untracked_hashes
  )
  execute_process(
    COMMAND git submodule foreach --recursive "git diff --binary --full-index --no-ext-diff HEAD --"
    WORKING_DIRECTORY "${BEXT_SOURCE_DIR}"
    RESULT_VARIABLE git_submodule_diff_result
    OUTPUT_VARIABLE git_submodule_diff
  )
  execute_process(
    COMMAND git submodule foreach --recursive
      "git ls-files --others --exclude-standard | while IFS= read -r path; do if test -d \"$path\"; then find \"$path\" -type f ! -name .git -print; else printf '%s\\n' \"$path\"; fi; done | git hash-object --stdin-paths --no-filters"
    WORKING_DIRECTORY "${BEXT_SOURCE_DIR}"
    RESULT_VARIABLE git_submodule_untracked_result
    OUTPUT_VARIABLE git_submodule_untracked_hashes
  )
  if (NOT git_diff_result EQUAL 0 OR NOT "${git_untracked_results}" STREQUAL "0;0" OR
      NOT git_submodule_diff_result EQUAL 0 OR NOT git_submodule_untracked_result EQUAL 0)
    message(FATAL_ERROR "Unable to fingerprint the dirty bext source tree")
  endif()
  string(SHA256 dirty_digest
    "${git_status}\n${git_diff}\n${git_untracked_hashes}\n${git_submodule_status}\n${git_submodule_diff}\n${git_submodule_untracked_hashes}")
  string(SUBSTRING "${dirty_digest}" 0 12 dirty_digest)
  string(APPEND bext_revision "-dirty-${dirty_digest}")
endif()
execute_process(
  COMMAND git show -s --format=%ct "${bext_commit}"
  WORKING_DIRECTORY "${BEXT_SOURCE_DIR}"
  RESULT_VARIABLE git_timestamp_result
  OUTPUT_VARIABLE git_timestamp
  OUTPUT_STRIP_TRAILING_WHITESPACE
)
if (NOT git_timestamp_result EQUAL 0 OR NOT git_timestamp MATCHES "^[0-9]+$")
  message(FATAL_ERROR "Unable to determine the bext revision timestamp")
endif()
set(saved_source_date_epoch "$ENV{SOURCE_DATE_EPOCH}")
set(ENV{SOURCE_DATE_EPOCH} "${git_timestamp}")
string(TIMESTAMP created "%Y-%m-%dT%H:%M:%SZ" UTC)
set(ENV{SOURCE_DATE_EPOCH} "${saved_source_date_epoch}")

set(components)
foreach(project ${BEXT_INVENTORY_PROJECTS})
  bext_inventory_get(paths "${project}" SUBMODULE_PATHS)
  bext_inventory_get(urls "${project}" SOURCE_URLS)
  bext_inventory_get(shas "${project}" SOURCE_SHAS)
  list(LENGTH paths source_count)
  set(source_index 0)
  set(project_components)
  foreach(path ${paths})
    list(GET urls ${source_index} url)
    list(GET shas ${source_index} sha)
    math(EXPR source_index "${source_index} + 1")
    bext_inventory_get(name "${path}" SBOM_NAME)
    if (NOT name)
      if (source_count EQUAL 1)
        set(name "${project}")
      else()
        get_filename_component(name "${path}" NAME)
      endif()
    endif()
    bext_inventory_spdx_id(spdx_id "${path}")
    set(record "${project}|${path}|${url}|${sha}|${name}|${spdx_id}|TOP|NONE")
    list(APPEND components "${record}")
    list(APPEND project_components "${record}")
  endforeach()
  list(GET project_components 0 primary_record)
  string(REPLACE "|" ";" primary_parts "${primary_record}")
  list(GET primary_parts 5 primary_id)
  _bext_set_package_alias("${project}" "${primary_id}")

  bext_inventory_get(providers "${project}" PROVIDERS)
  foreach(provider ${providers})
    set(provider_id "")
    foreach(component ${project_components})
      string(REPLACE "|" ";" component_parts "${component}")
      list(GET component_parts 1 component_path)
      list(GET component_parts 5 component_id)
      get_filename_component(component_basename "${component_path}" NAME)
      string(TOLOWER "${component_basename}" component_basename)
      string(REPLACE "_" "-" component_basename "${component_basename}")
      if (component_basename STREQUAL provider)
        set(provider_id "${component_id}")
        break()
      endif()
    endforeach()
    if (NOT provider_id AND source_count EQUAL 1)
      set(provider_id "${primary_id}")
    endif()
    if (provider_id)
      _bext_set_package_alias("${provider}" "${provider_id}")
    endif()
  endforeach()
endforeach()

get_property(subcomponents GLOBAL PROPERTY BEXT_SBOM_SUBCOMPONENTS)
foreach(subcomponent ${subcomponents})
  bext_inventory_get(parent_path "${subcomponent}" SBOM_PARENT)
  set(parent_record "")
  foreach(component ${components})
    string(REPLACE "|" ";" component_parts "${component}")
    list(GET component_parts 1 component_path)
    if (component_path STREQUAL parent_path)
      set(parent_record "${component}")
      break()
    endif()
  endforeach()
  if (NOT parent_record)
    message(FATAL_ERROR "No SBOM package represents parent source ${parent_path}")
  endif()
  string(REPLACE "|" ";" parent_parts "${parent_record}")
  list(GET parent_parts 0 project)
  list(GET parent_parts 2 url)
  list(GET parent_parts 3 sha)
  list(GET parent_parts 5 parent_id)
  bext_inventory_get(component_path "${subcomponent}" SBOM_COMPONENT)
  set(nested_source "${BEXT_SOURCE_DIR}/${parent_path}/${component_path}")
  if(EXISTS "${nested_source}/.git")
    execute_process(
      COMMAND git rev-parse HEAD
      WORKING_DIRECTORY "${nested_source}"
      RESULT_VARIABLE nested_revision_result
      OUTPUT_VARIABLE nested_revision
      OUTPUT_STRIP_TRAILING_WHITESPACE
    )
    if(NOT nested_revision_result EQUAL 0 OR NOT nested_revision MATCHES "^[0-9a-fA-F]+$")
      message(FATAL_ERROR "Unable to determine nested source revision for ${subcomponent}")
    endif()
    set(sha "${nested_revision}")
    execute_process(
      COMMAND git remote get-url origin
      WORKING_DIRECTORY "${nested_source}"
      RESULT_VARIABLE nested_url_result
      OUTPUT_VARIABLE nested_url
      OUTPUT_STRIP_TRAILING_WHITESPACE
    )
    if(nested_url_result EQUAL 0 AND nested_url)
      set(url "${nested_url}")
    endif()
  endif()
  bext_inventory_get(name "${subcomponent}" SBOM_NAME)
  if (NOT name)
    bext_inventory_get(name "${subcomponent}" SBOM_COMPONENT)
  endif()
  bext_inventory_spdx_id(spdx_id "${subcomponent}")
  list(APPEND components "${project}|${subcomponent}|${url}|${sha}|${name}|${spdx_id}|CHILD|${parent_id}")
endforeach()

string(SHA256 namespace_nonce "${bext_revision}|${components}")

get_filename_component(sbom_dir "${BEXT_SBOM_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${sbom_dir}")
file(WRITE "${BEXT_SBOM_OUTPUT}" "{\n")
file(APPEND "${BEXT_SBOM_OUTPUT}" "  \"spdxVersion\": \"SPDX-2.3\",\n")
file(APPEND "${BEXT_SBOM_OUTPUT}" "  \"dataLicense\": \"CC0-1.0\",\n")
file(APPEND "${BEXT_SBOM_OUTPUT}" "  \"SPDXID\": \"SPDXRef-DOCUMENT\",\n")
file(APPEND "${BEXT_SBOM_OUTPUT}" "  \"name\": \"bext-dependencies\",\n")
file(APPEND "${BEXT_SBOM_OUTPUT}" "  \"documentNamespace\": \"https://github.com/BRL-CAD/bext/sbom/${bext_revision}/${namespace_nonce}\",\n")
file(APPEND "${BEXT_SBOM_OUTPUT}" "  \"creationInfo\": {\n")
file(APPEND "${BEXT_SBOM_OUTPUT}" "    \"created\": \"${created}\",\n")
file(APPEND "${BEXT_SBOM_OUTPUT}" "    \"creators\": [\"Tool: bext-GenerateSbom.cmake\"]\n")
file(APPEND "${BEXT_SBOM_OUTPUT}" "  },\n")

set(extracted_license_ids)
foreach(component ${components})
  string(REPLACE "|" ";" parts "${component}")
  list(GET parts 1 path)
  list(GET parts 6 component_kind)
  if (component_kind STREQUAL "CHILD")
    bext_inventory_get(license_base "${path}" SBOM_PARENT)
  else()
    set(license_base "${path}")
  endif()
  bext_inventory_get(license "${path}" SBOM_LICENSE)
  bext_inventory_get(license_concluded "${path}" SBOM_LICENSE_CONCLUDED)
  foreach(license_expression "${license}" "${license_concluded}")
    string(REGEX MATCHALL "LicenseRef-[A-Za-z0-9.-]+" custom_licenses "${license_expression}")
    foreach(custom_license ${custom_licenses})
      list(FIND extracted_license_ids "${custom_license}" extracted_license_index)
      if (extracted_license_index EQUAL -1)
        list(APPEND extracted_license_ids "${custom_license}")
        _bext_alias_key(license_key "${custom_license}")
        set_property(GLOBAL PROPERTY "BEXT_SBOM_EXTRACTED_${license_key}" "${path}|${license_base}")
      endif()
    endforeach()
  endforeach()
endforeach()
if (extracted_license_ids)
  list(LENGTH extracted_license_ids extracted_license_count)
  set(extracted_license_index 0)
  file(APPEND "${BEXT_SBOM_OUTPUT}" "  \"hasExtractedLicensingInfos\": [\n")
  foreach(license ${extracted_license_ids})
    math(EXPR extracted_license_index "${extracted_license_index} + 1")
    _bext_alias_key(license_key "${license}")
    get_property(license_record GLOBAL PROPERTY "BEXT_SBOM_EXTRACTED_${license_key}")
    string(REPLACE "|" ";" license_parts "${license_record}")
    list(GET license_parts 0 path)
    list(GET license_parts 1 license_base)
    bext_inventory_get(license_name "${path}" SBOM_LICENSE_NAME)
    bext_inventory_get(license_file "${path}" SBOM_LICENSE_FILE)
    if (NOT license_file)
      bext_inventory_get(license_files "${path}" SBOM_LICENSE_FILES)
      list(GET license_files 0 license_file)
    endif()
    _bext_inventory_read_evidence(license_text "${BEXT_SOURCE_DIR}" "${license_base}" "${license_file}")
    string(REPLACE "\r\n" "\n" license_text "${license_text}")
    _bext_json_escape(license_name_json "${license_name}")
    _bext_json_escape(license_text_json "${license_text}")
    file(APPEND "${BEXT_SBOM_OUTPUT}" "    {\"licenseId\": \"${license}\", \"name\": \"${license_name_json}\", \"extractedText\": \"${license_text_json}\"}")
    if (extracted_license_index LESS extracted_license_count)
      file(APPEND "${BEXT_SBOM_OUTPUT}" ",\n")
    else()
      file(APPEND "${BEXT_SBOM_OUTPUT}" "\n")
    endif()
  endforeach()
  file(APPEND "${BEXT_SBOM_OUTPUT}" "  ],\n")
endif()
file(APPEND "${BEXT_SBOM_OUTPUT}" "  \"packages\": [\n")

list(LENGTH components component_count)
set(component_index 0)
foreach(component ${components})
  math(EXPR component_index "${component_index} + 1")
  string(REPLACE "|" ";" parts "${component}")
  list(GET parts 0 project)
  list(GET parts 1 path)
  list(GET parts 2 fork_url)
  list(GET parts 3 sha)
  list(GET parts 4 name)
  list(GET parts 5 spdx_id)
  list(GET parts 6 component_kind)
  list(GET parts 7 parent_id)
  bext_inventory_get(groups "${project}" GROUPS)
  bext_inventory_get(output_class "${project}" OUTPUT)
  bext_inventory_get(version "${path}" SBOM_VERSION)
  bext_inventory_get(upstream_url "${path}" SBOM_UPSTREAM_URL)
  bext_inventory_get(download_location "${path}" SBOM_DOWNLOAD_LOCATION)
  bext_inventory_get(purl "${path}" SBOM_PURL)
  bext_inventory_get(purl_base "${path}" SBOM_PURL_BASE)
  bext_inventory_get(purl_subpath "${path}" SBOM_PURL_SUBPATH)
  bext_inventory_get(cpe "${path}" SBOM_CPE)
  bext_inventory_get(cpe_status "${path}" SBOM_CPE_STATUS)
  bext_inventory_get(cpe_comment "${path}" SBOM_CPE_COMMENT)
  bext_inventory_get(copyright_text "${path}" SBOM_COPYRIGHT_TEXT)
  bext_inventory_get(copyright_file "${path}" SBOM_COPYRIGHT_FILE)
  bext_inventory_get(license "${path}" SBOM_LICENSE)
  bext_inventory_get(license_concluded "${path}" SBOM_LICENSE_CONCLUDED)
  bext_inventory_get(license_comment "${path}" SBOM_LICENSE_COMMENT)
  bext_inventory_get(purpose "${path}" SBOM_PURPOSE)
  bext_inventory_get(scope "${path}" SBOM_SCOPE)
  if (NOT version)
    set(version "${sha}")
  endif()
  if (purl_base)
    set(purl "${purl_base}@${sha}")
    if(purl_subpath)
      string(APPEND purl "#${purl_subpath}")
    endif()
  endif()
  if (NOT license)
    set(license "NOASSERTION")
  endif()
  if (NOT license_concluded)
    set(license_concluded "NOASSERTION")
  endif()
  if(copyright_file)
    if(component_kind STREQUAL "CHILD")
      bext_inventory_get(copyright_base "${path}" SBOM_PARENT)
    else()
      set(copyright_base "${path}")
    endif()
    _bext_inventory_read_evidence(copyright_text "${BEXT_SOURCE_DIR}" "${copyright_base}" "${copyright_file}")
    string(REPLACE "\r\n" "\n" copyright_text "${copyright_text}")
    string(REGEX REPLACE "[\r\n]+$" "" copyright_text "${copyright_text}")
  endif()
  if(NOT copyright_text)
    set(copyright_text "NOASSERTION")
  endif()

  if (NOT download_location)
    set(download_location "${fork_url}")
    if (fork_url MATCHES "^https://github.com/")
      string(REGEX REPLACE "\\.git$" "" download_location "${fork_url}")
      string(APPEND download_location "/archive/${sha}.tar.gz")
    endif()
  endif()
  if (component_kind STREQUAL "CHILD")
    bext_inventory_get(parent_path "${path}" SBOM_PARENT)
    bext_inventory_get(component_path "${path}" SBOM_COMPONENT)
    if(upstream_url)
      set(source_info "Bundled component derived from ${upstream_url} in ${parent_path}/${component_path}; obtained with parent source at commit ${sha}")
    else()
      set(source_info "Bundled component in ${parent_path}/${component_path}; obtained with parent source at commit ${sha}")
    endif()
  elseif(upstream_url)
    set(source_info "Forked from ${upstream_url}; tracked by bext at commit ${sha} in ${path}")
  else()
    set(source_info "Tracked from ${fork_url} at commit ${sha} in ${path}")
  endif()
  string(REPLACE ";" ", " group_text "${groups}")
  if (NOT scope)
    if (output_class STREQUAL "noinstall")
      set(scope "BUILD")
    else()
      set(scope "RUNTIME")
    endif()
  endif()
  if (NOT purpose)
    if (output_class STREQUAL "noinstall")
      set(purpose "APPLICATION")
    else()
      set(purpose "LIBRARY")
    endif()
  endif()
  set(comment "bext project: ${project}; groups: ${group_text}; output: ${output_class}; dependency scope: ${scope}")
  set(membership_groups "[]")
  set(membership_index 0)
  if(NOT groups STREQUAL "always considered")
    foreach(group IN LISTS groups)
      _bext_json_string(group_json "${group}")
      string(JSON membership_groups SET "${membership_groups}" ${membership_index} "${group_json}")
      math(EXPR membership_index "${membership_index} + 1")
    endforeach()
  endif()
  _bext_json_string(project_json "${project}")
  set(membership "{\"schemaVersion\":1,\"component\":${project_json},\"groups\":${membership_groups}}")
  _bext_json_string(membership_json "${membership}")
  if(cpe)
    string(APPEND comment "; CPE classification: ${cpe_status}")
  endif()
  if(cpe_comment)
    string(APPEND comment "; CPE note: ${cpe_comment}")
  endif()
  if (license_comment)
    string(APPEND comment "; license note: ${license_comment}")
  endif()
  foreach(value name version download_location source_info license license_concluded copyright_text comment purl cpe purpose)
    _bext_json_escape(${value}_json "${${value}}")
  endforeach()

  file(APPEND "${BEXT_SBOM_OUTPUT}" "    {\n")
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"name\": \"${name_json}\",\n")
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"SPDXID\": \"${spdx_id}\",\n")
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"versionInfo\": \"${version_json}\",\n")
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"downloadLocation\": \"${download_location_json}\",\n")
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"packageSourceInfo\": \"${source_info_json}\",\n")
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"filesAnalyzed\": false,\n")
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"primaryPackagePurpose\": \"${purpose_json}\",\n")
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"licenseConcluded\": \"${license_concluded_json}\",\n")
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"licenseDeclared\": \"${license_json}\",\n")
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"copyrightText\": \"${copyright_text_json}\",\n")
  if (purl OR cpe)
    file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"externalRefs\": [\n")
    set(external_refs)
    if (purl)
      list(APPEND external_refs "        {\"referenceCategory\": \"PACKAGE-MANAGER\", \"referenceType\": \"purl\", \"referenceLocator\": \"${purl_json}\"}")
    endif()
    if (cpe)
      list(APPEND external_refs "        {\"referenceCategory\": \"SECURITY\", \"referenceType\": \"cpe23Type\", \"referenceLocator\": \"${cpe_json}\"}")
    endif()
    list(JOIN external_refs ",\n" external_refs_json)
    file(APPEND "${BEXT_SBOM_OUTPUT}" "${external_refs_json}\n")
    file(APPEND "${BEXT_SBOM_OUTPUT}" "      ],\n")
  endif()
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"comment\": \"${comment_json}\",\n")
  file(APPEND "${BEXT_SBOM_OUTPUT}" "      \"annotations\": [{\"annotationDate\":\"${created}\",\"annotationType\":\"OTHER\",\"annotator\":\"Tool: bext:membership\",\"comment\":${membership_json}}]\n")
  if (component_index LESS component_count)
    file(APPEND "${BEXT_SBOM_OUTPUT}" "    },\n")
  else()
    file(APPEND "${BEXT_SBOM_OUTPUT}" "    }\n")
  endif()
endforeach()
file(APPEND "${BEXT_SBOM_OUTPUT}" "  ],\n")
file(APPEND "${BEXT_SBOM_OUTPUT}" "  \"relationships\": [\n")

set(relationships)
foreach(component ${components})
  string(REPLACE "|" ";" parts "${component}")
  list(GET parts 0 project)
  list(GET parts 5 project_id)
  list(GET parts 6 component_kind)
  list(GET parts 7 parent_id)
  list(APPEND relationships "SPDXRef-DOCUMENT|DESCRIBES|${project_id}")
  if (component_kind STREQUAL "CHILD")
    list(APPEND relationships "${parent_id}|CONTAINS|${project_id}")
    continue()
  endif()
  bext_inventory_get(deps "${project}" DEPS)
  foreach(dep ${deps})
    _bext_get_package_alias(dep_id "${dep}")
    if (NOT dep_id)
      message(FATAL_ERROR "No SBOM package represents dependency ${dep} required by ${project}")
    endif()
    if (NOT project_id STREQUAL dep_id)
      list(APPEND relationships "${project_id}|DEPENDS_ON|${dep_id}")
    endif()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES relationships)
list(LENGTH relationships relationship_count)
set(relationship_index 0)
foreach(relationship ${relationships})
  math(EXPR relationship_index "${relationship_index} + 1")
  string(REPLACE "|" ";" parts "${relationship}")
  list(GET parts 0 source_id)
  list(GET parts 1 relationship_type)
  list(GET parts 2 target_id)
  file(APPEND "${BEXT_SBOM_OUTPUT}" "    {\"spdxElementId\": \"${source_id}\", \"relationshipType\": \"${relationship_type}\", \"relatedSpdxElement\": \"${target_id}\"}")
  if (relationship_index LESS relationship_count)
    file(APPEND "${BEXT_SBOM_OUTPUT}" ",\n")
  else()
    file(APPEND "${BEXT_SBOM_OUTPUT}" "\n")
  endif()
endforeach()
file(APPEND "${BEXT_SBOM_OUTPUT}" "  ]\n}\n")
file(RENAME "${BEXT_SBOM_OUTPUT}" "${BEXT_SBOM_FINAL_OUTPUT}")
message(STATUS "Generated SPDX 2.3 SBOM: ${BEXT_SBOM_FINAL_OUTPUT}")
if(BEXT_CYCLONEDX_OUTPUT)
  include("${CMAKE_CURRENT_LIST_DIR}/BextCycloneDx.cmake")
  file(READ "${BEXT_SBOM_FINAL_OUTPUT}" inventory_json)
  bext_write_cyclonedx("${BEXT_CYCLONEDX_OUTPUT}" "${inventory_json}")
endif()
