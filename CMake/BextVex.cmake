include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/BextSbomJson.cmake")
find_package(Python3 3.8 REQUIRED COMPONENTS Interpreter)
set(BEXT_VEX_PYTHON "${Python3_EXECUTABLE}")

function(_bext_vex_registration review_file component_output target_output)
  file(READ "${review_file}" reviews)
  string(JSON schema GET "${reviews}" schemaVersion)
  string(JSON component GET "${reviews}" component)
  string(JSON target GET "${reviews}" target)
  get_filename_component(wrapper_dir "${review_file}" DIRECTORY)
  get_filename_component(wrapper "${wrapper_dir}" NAME)
  if(NOT schema EQUAL 1 OR NOT component STREQUAL wrapper OR
      NOT component MATCHES "^[a-z0-9][a-z0-9_-]*$" OR
      NOT target MATCHES "^[A-Za-z0-9_]+$")
    message(FATAL_ERROR "Invalid VEX review registration: ${review_file}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${review_file}")
  set(${component_output} "${component}" PARENT_SCOPE)
  set(${target_output} "${target}" PARENT_SCOPE)
endfunction()

# Register in the ExternalProject's directory: its completion command cannot
# be extended from a parent directory. Evidence survives discarded work trees.
function(bext_register_vex target)
  set(review_file "${CMAKE_CURRENT_SOURCE_DIR}/VexReviews.json")
  if(NOT EXISTS "${review_file}")
    return()
  endif()
  _bext_vex_registration("${review_file}" component reviewed_target)
  if(NOT target STREQUAL reviewed_target)
    return()
  endif()
  set(wrapper_dir "${CMAKE_CURRENT_SOURCE_DIR}")
  set(evidence "${CMAKE_BINARY_DIR}/CMakeFiles/bext-vex/${component}.json")
  _bext_json_string(component_json "${component}")
  _bext_json_string(review_file_json "${review_file}")
  ExternalProject_Get_Property("${target}" SOURCE_DIR)
  ExternalProject_Get_Property("${target}" BINARY_DIR)
  get_property(source_states DIRECTORY "${wrapper_dir}" PROPERTY BEXT_SOURCE_STATE_FILES)
  if(NOT source_states)
    message(FATAL_ERROR "VEX evidence for ${component} requires tracked source state")
  endif()
  _bext_json_string(source_root_json "${CMAKE_SOURCE_DIR}")
  _bext_json_string(stage_root_json "${SOURCE_DIR}")
  _bext_json_string(build_root_json "${BINARY_DIR}")
  _bext_json_string(install_root_json "${CMAKE_BUNDLE_INSTALL_PREFIX}")
  set(states "[]")
  set(state_index 0)
  foreach(source_state IN LISTS source_states)
    _bext_json_string(state_json "${source_state}")
    string(JSON states SET "${states}" ${state_index} "${state_json}")
    math(EXPR state_index "${state_index} + 1")
  endforeach()
  set(config "{\"component\":${component_json},\"sourceRoot\":${source_root_json},\"stageRoot\":${stage_root_json},\"buildRoot\":${build_root_json},\"installRoot\":${install_root_json},\"reviews\":${review_file_json},\"sourceStates\":${states}}")
  set(config_file "${CMAKE_BINARY_DIR}/CMakeFiles/bext-vex/${component}-capture.json")
  file(CONFIGURE OUTPUT "${config_file}" CONTENT "${config}\n" @ONLY)
  ExternalProject_Add_Step("${target}" vex_evidence
    COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CaptureVexEvidence.py"
      --config "${config_file}" --output "${evidence}"
    DEPENDEES install
    DEPENDS "${config_file}" "${review_file}"
      "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CaptureVexEvidence.py"
      "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/BextVex.py"
    BYPRODUCTS "${evidence}"
    )
  set_property(GLOBAL APPEND PROPERTY BEXT_VEX_TARGETS "${target}")
endfunction()

function(bext_configure_vex registry_output)
  file(GLOB review_files CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/*/VexReviews.json")
  set(registrations "[]")
  set(index 0)
  foreach(review_file IN LISTS review_files)
    _bext_vex_registration("${review_file}" component target)
    set(evidence "${CMAKE_BINARY_DIR}/CMakeFiles/bext-vex/${component}.json")
    foreach(field component review_file evidence)
      _bext_json_string(${field}_json "${${field}}")
    endforeach()
    set(registration "{\"component\":${component_json},\"reviews\":${review_file_json},\"evidence\":${evidence_json}}")
    string(JSON registrations SET "${registrations}" ${index} "${registration}")
    math(EXPR index "${index} + 1")
  endforeach()
  file(CONFIGURE OUTPUT "${registry_output}" CONTENT "{\"schemaVersion\":1,\"components\":${registrations}}\n" @ONLY)
endfunction()
