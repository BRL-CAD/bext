cmake_minimum_required(VERSION 3.26)
include("${CMAKE_CURRENT_LIST_DIR}/../CMake/RefreshSpdx.cmake")
if(NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "TEST_ROOT must name an unused fixture directory")
endif()
if(EXISTS "${TEST_ROOT}")
  message(FATAL_ERROR "TEST_ROOT already exists")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/sbom" "${TEST_ROOT}/lib")
file(WRITE "${TEST_ROOT}/lib/first" "processed artifact\n")
file(WRITE "${TEST_ROOT}/lib/second" "another processed artifact\n")
set(document_header "SPDXVersion: SPDX-2.3\nDataLicense: CC0-1.0\nSPDXID: SPDXRef-DOCUMENT\n")
set(content "${document_header}DocumentNamespace: https://example.invalid/base\n")
string(APPEND content "PackageName: base\nSPDXID: SPDXRef-Package-base\nPackageVerificationCode: 0000\nFilesAnalyzed: true\n")
foreach(name first second)
  string(APPEND content "\nFileName: ./lib/${name}\nSPDXID: SPDXRef-PackagedFile-${name}\nFileType: BINARY\nFileChecksum: SHA1: 0000\nRelationship: SPDXRef-Package-base CONTAINS SPDXRef-PackagedFile-${name}\n")
endforeach()
file(WRITE "${TEST_ROOT}/sbom/base.spdx" "${content}")
file(WRITE "${TEST_ROOT}/sbom/dependent.spdx"
  "${document_header}DocumentNamespace: https://example.invalid/dependent\nExternalDocumentRef: DocumentRef-base https://example.invalid/base SHA1: 0000\n")
bext_refresh_spdx("${TEST_ROOT}")
file(READ "${TEST_ROOT}/sbom/base.spdx" content)
set(checksums)
foreach(name first second)
  file(SHA1 "${TEST_ROOT}/lib/${name}" checksum)
  string(FIND "${content}" "FileChecksum: SHA1: ${checksum}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Artifact checksum was not refreshed")
  endif()
  list(APPEND checksums "${checksum}")
endforeach()
list(SORT checksums)
list(JOIN checksums "" concatenated)
string(SHA1 verification "${concatenated}")
string(FIND "${content}" "PackageVerificationCode: ${verification}" found)
if(found LESS 0)
  message(FATAL_ERROR "Package verification code was not refreshed")
endif()
file(SHA1 "${TEST_ROOT}/sbom/base.spdx" base_hash)
file(SHA1 "${TEST_ROOT}/sbom/dependent.spdx" dependent_hash)
file(READ "${TEST_ROOT}/sbom/dependent.spdx" content)
string(FIND "${content}" "SHA1: ${base_hash}" found)
if(found LESS 0)
  message(FATAL_ERROR "External document checksum was not refreshed")
endif()
bext_refresh_spdx("${TEST_ROOT}")
file(SHA1 "${TEST_ROOT}/sbom/base.spdx" repeated_base_hash)
file(SHA1 "${TEST_ROOT}/sbom/dependent.spdx" repeated_dependent_hash)
if(NOT base_hash STREQUAL repeated_base_hash OR NOT dependent_hash STREQUAL repeated_dependent_hash)
  message(FATAL_ERROR "Repeated integrity processing changed the document")
endif()
message(STATUS "PASS: installed file checksums, package verification, document references, and idempotence")
