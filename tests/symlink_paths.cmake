cmake_minimum_required(VERSION 3.26)

# Exercise the production finalization, staging, and install code on ELF hosts.
foreach(required BRLCAD_SOURCE STRCLEAR PLIEF)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR
      "${required} is required. Run cmake -DBRLCAD_SOURCE=... -DSTRCLEAR=... -DPLIEF=... -P tests/symlink_paths.cmake")
  endif()
  file(REAL_PATH "${${required}}" ${required})
endforeach()
if(CMAKE_HOST_WIN32 OR CMAKE_HOST_APPLE)
  message(FATAL_ERROR "This integration regression requires an ELF host")
endif()
if(NOT DEFINED BEXT_SOURCE)
  get_filename_component(BEXT_SOURCE "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
set(fixtures "${CMAKE_CURRENT_LIST_DIR}/symlink_paths")
set(remove_test_root FALSE)
if(NOT DEFINED TEST_ROOT)
  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
  set(TEST_ROOT "${CMAKE_CURRENT_BINARY_DIR}/symlink-paths-${suffix}-build")
  set(remove_test_root TRUE)
endif()
if(EXISTS "${TEST_ROOT}" OR IS_SYMLINK "${TEST_ROOT}")
  message(FATAL_ERROR "TEST_ROOT must be an unused directory: ${TEST_ROOT}")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
file(REAL_PATH "${TEST_ROOT}" TEST_ROOT)
message(STATUS "Integration test directory: ${TEST_ROOT}")
# Every install belongs in its fixture, regardless of the caller's environment.
unset(ENV{DESTDIR})
# Discovery must succeed without a package path inherited from the caller.
unset(ENV{PKG_CONFIG_PATH})
unset(ENV{CMAKE_PREFIX_PATH})

function(run)
  execute_process(COMMAND ${ARGV}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}${error}")
  endif()
  if("${output}${error}" MATCHES "does not refer to an existing path on disk")
    message(FATAL_ERROR "Attempted to canonicalize a removed producer path:\n${output}${error}")
  endif()
  set(RUN_OUTPUT "${output}" PARENT_SCOPE)
endfunction()

function(assert_text file expected)
  file(READ "${file}" actual)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "Unexpected contents in ${file}:\n${actual}\nExpected:\n${expected}")
  endif()
endfunction()

function(assert_rpath file expected)
  run("${PLIEF}" --print-rpath "${file}")
  string(STRIP "${RUN_OUTPUT}" actual)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "Incorrect RPATH in ${file}: '${actual}', expected '${expected}'")
  endif()
endfunction()

function(tree_digest outvar root)
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${root}" "${root}/*")
  list(SORT files)
  set(records "")
  foreach(file IN LISTS files)
    file(SHA256 "${root}/${file}" digest)
    string(APPEND records "${file} ${digest}\n")
  endforeach()
  string(SHA256 digest "${records}")
  set(${outvar} "${digest}" PARENT_SCOPE)
endfunction()

function(file_state outvar file)
  file(SHA256 "${file}" digest)
  file(TIMESTAMP "${file}" timestamp "%s.%f" UTC)
  set(${outvar} "${digest}|${timestamp}" PARENT_SCOPE)
endfunction()

function(assert_no_prefixes file)
  # Read bytes as hex so embedded NULs cannot truncate the inspection.
  file(READ "${file}" contents HEX)
  foreach(prefix IN LISTS ARGN)
    string(HEX "${prefix}" target)
    string(FIND "${contents}" "${target}" found)
    if(NOT found EQUAL -1)
      message(FATAL_ERROR "Stale producer path '${prefix}' in ${file}")
    endif()
  endforeach()
endfunction()

function(exercise root layout manifest_mode)
  message(STATUS "Testing ${layout} roots, ${manifest_mode} manifest")
  set(physical "${root}/physical")
  set(alias "${root}/a")
  file(MAKE_DIRECTORY "${physical}")
  file(CREATE_LINK "${physical}" "${alias}" SYMBOLIC)
  set(source "${alias}/provider")
  set(aliases "${alias}")
  if(layout STREQUAL "nested")
    set(build "${source}/build")
    set(output "${build}")
  else()
    file(MAKE_DIRECTORY "${physical}/build-tree" "${physical}/output-tree")
    set(build_alias "${root}/independent-build-alias")
    file(CREATE_LINK "${physical}/build-tree" "${build_alias}" SYMBOLIC)
    set(build "${build_alias}/work")
    set(output "${root}/independent-output-alias")
    file(CREATE_LINK "${physical}/output-tree" "${output}" SYMBOLIC)
    list(APPEND aliases "${build_alias}" "${output}")
  endif()
  set(install "${output}/install")
  set(noinstall "${output}/noinstall")
  file(MAKE_DIRECTORY "${source}" "${noinstall}")
  file(REAL_PATH "${source}" real_source)
  configure_file("${fixtures}/probe.c.in" "${source}/probe.c" @ONLY)
  configure_file("${fixtures}/main.c" "${source}/main.c" COPYONLY)
  configure_file("${fixtures}/pathprobe.h" "${source}/pathprobe.h" COPYONLY)
  configure_file("${fixtures}/provider.cmake.in" "${source}/CMakeLists.txt" COPYONLY)
  run("${CMAKE_COMMAND}" -S "${source}" -B "${build}" -G Ninja
    -DCMAKE_BUILD_TYPE=Release "-DCMAKE_INSTALL_PREFIX=${install}")
  run("${CMAKE_COMMAND}" --build "${build}" --target install -j 4)

  configure_file("${fixtures}/PathProbeConfig.cmake.in"
    "${install}/lib/cmake/PathProbe/PathProbeConfig.cmake" @ONLY)
  file(REAL_PATH "${build}" real_build)
  file(REAL_PATH "${noinstall}" real_noinstall)
  file(REAL_PATH "${install}" real_install)
  set(prefixes "${source}" "${real_source}" "${build}" "${real_build}"
    "${noinstall}" "${real_noinstall}" "${install}" "${real_install}")
  file(READ "${fixtures}/pathprobe.pc.in" pc_template)
  string(CONFIGURE "${pc_template}" pc_contents @ONLY)
  set(expected_pc "${pc_contents}")
  set(index 0)
  foreach(prefix IN LISTS prefixes)
    string(APPEND pc_contents "path${index}=${prefix}/lib\n")
    string(APPEND expected_pc "path${index}=${install}/lib\n")
    math(EXPR index "${index} + 1")
  endforeach()
  set(pc "${install}/lib/pkgconfig/pathprobe.pc")
  file(WRITE "${pc}" "${pc_contents}")
  file(WRITE "${install}/share/pathprobe.txt" "${install}/lib\n${real_install}/lib\n")
  set(manifest "${output}/bext-install-manifest.json")
  set(finalize "${CMAKE_COMMAND}"
    "-DBEXT_INSTALL_ROOT=${install}" "-DBEXT_MANIFEST=${manifest}"
    "-DBEXT_SOURCE_ROOT=${source}" "-DBEXT_BINARY_ROOT=${build}"
    "-DBEXT_NOINSTALL_ROOT=${noinstall}" "-DBEXT_STRCLEAR=${STRCLEAR}"
    "-DBEXT_PLIEF=${PLIEF}" -DBIN_DIR=bin -DLIB_DIR=lib
    "-DBEXT_SYSTEM_NAME=${CMAKE_HOST_SYSTEM_NAME}"
    -P "${BEXT_SOURCE}/CMake/FinalizeInstall.cmake")
  run(${finalize})
  assert_text("${pc}" "${expected_pc}")
  assert_rpath("${install}/bin/pathprobe_app" "${install}/lib")
  tree_digest(before "${install}")
  run(${finalize})
  tree_digest(after "${install}")
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Second finalization changed finalized content")
  endif()
  run("${install}/bin/pathprobe_app")
  message(STATUS "PASS: bext finalization, mixed alias/canonical paths, repeated finalization")

  # Check the finalized metadata before relocation using ordinary CMake
  # prefix discovery, without BRL-CAD's staging or package wrapper.
  set(pkg_source "${root}/bext-pkg-consumer")
  set(pkg_build "${root}/bext-pkg-build")
  configure_file("${fixtures}/main.c" "${pkg_source}/main.c" COPYONLY)
  configure_file("${fixtures}/FindPathProbePkg.cmake" "${pkg_source}/FindPathProbePkg.cmake" COPYONLY)
  configure_file("${fixtures}/pkgconsumer.cmake.in" "${pkg_source}/CMakeLists.txt" COPYONLY)
  run("${CMAKE_COMMAND}" -S "${pkg_source}" -B "${pkg_build}" -G Ninja
    "-DCMAKE_PREFIX_PATH=${install}")
  run("${CMAKE_COMMAND}" --build "${pkg_build}" -j 4)
  run("${pkg_build}/pkgconsumer")
  message(STATUS "PASS: find_package using pkg-config against finalized bext output")

  if(manifest_mode STREQUAL "legacy")
    file(READ "${manifest}" contents)
    string(JSON contents REMOVE "${contents}" install_prefixes)
    file(WRITE "${manifest}" "${contents}")
  elseif(manifest_mode STREQUAL "absent")
    file(REMOVE "${manifest}")
  endif()
  if(manifest_mode STREQUAL "current")
    # Remove every producer alias after moving the bundle.  Staging must
    # recover producer spellings from the manifest, rather than the filesystem.
    set(relocated "${physical}/relocated")
    file(REAL_PATH "${output}" real_output)
    file(RENAME "${real_output}" "${relocated}")
    file(REMOVE ${aliases})
  else()
    # Compatibility bundles need their original access path because they
    # predate the manifest's producer prefixes.
    set(relocated "${output}")
  endif()
  set(consumer_root "${root}/consumer-alias")
  file(CREATE_LINK "${physical}" "${consumer_root}" SYMBOLIC)
  set(consumer_source "${consumer_root}/consumer")
  set(consumer_build "${consumer_root}/consumer-build")
  configure_file("${fixtures}/main.c" "${consumer_source}/main.c" COPYONLY)
  configure_file("${fixtures}/consumer.cmake.in" "${consumer_source}/CMakeLists.txt" COPYONLY)
  configure_file("${fixtures}/FindPathProbePkg.cmake"
    "${consumer_source}/FindPathProbePkg.cmake" COPYONLY)
  set(nested_prefix "${consumer_build}/lib/final")
  set(configure "${CMAKE_COMMAND}" -S "${consumer_source}" -B "${consumer_build}" -G Ninja
    "-DBRLCAD_SOURCE=${BRLCAD_SOURCE}" "-DBRLCAD_EXT_DIR=${relocated}"
    "-DSTRCLEAR_EXECUTABLE=${STRCLEAR}" "-DP_RPATH_EXECUTABLE=${PLIEF}"
    "-DCMAKE_INSTALL_PREFIX=${nested_prefix}")
  # The staging copy must become writable without changing the bundle.
  set(bundle_lib "${relocated}/install/lib/libpathprobe.so.1")
  file(CHMOD "${bundle_lib}" PERMISSIONS
    OWNER_READ OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  run(${configure})
  run("${CMAKE_COMMAND}" --build "${consumer_build}" -j 4)
  run("${consumer_build}/bin/pathprobe_app")
  run("${consumer_build}/bin/consumer")
  run("${consumer_build}/bin/pkgconsumer")
  run("${consumer_build}/bin/pathprobe_app" "${bundle_lib}")
  assert_rpath("${consumer_build}/bin/pathprobe_app" "${consumer_build}/lib")
  foreach(relative bin/pathprobe_app lib/libpathprobe.so.1 lib/libpathprobe_static.a)
    assert_no_prefixes("${consumer_build}/${relative}" "${source}" "${real_source}" "${install}")
  endforeach()
  set(staged_pc "${consumer_build}/lib/pkgconfig/pathprobe.pc")
  string(REPLACE "${install}" "${consumer_build}" expected_staged_pc "${expected_pc}")
  assert_text("${staged_pc}" "${expected_staged_pc}")
  # A caller's search path must survive staging while the bundled package
  # takes precedence over a conflicting external copy.
  set(external_pkgconfig_dir "${root}/external-pkgconfig")
  file(WRITE "${external_pkgconfig_dir}/pathprobe.pc"
    "prefix=${root}/external\nName: ExternalPathProbe\nDescription: Conflicting fixture\n"
    "Version: 9.0\nLibs: -lmissing_pathprobe\nCflags: -I\"${root}/external/include\"\n")
  set(configure "${CMAKE_COMMAND}" -E env "PKG_CONFIG_PATH=${external_pkgconfig_dir}" ${configure})
  run(${configure})
  # Simulate an existing tree processed by older code, with newer timestamps.
  file(WRITE "${staged_pc}" "stale staging result\n")
  file(WRITE "${consumer_build}/CMakeFiles/thirdparty_processing.sha256" "old processing\n")
  run(${configure})
  assert_text("${staged_pc}" "${expected_staged_pc}")
  message(STATUS "PASS: BRL-CAD staging, pkg-config discovery, processing refresh and consumer builds")

  foreach(install_mode nested staged)
    set(install_command "${CMAKE_COMMAND}" -E env --unset=DESTDIR)
    if(install_mode STREQUAL "nested")
      set(prefix "${nested_prefix}")
      set(actual "${prefix}")
    else()
      set(prefix "${root}/install-alias")
      file(MAKE_DIRECTORY "${physical}/final")
      file(CREATE_LINK "${physical}/final" "${prefix}" SYMBOLIC)
      set(destdir "${root}/destdir")
      list(APPEND install_command "DESTDIR=${destdir}")
      set(actual "${destdir}${prefix}")
    endif()
    list(APPEND install_command "${CMAKE_COMMAND}" --install "${consumer_build}" --prefix "${prefix}")
    run(${install_command})
    assert_rpath("${actual}/bin/pathprobe_app" "${prefix}/lib;$ORIGIN/../lib")
    string(REPLACE "${install}" "${prefix}" expected_install_pc "${expected_pc}")
    assert_text("${actual}/lib/pkgconfig/pathprobe.pc" "${expected_install_pc}")
    assert_text("${actual}/share/pathprobe.txt" "${prefix}/lib\n${prefix}/lib\n")
    run("${actual}/bin/pathprobe_app")
    run("${actual}/bin/consumer")
    run("${actual}/bin/pkgconsumer")
    file_state(before "${actual}/bin/pathprobe_app")
    run(${install_command})
    file_state(after "${actual}/bin/pathprobe_app")
    if(NOT before STREQUAL after)
      message(FATAL_ERROR "Repeated installation rewrote a sanitized binary")
    endif()
  endforeach()
  message(STATUS "PASS: nested install prefix, symlink install prefix, --prefix, DESTDIR and repeated install")
endfunction()

exercise("${TEST_ROOT}/nested-current" nested current)
exercise("${TEST_ROOT}/separate-current" separate current)
exercise("${TEST_ROOT}/nested-legacy" nested legacy)
exercise("${TEST_ROOT}/nested-absent" nested absent)
if(remove_test_root)
  file(REMOVE_RECURSE "${TEST_ROOT}")
endif()
