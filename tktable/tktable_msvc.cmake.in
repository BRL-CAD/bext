if (NOT TKTABLE_TARGET MATCHES "^(all|install)$")
  message(FATAL_ERROR "TKTABLE_TARGET must be all or install")
endif ()

set(script "@CMAKE_CURRENT_BINARY_DIR@/tktable_${TKTABLE_TARGET}.bat")
file(WRITE "${script}"
  "@echo off\n"
  "set VSCMD_DEBUG=0\n"
  "set \"NoDefaultCurrentDirectoryInExePath=\"\n"
  "call \"@VCVARS_BAT@\"\n"
  "if errorlevel 1 exit /b %ERRORLEVEL%\n"
  "set \"PATH=@BEXT_MSVC_COMPILER_BIN_DIR@;%PATH%\"\n"
  "cd /D \"@TKTABLE_SRC_DIR@/win\"\n"
  "set CC=\n"
  "set RC=\n"
  "nmake -f makefile.vc ${TKTABLE_TARGET} \"TCLDIR=@TCL_SRC_DIR@\" \"TKDIR=@TK_SRC_DIR@\" \"INSTALLDIR=@CMAKE_BUNDLE_INSTALL_PREFIX@\" SUFX=\n"
  "exit /b %ERRORLEVEL%\n")
execute_process(COMMAND cmd /c "${script}" RESULT_VARIABLE result)
if (NOT result STREQUAL "0")
  message(FATAL_ERROR "Tktable ${TKTABLE_TARGET} failed: ${result}")
endif ()

