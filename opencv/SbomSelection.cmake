function(_bext_opencv_cache_bool output cache_file variable)
  file(STRINGS "${cache_file}" cache_lines REGEX "^${variable}:(BOOL|UNINITIALIZED)=")
  if(cache_lines)
    list(GET cache_lines 0 cache_line)
    string(REGEX REPLACE "^[^=]*=" "" cache_value "${cache_line}")
  else()
    set(cache_value OFF)
  endif()
  if(cache_value)
    set(${output} TRUE PARENT_SCOPE)
  else()
    set(${output} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(bext_opencv_selected_packages output cache_file)
  if(NOT EXISTS "${cache_file}")
    set(${output} "" PARENT_SCOPE)
    return()
  endif()
  set(packages SPDXRef-Package-opencv-opencv)
  foreach(dependency zlib libpng libtiff)
    if(dependency STREQUAL "zlib")
      set(variable BUILD_ZLIB)
    elseif(dependency STREQUAL "libpng")
      set(variable BUILD_PNG)
    else()
      set(variable BUILD_TIFF)
    endif()
    _bext_opencv_cache_bool(selected "${cache_file}" "${variable}")
    if(selected)
      list(APPEND packages "SPDXRef-Package-opencv-opencv-3rdparty-${dependency}")
    endif()
  endforeach()
  list(SORT packages)
  set(${output} "${packages}" PARENT_SCOPE)
endfunction()
