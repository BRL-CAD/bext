+    // Follow the visible layer without treating translucent foreground covers
+    // as opaque boundaries of a different object behind them.
+    void trace_contour_ray(
+        const ShadingContext&       shading_context,
+        const ShadingPoint&         reference,
+        ShadingRay                  ray,
+        ShadingPoint&               point)
+    {
+        // Transforming and reconstructing hits can lose several position ULPs,
+        // especially when a short ray starts at large model coordinates.
+        const double ProgressRoundingSteps = 32.0;
+        const double coordinate_scale = norm(ray.m_org) + norm(reference.get_point()) +
+            reference.get_scene().get_render_data().m_safe_diameter;
+        const double progress_epsilon = ProgressRoundingSteps *
+            std::numeric_limits<double>::epsilon() * coordinate_scale;
+
+        for (size_t iteration = 0; iteration < shading_context.get_max_iterations(); ++iteration)
+        {
+            point.clear();
+            shading_context.get_intersector().trace(ray, point);
+            if (!point.hit_surface())
+                return;
+
+            if (&point.get_object_instance() == &reference.get_object_instance() &&
+                &point.get_assembly_instance() == &reference.get_assembly_instance())
+                return;
+
+            const Material* material = point.get_material();
+            if (material == nullptr)
+                return;
+
+            const Material::RenderData& data = material->get_render_data();
+            Alpha alpha = point.get_alpha();
+            if (data.m_shader_group && data.m_shader_group->has_transparency())
+            {
+                Alpha osl_alpha;
+                shading_context.execute_osl_transparency(*data.m_shader_group, point, osl_alpha);
+                alpha *= osl_alpha;
+            }
+            if (data.m_bsdf == nullptr && data.m_bssrdf == nullptr && data.m_volume != nullptr)
+                alpha[0] = 0.0f;
+            if (alpha[0] >= 1.0f)
+                return;
+
+            // Keep one parameterization while advancing past foreground hits.
+            // Moving to an unoffset hit can cycle between coincident covers.
+            ray.m_tmin = std::nextafter(
+                std::max(ray.m_tmin, point.get_distance()) + progress_epsilon,
+                std::numeric_limits<double>::max());
+        }
 
+        throw std::runtime_error("reached intersection limit while tracing an NPR contour ray");
+    }
+}
