+        m_group->release_optimized_osl_shader_group();
+        EXPECT_FALSE(m_group->is_valid());
+        EXPECT_TRUE(m_group->osl_bump_shader_group(layer) == nullptr);
+        ASSERT_TRUE(compile_group());
+        EXPECT_TRUE(m_group->osl_bump_shader_group(layer) != nullptr);
+        m_group->clear();
+        EXPECT_FALSE(m_group->is_valid());
+        EXPECT_TRUE(m_group->osl_bump_shader_group(layer) == nullptr);
+    }
