+                                EXPECT_FEQ_EPS(1.0f, value.m_beauty[0] / sample.m_value.m_beauty[0], RelativeTolerance);
+                                EXPECT_FEQ_EPS(pdf, bsdf->evaluate_pdf(&values, adjoint, geometry,
+                                    outgoing, incoming, ScatteringMode::Glossy), 1.0e-6f);
