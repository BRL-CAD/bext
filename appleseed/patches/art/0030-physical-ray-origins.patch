+                                BSDFSample sample;
+                                bsdf->sample(sampling_context, &values, adjoint, false, geometry,
+                                    Dual3f(outgoing), ScatteringMode::Glossy, sample);
+                                if (sample.get_mode() == ScatteringMode::None)
