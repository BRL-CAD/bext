diff --git a/src/appleseed.shaders/as_osl_extensions.h.in b/src/appleseed.shaders/as_osl_extensions.h.in
index 971e5f3ce..11ad477f2 100644
--- a/src/appleseed.shaders/as_osl_extensions.h.in
+++ b/src/appleseed.shaders/as_osl_extensions.h.in
@@ -42,6 +42,15 @@
 #define M_1_PI      0.3183098861837907      // 1 / Pi
 #endif
 
+// OSL's global N has no derivatives. Query the renderer when a shader
+// needs the surface normal's contribution to a mapped ray footprint.
+normal as_shading_normal()
+{
+    normal result = N;
+    getattribute("geom:normal", result);
+    return result;
+}
+
 matrix inverse(matrix m) { return 1 / m; }
 
 float min(color C)  { return min(C[0], min(C[1], C[2])); }
@@ -61,6 +70,19 @@ float max(vector V) { return max(V[0], max(V[1], V[2])); }
 // BSDF closures.
 //
 
+// Supply mapped normal derivatives explicitly: standard OSL closure
+// arguments do not transport them automatically.
+closure color as_reflection(normal n, float ior)
+{
+    return reflection(n, ior, "normal_derivatives", 1,
+        "dNdx", vector(Dx(n)), "dNdy", vector(Dy(n)));
+}
+
+closure color as_reflection(normal n)
+{
+    return as_reflection(n, 0);
+}
+
 closure color as_oren_nayar(
     color       reflectance,
     normal      N,
@@ -79,6 +101,9 @@ closure color as_glossy(
     // keyword arguments:
     //   float "energy_compensation" = 0
