     ) BUILTIN;
 
 closure color as_microfacet_metal(
@@ -139,6 +167,9 @@ closure color as_glass(
     float       volume_transmittance_distance
     // keyword arguments:
     //   float "energy_compensation" = 0
+    //   int "normal_derivatives" = 0
+    //   vector "dNdx" = vector(0)
+    //   vector "dNdy" = vector(0)
     ) BUILTIN;
 
 closure color as_ashikhmin_shirley(
@@ -182,7 +213,12 @@ closure color as_plastic(
     float       ior,
     color       diffuse_color,
     float       diffuse_weight,
-    float       scattering) BUILTIN;
+    float       scattering
+    // keyword arguments:
+    //   int "normal_derivatives" = 0
+    //   vector "dNdx" = vector(0)
+    //   vector "dNdy" = vector(0)
+    ) BUILTIN;
 
