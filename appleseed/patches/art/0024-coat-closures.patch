+#include "appleseed/as_osl_extensions.h"
+
+shader as_glossy_layer
+[[
+    string as_node_name = "asGlossyLayer",
+    string as_category = "shader",
+    string help = "A dielectric coat with reflection and substrate absorption."
+]]
+(
+    closure color in_substrate = 0 [[ string label = "Substrate" ]],
+    color in_reflectance = color(1) [[ string label = "Reflection Tint" ]],
+    float in_roughness = 0.1 [[ string label = "Roughness", float min = 0, float max = 1 ]],
+    float in_anisotropy = 0 [[ string label = "Anisotropy", float min = -1, float max = 1 ]],
+    float in_ior = 1.5 [[ string label = "IOR", float min = 0.001 ]],
+    color in_transmittance = color(1) [[ string label = "Transmittance per Thickness Unit" ]],
+    float in_thickness = 0 [[ string label = "Optical Thickness", float min = 0 ]],
+    normal in_normal = N [[ string label = "Coat Normal" ]],
+    vector in_tangent = dPdu [[ string label = "Coat Tangent" ]],
+    int in_enable = 1 [[ string label = "Enable", string widget = "checkBox" ]],
+    output closure color out_color = 0 [[ string label = "Output" ]]
+)
+{
+    if (in_enable)
+        out_color = as_glossy_layer(in_substrate, in_normal, in_tangent,
+            in_reflectance, in_roughness, in_anisotropy, in_ior, in_transmittance,
+            in_thickness);
+    else out_color = in_substrate;
+}
