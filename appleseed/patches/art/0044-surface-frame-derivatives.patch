+        differentiate_basis(normal, Vector3d(nx), ux, vx);
+        differentiate_basis(normal, Vector3d(ny), uy, vy);
+    }
+    du_dx = Vector3f(ux);
+    du_dy = Vector3f(uy);
+    dv_dx = Vector3f(vx);
+    dv_dy = Vector3f(vy);
+    return true;
+}
