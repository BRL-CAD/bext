+    bool contains_medium(const ShadingRay& ray, const ObjectInstance* object)
+    {
+        for (std::uint8_t i = 0; i < ray.m_medium_count; ++i)
+        {
+            if (ray.m_media[i].m_object_instance == object)
+                return true;
+        }
+        return false;
