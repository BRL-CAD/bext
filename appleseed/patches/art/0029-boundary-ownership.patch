+        const ShadingRay ray(Vector3d(0.0, 0.0, 4.0), Vector3d(0.0, 0.0, -1.0),
+            ShadingRay::Time::create_with_normalized_time(0.0f, 0.0f, 1.0f),
+            VisibilityFlags::CameraRay, 0);
+        ShadingPoint point;
