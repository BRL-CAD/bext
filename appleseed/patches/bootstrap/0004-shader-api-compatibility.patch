         DEPENDS ${abs_osl_headers_sources} ${abs_osl_headers_sandbox}
+                "${OSL_STANDARD_SHADER_INCLUDE_DIR}/stdosl.h"
     )
 endforeach ()
 
 # Copy OSL header files to the sandbox.
+add_custom_command (
