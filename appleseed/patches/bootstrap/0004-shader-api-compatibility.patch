+
+# Match the standard library to the selected compiler rather than stale bundled copies.
+find_path(OSL_STANDARD_SHADER_INCLUDE_DIR
+    NAMES stdosl.h
+    HINTS "${OSL_ROOT}" "${OSL_LIB_DIR}/.."
+    PATH_SUFFIXES share/OSL/shaders
+    REQUIRED)
