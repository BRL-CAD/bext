 # Compile OSL shaders into the sandbox.
+if (CMAKE_BUILD_TYPE STREQUAL "Debug")
+	set (OSLC_OPTIONS -O0 -DDEBUG)
+else ()
+	set (OSLC_OPTIONS -O2 -DNDEBUG)
