+// Normal-map frames and vectors may come from user nodes at arbitrary scales.
+// Zero or nonfinite vectors cannot define a direction.
+vector as_bump_unit_vector(vector value)
+{
+    if (!isfinite(value[0]) || !isfinite(value[1]) || !isfinite(value[2]))
+        return vector(0);
+    float scale = max(abs(value));
+    // Avoid re-rounding unit vectors in normal chains. The bounded scale
+    // also keeps the unit-length check from overflowing for large inputs.
+    float unit_length_tolerance = 1.0e-6;
+    if (scale <= 1 + unit_length_tolerance &&
+        abs(dot(value, value) - 1) <= unit_length_tolerance)
+        return value;
+    return scale > 0 ? normalize(value / scale) : vector(0);
+}
