@@ -805,9 +805,27 @@
-    list(APPEND LINK_OPTIONS_PRIVATE /DYNAMICBASE)
-    # Control flow guard
-    list(APPEND LINK_OPTIONS_PRIVATE /GUARD:CF)
-    # When resolving statically linked import dependencies of the module, limit
-    # the module search path to %windows%\system32 directory only.
-    list(APPEND LINK_OPTIONS_PRIVATE /DEPENDENTLOADFLAG:0x800)
+    # bext: /DYNAMICBASE, /GUARD:CF and /DEPENDENTLOADFLAG are all MSVC link.exe
+    # options.  GNU ld (MinGW) does not understand them and treats each as an
+    # input filename -> "ld.exe: cannot find /DYNAMICBASE: No such file or
+    # directory" when linking ispc-slim.exe.  ld already turns on ASLR
+    # (dynamicbase) by default for PE targets and has no Control-Flow-Guard
+    # equivalent, so confine this entire hardening block to MSVC.  /OPT:REF
+    # /OPT:ICF below is already MSVC-gated.
+    if (MSVC)
+        list(APPEND LINK_OPTIONS_PRIVATE /DYNAMICBASE)
+        # Control flow guard
+        list(APPEND LINK_OPTIONS_PRIVATE /GUARD:CF)
+        # When resolving statically linked import dependencies of the module, limit
+        # the module search path to %windows%\system32 directory only.
+        # bext: apply this loader hardening only to non-Debug builds.  A Debug ispc
+        # depends on the debug CRT DLLs (ucrtbased/msvcp140d/vcruntime140d/
+        # vcruntime140_1d), which are never present in system32.  Under
+        # /DEPENDENTLOADFLAG:0x800 the loader searches only system32 and cannot find
+        # them, so ispc-slim.exe fails to start (exit 0xC0000135) when it is run
+        # during the build to generate the stdlib bitcode.
+        string(TOUPPER "${CMAKE_BUILD_TYPE}" ISPC_BEXT_BUILD_TYPE_UC)
+        if (NOT ISPC_BEXT_BUILD_TYPE_UC STREQUAL "DEBUG")
+            list(APPEND LINK_OPTIONS_PRIVATE /DEPENDENTLOADFLAG:0x800)
+        endif()
+    endif()
     if (MSVC AND NOT CMAKE_BUILD_TYPE STREQUAL "DEBUG" )
         list(APPEND LINK_OPTIONS_PUBLIC /OPT:REF /OPT:ICF)
     endif()
@@ -843,8 +861,29 @@
 list(APPEND LINK_LIBRARIES)
-if (NOT WIN32 AND NOT APPLE)
+# bext: ISPC gates the --start-group/--end-group wrapper on "NOT WIN32",
+# assuming every Windows build links with MSVC link.exe (which resolves circular
+# static-library dependencies via an automatic multi-pass).  MinGW is WIN32 but
+# links with GNU ld, which is single-pass and needs the group to resolve the
+# circular references among the clang/LLVM static libraries (and to let the
+# bundled zlib below satisfy libLLVMSupport's brl_* refs regardless of order).
+# Key the guard off the linker (MSVC) rather than the platform (WIN32).
+if (NOT MSVC AND NOT APPLE)
     # To resolve circular dependencies between libraries use --start-group/--end-group
     list(APPEND LINK_LIBRARIES "-Wl,--start-group")
 endif()

+# bext: link the bundled (brl_-prefixed) zlib.  libLLVMSupport's Compression.cpp
+# and CRC.cpp reference brl_compress2/brl_uncompress/brl_crc32 etc.; upstream
+# ISPC never adds zlib to the ispc link line on Windows, so supply it here
+# (inside the group above on GNU ld) via our z_brl-aware FindZLIB.  Prefer the
+# static archive (ZLIB_STATIC_LIBRARIES) so ispc-slim.exe carries no libz_brl.dll
+# runtime dependency -- that DLL is not on PATH when ispc runs during the build
+# (to generate the stdlib bitcode) and would abort it with 0xC0000135.
+find_package(ZLIB)
+if (ZLIB_STATIC_LIBRARIES)
+    list(APPEND LINK_LIBRARIES ${ZLIB_STATIC_LIBRARIES})
+else ()
+    list(APPEND LINK_LIBRARIES ${ZLIB_LIBRARIES})
+endif ()
+
 # Link against Clang libraries
 foreach(clangLib ${CLANG_LIBRARY_LIST})
     # Preferred way to build ISPC is to link it with individual clang static

