set(INSTALL_SCRIPT "${CMAKE_BINARY_DIR}/install_itk.bat")
file(WRITE "${INSTALL_SCRIPT}"
  "@echo off\n"
  "set VSCMD_DEBUG=0\n"
  "set \"NoDefaultCurrentDirectoryInExePath=\"\n"
  "call \"@VCVARS_BAT@\"\n"
  "if errorlevel 1 exit /b %ERRORLEVEL%\n"
  "set \"PATH=@BEXT_MSVC_COMPILER_BIN_DIR@;%PATH%\"\n"
  "cd /D \"@ITK_SRC_DIR@/win\"\n"
  "set CC=\n"
  "set RC=\n"
  "nmake -f makefile.vc install TCLDIR=@TCL_SRC_DIR@ TKDIR=@TK_SRC_DIR@ ITCLDIR=@ITCL_SRC_DIR@ INSTALLDIR=@CMAKE_BUNDLE_INSTALL_PREFIX@ SUFX=\n"
  "exit /b %ERRORLEVEL%\n"
  )

execute_process(
  WORKING_DIRECTORY "@ITK_SRC_DIR@/win"
  COMMAND cmd /c "${INSTALL_SCRIPT}"
  RESULT_VARIABLE ITK_RET
  OUTPUT_VARIABLE CMD_OUT
  ERROR_VARIABLE CMD_OUT
  )

if (ITK_RET)
  message(FATAL_ERROR "Itk install failed:\n${CMD_OUT}\n")
endif (ITK_RET)

set(ITK_SCRIPT_INSTALL_DIR
  "@CMAKE_BUNDLE_INSTALL_PREFIX@/@LIB_DIR@/itk@BEXT_ITK_BUNDLED_VERSION@"
  )
set(ITK_REQUIRED_SCRIPT_FILES
  Archetype.itk
  Toplevel.itk
  Widget.itk
  itk.tcl
  pkgIndex.tcl
  tclIndex
  )
set(ITK_MISSING_SCRIPT_FILES)
foreach (ITK_REQUIRED_SCRIPT_FILE ${ITK_REQUIRED_SCRIPT_FILES})
  if (NOT EXISTS "${ITK_SCRIPT_INSTALL_DIR}/${ITK_REQUIRED_SCRIPT_FILE}")
    list(APPEND ITK_MISSING_SCRIPT_FILES
      "${ITK_SCRIPT_INSTALL_DIR}/${ITK_REQUIRED_SCRIPT_FILE}"
      )
  endif ()
endforeach ()
if (ITK_MISSING_SCRIPT_FILES)
  list(JOIN ITK_MISSING_SCRIPT_FILES "\n  " ITK_MISSING_SCRIPT_FILES_TEXT)
  message(FATAL_ERROR
    "Itk install did not produce required runtime scripts:\n"
    "  ${ITK_MISSING_SCRIPT_FILES_TEXT}\n"
    )
endif ()

message("Itk install succeeded:\n${CMD_OUT}\n")

