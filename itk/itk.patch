diff -Naur itk/configure.ac ITK_BLD/configure.ac
--- itk/configure.ac	2026-09-14 11:07:25.749985453 -0400
+++ ITK_BLD/configure.ac	2026-09-14 11:07:25.734985540 -0400
@@ -162,7 +162,8 @@
 
 TEA_PUBLIC_TK_HEADERS
 #TEA_PRIVATE_TK_HEADERS
-TEA_PATH_X
+# Itk uses Tk stubs and makes no direct Xlib calls.  Its X implementation is
+# selected by Tk, so do not add a second platform X library dependency.
 
