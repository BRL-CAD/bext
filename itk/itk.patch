 # We need to enable the threading macros found in tcl.h and tclInt.h.
diff -Naur itk/generic/itkBase.c ITK_BLD/generic/itkBase.c
--- itk/generic/itkBase.c	2026-09-14 11:07:25.763985372 -0400
+++ ITK_BLD/generic/itkBase.c	2026-09-14 11:07:25.701985731 -0400
@@ -129,7 +129,7 @@
     if (Tk_InitStubs(interp, "8.6-", 0) == NULL) {
 	return TCL_ERROR;
     };
-    if (Itcl_InitStubs(interp, "4.1", 0) == NULL) {
+    if (Itcl_InitStubs(interp, "4.1.1", 0) == NULL) {
 	return TCL_ERROR;
     }
 
diff -Naur itk/pkgIndex.tcl.in ITK_BLD/pkgIndex.tcl.in
--- itk/pkgIndex.tcl.in	2026-09-14 11:07:25.759985395 -0400
+++ ITK_BLD/pkgIndex.tcl.in	2026-09-14 11:07:25.716985644 -0400
@@ -3,7 +3,7 @@
 #
 
 if {![package vsatisfies [package provide Tcl] 8.6-]} {return}
-if {[string length [package provide Itcl]] && ![package vsatisfies [package provide Itcl] 4.1]} return
