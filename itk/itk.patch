diff -Naur itk/configure ITK_BLD/configure
--- itk/configure	2026-09-14 11:05:50.343138038 -0400
+++ ITK_BLD/configure	2026-09-14 11:04:56.453544503 -0400
@@ -7050,7 +7050,9 @@
     fi
     # TEA specific:
     if test x"${XLIBSW}" != x ; then
