function(bext_test_tcl_sbom sbom)
  bext_test_sbom_package(standalone "${sbom}" SPDXRef-Package-sqlite3-sqlite3)
  bext_test_sbom_package(embedded "${sbom}" SPDXRef-Package-tcl-tcl-pkgs-sqlite3.53.0)
  string(JSON version GET "${standalone}" versionInfo)
  bext_test_sbom_field("${embedded}" versionInfo "${version}")
  include("${BEXT_SOURCE_DIR}/tcl/SbomSelection.cmake")
  set(cache "${BEXT_SBOM_OUTPUT}.tcl-cache")
  foreach(enabled ON OFF)
    file(WRITE "${cache}" "BEXT_TCL_ENABLE_DATABASE_PACKAGES:BOOL=${enabled}\n")
    bext_tcl_selected_packages(selected "${cache}")
    set(sqlite_id SPDXRef-Package-tcl-tcl-pkgs-sqlite3.53.0)
    if(enabled AND NOT sqlite_id IN_LIST selected OR NOT enabled AND sqlite_id IN_LIST selected)
      message(FATAL_ERROR "Tcl SBOM selection does not match its database setting")
    endif()
  endforeach()
  file(REMOVE "${cache}")
endfunction()
