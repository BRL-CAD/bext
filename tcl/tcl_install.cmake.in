set(INSTALL_SCRIPT "${CMAKE_BINARY_DIR}/install_tcl.bat")

# need to combine vcvars+nmake into same script so environment is shared
file(WRITE "${INSTALL_SCRIPT}"
  "@echo off\n"
  "set VSCMD_DEBUG=0\n"
  "rem Clear NoDefaultCurrentDirectoryInExePath (set by some hardened Windows\n"
  "rem installs) so cmd can run Tcl's nmakehlp.exe from the current directory,\n"
  "rem which rules.vc relies on.  This is a no-op on default Windows systems.\n"
  "set \"NoDefaultCurrentDirectoryInExePath=\"\n"
  "call \"@VCVARS_BAT@\"\n"
  "if errorlevel 1 exit /b %ERRORLEVEL%\n"
  "set \"PATH=@BEXT_MSVC_COMPILER_BIN_DIR@;%PATH%\"\n"
  "cd /D \"@TCL_SRC_DIR@/win\"\n"
  "echo In Batch CC=%CC% but setting empty\n"
  "set CC=\n"
  "echo In Batch RC=%RC% but setting empty\n"
  "set RC=\n"
  "nmake -f makefile.vc install INSTALLDIR=@CMAKE_BUNDLE_INSTALL_PREFIX@ SUFX=\n"
  "if errorlevel 1 exit /b %ERRORLEVEL%\n"
  "exit /b %ERRORLEVEL%\n"
)

execute_process(
  WORKING_DIRECTORY "@TCL_SRC_DIR@/win"
  COMMAND cmd /c "${INSTALL_SCRIPT}"
  RESULT_VARIABLE TCL_RET
  OUTPUT_VARIABLE CMD_OUT
  ERROR_VARIABLE CMD_OUT
  )

if (TCL_RET OR CMD_OUT MATCHES "NMAKE[ \t]*:[ \t]*fatal error")
  message(FATAL_ERROR "Tcl install failed:\n${CMD_OUT}\n")
endif ()

# Tcl's recursive Windows package rules historically allowed a failed child
# nmake to be hidden by a successful popd.  In addition to fixing that rule,
# verify the expected output from every package for which bext supplied a
# manifest fallback.
set(TCL_REQUIRED_PACKAGE_FILES "@TCL_REQUIRED_PACKAGE_FILES@")
set(TCL_REQUIRED_PACKAGE_GLOBS "@TCL_REQUIRED_PACKAGE_GLOBS@")
set(TCL_MISSING_PACKAGE_ARTIFACTS)
foreach (TCL_REQUIRED_PACKAGE_FILE ${TCL_REQUIRED_PACKAGE_FILES})
  if (NOT EXISTS "${TCL_REQUIRED_PACKAGE_FILE}")
    list(APPEND TCL_MISSING_PACKAGE_ARTIFACTS "${TCL_REQUIRED_PACKAGE_FILE}")
  endif ()
endforeach ()
foreach (TCL_REQUIRED_PACKAGE_GLOB ${TCL_REQUIRED_PACKAGE_GLOBS})
  file(GLOB TCL_REQUIRED_PACKAGE_MATCHES "${TCL_REQUIRED_PACKAGE_GLOB}")
  if (NOT TCL_REQUIRED_PACKAGE_MATCHES)
    list(APPEND TCL_MISSING_PACKAGE_ARTIFACTS "${TCL_REQUIRED_PACKAGE_GLOB}")
  endif ()
endforeach ()
if (TCL_MISSING_PACKAGE_ARTIFACTS)
  list(JOIN TCL_MISSING_PACKAGE_ARTIFACTS "\n  " TCL_MISSING_PACKAGE_ARTIFACTS_TEXT)
  message(FATAL_ERROR
    "Tcl install did not produce required bundled-package artifacts:\n"
    "  ${TCL_MISSING_PACKAGE_ARTIFACTS_TEXT}\n"
    )
endif ()

message("Tcl install succeeded:\n${CMD_OUT}\n")

