 /*
  *----------------------------------------------------------------------
  *
+ * RelocateConfigPath --
+ *
+ *	Resolve a path embedded relative to the Tcl installation prefix.
+ *
+ * Results:
+ *	The relocated path, with a reference held by the caller, or the
+ *	original path when relocation is unnecessary or unavailable.
+ *
+ * Side effects:
+ *	None.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static Tcl_Obj *
+RelocateConfigPath(
+    Tcl_Obj *pathPtr)
+{
+    Tcl_Obj *executablePtr, *splitPtr, *prefixPtr, *resultPtr;
+    const char *executableName = Tcl_GetNameOfExecutable();
+    int pathc;
+
+    Tcl_IncrRefCount(pathPtr);
+    if (Tcl_FSGetPathType(pathPtr) != TCL_PATH_RELATIVE
+	    || executableName == NULL) {
+	return pathPtr;
+    }
+
+    executablePtr = Tcl_NewStringObj(executableName, -1);
+    Tcl_IncrRefCount(executablePtr);
+    splitPtr = Tcl_FSSplitPath(executablePtr, &pathc);
+    Tcl_IncrRefCount(splitPtr);
+    Tcl_DecrRefCount(executablePtr);
+
+    if (pathc < 3) {
+	Tcl_DecrRefCount(splitPtr);
+	return pathPtr;
+    }
+
+    prefixPtr = Tcl_FSJoinPath(splitPtr, pathc - 2);
+    Tcl_IncrRefCount(prefixPtr);
+    Tcl_DecrRefCount(splitPtr);
+
+    resultPtr = Tcl_FSJoinToPath(prefixPtr, 1, &pathPtr);
+    Tcl_IncrRefCount(resultPtr);
+    Tcl_DecrRefCount(pathPtr);
+    Tcl_DecrRefCount(prefixPtr);
+    return resultPtr;
+}
+
