function(_bext_gdal_cache_bool output cache_file variable)
  file(STRINGS "${cache_file}" cache_lines REGEX "^${variable}:BOOL=")
  if(cache_lines)
    list(GET cache_lines 0 cache_line)
    string(REGEX REPLACE "^[^=]*=" "" cache_value "${cache_line}")
  else()
    set(cache_value OFF)
  endif()
  if(cache_value)
    set(${output} TRUE PARENT_SCOPE)
  else()
    set(${output} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(bext_gdal_selected_packages output cache_file)
  if(NOT EXISTS "${cache_file}")
    set(${output} "" PARENT_SCOPE)
    return()
  endif()
  set(packages SPDXRef-Package-gdal-gdal SPDXRef-Package-gdal-gdal-third-party-fast-float)
  macro(_bext_gdal_select_if variable suffix)
    _bext_gdal_cache_bool(selected "${cache_file}" "${variable}")
    if(selected)
      list(APPEND packages "SPDXRef-Package-gdal-gdal-${suffix}")
    endif()
  endmacro()
  macro(_bext_gdal_select_if_both first second suffix)
    _bext_gdal_cache_bool(has_first "${cache_file}" "${first}")
    _bext_gdal_cache_bool(has_second "${cache_file}" "${second}")
    if(has_first AND has_second)
      list(APPEND packages "SPDXRef-Package-gdal-gdal-${suffix}")
    endif()
  endmacro()
  _bext_gdal_select_if_both(GDAL_USE_GEOTIFF_INTERNAL GDAL_ENABLE_DRIVER_GTIFF frmts-gtiff-libgeotiff)
  _bext_gdal_select_if_both(GDAL_USE_GIF_INTERNAL GDAL_ENABLE_DRIVER_GIF frmts-gif-giflib)
  _bext_gdal_select_if_both(GDAL_USE_JPEG_INTERNAL GDAL_ENABLE_DRIVER_JPEG frmts-jpeg-libjpeg)
  _bext_gdal_select_if_both(GDAL_USE_JSONC_INTERNAL OGR_ENABLE_DRIVER_GEOJSON ogr-ogrsf-frmts-geojson-libjson)
  _bext_gdal_select_if(GDAL_USE_LERC_INTERNAL third-party-LercLib)
  _bext_gdal_select_if_both(GDAL_USE_OPENCAD_INTERNAL OGR_ENABLE_DRIVER_CAD ogr-ogrsf-frmts-cad-libopencad)
  _bext_gdal_select_if(GDAL_USE_QHULL_INTERNAL alg-internal-libqhull)
  _bext_gdal_select_if_both(GDAL_USE_SHAPELIB_INTERNAL OGR_ENABLE_DRIVER_SHAPE ogr-ogrsf-frmts-shape-shapelib)
  _bext_gdal_cache_bool(has_nitf "${cache_file}" GDAL_ENABLE_DRIVER_NITF)
  _bext_gdal_cache_bool(has_vrt "${cache_file}" GDAL_ENABLE_DRIVER_VRT)
  if(has_nitf OR has_vrt)
    list(APPEND packages SPDXRef-Package-gdal-gdal-third-party-libdivide)
  endif()
  list(REMOVE_DUPLICATES packages)
  list(SORT packages)
  set(${output} "${packages}" PARENT_SCOPE)
endfunction()
