+
+// SDK consumers may live outside GDAL's install tree.  Locate data relative
+// to the loaded library rather than to the executable or the producer prefix.
+static std::string CPLRelativeDataPath()
+{
+    std::string modulePath;
+#if defined(_WIN32)
+    HMODULE module = nullptr;
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                              GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                          reinterpret_cast<LPCSTR>(&CPLRelativeDataPath), &module))
+    {
+        constexpr DWORD maximumPathLength = 32768;
+        wchar_t path[maximumPathLength];
+        const DWORD length = GetModuleFileNameW(module, path, maximumPathLength);
+        if (length > 0 && length < maximumPathLength)
+        {
+            char *utf8 = CPLRecodeFromWChar(path, CPL_ENC_UCS2, CPL_ENC_UTF8);
+            modulePath = utf8;
+            CPLFree(utf8);
+        }
+    }
+#elif defined(HAVE_DLFCN_H)
+    Dl_info info = {};
+    if (dladdr(reinterpret_cast<void *>(&CPLRelativeDataPath), &info) && info.dli_fname)
+        modulePath = info.dli_fname;
+#endif
+    if (modulePath.empty())
+        return {};
+    const std::string directory = CPLGetPathSafe(modulePath.c_str());
+    return CPLFormFilenameSafe(directory.c_str(), GDAL_DATA_RELATIVE_PATH, nullptr);
 }
 
 /************************************************************************/
@@ -104,6 +142,9 @@
             CPLPushFinderLocation(GDAL_PREFIX "/share/gdal");
 #endif
 #endif
+            const std::string relativeData = CPLRelativeDataPath();
+            if (!relativeData.empty())
+                CPLPushFinderLocation(relativeData.c_str());
         }
     }
     return pTLSData;
