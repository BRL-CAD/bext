-  # List to '/EXPORT:sym0 /EXPORT:sym1 /EXPORT:sym2 ...'
-  # The 'SHELL' prefix tells CMake to use a space instead of comma as the
-  # separator between the driver and linker options, which we need since MSVC's
-  # linker uses `,DATA` as a suffix to indicate that data is being exported.
-  list(TRANSFORM clang_repl_exports PREPEND "LINKER:SHELL:/EXPORT:")
+  if(CMAKE_CXX_COMPILER_ID STREQUAL "IntelLLVM")
+    # icx-cl splits /Qoption,link at commas, including the ,DATA suffix
+    # in /EXPORT arguments. CMake merges this file with the automatic exports.
+    string(REPLACE ",DATA" " DATA" clang_repl_exports "${clang_repl_exports}")
+    list(JOIN clang_repl_exports "\n  " clang_repl_def_exports)
+    set(clang_repl_def "${CMAKE_CURRENT_BINARY_DIR}/clang-repl-manual.def")
+    file(GENERATE OUTPUT "${clang_repl_def}" CONTENT "EXPORTS\n  ${clang_repl_def_exports}\n")
+    target_sources(clang-repl PRIVATE "${clang_repl_def}")
+  else()
+    # The SHELL prefix keeps the comma in the linker's ,DATA suffix.
+    list(TRANSFORM clang_repl_exports PREPEND "LINKER:SHELL:/EXPORT:")
+    set_property(TARGET clang-repl APPEND PROPERTY LINK_OPTIONS ${clang_repl_exports})
+  endif()
 
