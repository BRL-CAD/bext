+# defaults to unsafe floating-point optimizations.
+include(CheckCXXCompilerFlag)
+check_cxx_compiler_flag("-fno-fast-math" OPENNURBS_NO_FAST_MATH)
+if(OPENNURBS_NO_FAST_MATH)
+  add_compile_options("$<$<COMPILE_LANGUAGE:CXX>:-fno-fast-math>")
+endif()
+
