+static void
+test_colorconvert_preserves_auxiliary_channels()
+{
+    const float pixel[] = { 0.25f, 0.5f, 0.75f, 0.5f, -2.0f, 0.125f, 32.0f };
+    ImageBuf src(
+        ImageSpec(1, 1, static_cast<int>(std::size(pixel)), TypeFloat));
+    src.setpixel(0, 0, pixel);
+    for (bool unpremult : { false, true }) {
+        ImageBuf dst;
+        OIIO_CHECK_ASSERT(
+            ImageBufAlgo::colorconvert(dst, src, "lin_rec709_scene",
+                                       "srgb_rec709_scene", unpremult));
+        float actual[std::size(pixel)];
+        dst.getpixel(0, 0, actual);
+        // Apply the sRGB OETF to unassociated RGB before premultiplying.
+        for (size_t c = 0; c < 3; ++c) {
+            const float linear   = unpremult ? pixel[c] / pixel[3] : pixel[c];
+            const float encoded  = 1.055f * std::pow(linear, 1.0f / 2.4f)
+                                   - 0.055f;
+            const float expected = unpremult ? encoded * pixel[3] : encoded;
+            OIIO_CHECK_EQUAL_THRESH(actual[c], expected, 1e-5f);
+        }
+        for (size_t c = 3; c < std::size(pixel); ++c)
+            OIIO_CHECK_EQUAL(actual[c], pixel[c]);
+    }
 }
 
 
