+}
+
+
+
+static void
+test_colorspace_interop_metadata()
+{
+    ImageSpec spec;
+    spec.attribute("oiio:ColorSpace", "lin_rec709_scene");
+    spec.attribute("colorInteropID", "lin_rec709_scene");
+    spec.set_colorspace("srgb_rec709_scene");
+    OIIO_CHECK_EQUAL(spec.get_string_attribute("oiio:ColorSpace"),
+                     "srgb_rec709_scene");
+    OIIO_CHECK_ASSERT(!spec.find_attribute("colorInteropID"));
+
+    // EXR input supplies its authoritative identity as the new space name.
+    spec.attribute("colorInteropID", "lin_ap1_scene");
+    spec.set_colorspace("lin_ap1_scene");
+    OIIO_CHECK_EQUAL(spec.get_string_attribute("colorInteropID"),
+                     "lin_ap1_scene");
+    spec.set_colorspace("lin_ap1_scene");
+    OIIO_CHECK_EQUAL(spec.get_string_attribute("colorInteropID"),
+                     "lin_ap1_scene");
+
+    spec.set_colorspace("custom_space");
+    OIIO_CHECK_ASSERT(!spec.find_attribute("colorInteropID"));
+    spec.attribute("colorInteropID", "lin_ap1_scene");
+    spec.set_colorspace("");
+    OIIO_CHECK_ASSERT(!spec.find_attribute("oiio:ColorSpace"));
+    OIIO_CHECK_ASSERT(!spec.find_attribute("colorInteropID"));
 }
 
 
