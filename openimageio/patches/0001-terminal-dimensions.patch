From b65503b86ef24013c1c874f099bfcc1985cad6b4 Mon Sep 17 00:00:00 2001
From: Clifford Yapp <238416+starseeker@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:05:18 +0000
Subject: [PATCH] Preserve terminal dimension defaults when console queries
 fail

Only replace fallback dimensions after a successful terminal query that
reports a positive size.  Initialize Unix query storage before ioctl and
check Windows console query results as well.

Add a redirected-input regression for positive default dimensions.  The
regression passes under memory checking; pseudo-terminal probes also
verify reported dimensions and zero-size fallback behavior.

diff --git a/src/libutil/CMakeLists.txt b/src/libutil/CMakeLists.txt
index ef0b4c72b252768e46130312f691ce9d9173691a..1f81d9048564c947e332b27555efe3927c9134c5 100644
--- a/src/libutil/CMakeLists.txt
+++ b/src/libutil/CMakeLists.txt
@@ -141,6 +141,10 @@ endif ()
 
 if (OIIO_BUILD_TESTS AND BUILD_TESTING)
 
+    fancy_add_executable (NAME sysutil_test SRC sysutil_test.cpp
+                          LINK_LIBRARIES OpenImageIO_Util)
+    add_test (unit_sysutil ${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/sysutil_test)
+
     fancy_add_executable (NAME argparse_test SRC argparse_test.cpp
                           NO_INSTALL  FOLDER "Unit Tests"
                           LINK_LIBRARIES OpenImageIO_Util)
diff --git a/src/libutil/sysutil.cpp b/src/libutil/sysutil.cpp
index 19104abff16eb53ea3133ec97bef82de5a8bffd3..9b3003cd2275e59aa70e6be6beef0c6bcc5dbf0f 100644
--- a/src/libutil/sysutil.cpp
+++ b/src/libutil/sysutil.cpp
@@ -326,15 +326,15 @@ Sysutil::terminal_columns()
 #if defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__) \
     || defined(__FreeBSD_kernel__) || defined(__NetBSD__)            \
     || defined(__OpenBSD__) || defined(__GNU__)
-    struct winsize w;
-    ioctl(0, TIOCGWINSZ, &w);
-    columns = w.ws_col;
+    struct winsize w = {};
+    if (ioctl(STDIN_FILENO, TIOCGWINSZ, &w) == 0 && w.ws_col > 0)
+        columns = w.ws_col;
 #elif defined(_WIN32)
     HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
     if (h != INVALID_HANDLE_VALUE) {
         CONSOLE_SCREEN_BUFFER_INFO csbi = { { 0 } };
-        GetConsoleScreenBufferInfo(h, &csbi);
-        columns = csbi.dwSize.X;
+        if (GetConsoleScreenBufferInfo(h, &csbi) && csbi.dwSize.X > 0)
+            columns = csbi.dwSize.X;
     }
 #endif
 
@@ -351,15 +351,15 @@ Sysutil::terminal_rows()
 #if defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__) \
     || defined(__FreeBSD_kernel__) || defined(__NetBSD__)            \
     || defined(__OpenBSD__) || defined(__GNU__)
-    struct winsize w;
-    ioctl(0, TIOCGWINSZ, &w);
-    rows = w.ws_row;
+    struct winsize w = {};
+    if (ioctl(STDIN_FILENO, TIOCGWINSZ, &w) == 0 && w.ws_row > 0)
+        rows = w.ws_row;
 #elif defined(_WIN32)
     HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
     if (h != INVALID_HANDLE_VALUE) {
         CONSOLE_SCREEN_BUFFER_INFO csbi = { { 0 } };
-        GetConsoleScreenBufferInfo(h, &csbi);
-        rows = csbi.dwSize.Y;
+        if (GetConsoleScreenBufferInfo(h, &csbi) && csbi.dwSize.Y > 0)
+            rows = csbi.dwSize.Y;
     }
 #endif
 
diff --git a/src/libutil/sysutil_test.cpp b/src/libutil/sysutil_test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..087c0a4f6611446533db865cb03027bf5761f8fe
--- /dev/null
+++ b/src/libutil/sysutil_test.cpp
@@ -0,0 +1,41 @@
+// Copyright Contributors to the OpenImageIO project.
+// SPDX-License-Identifier: Apache-2.0
+// https://github.com/AcademySoftwareFoundation/OpenImageIO
+
+#include <OpenImageIO/sysutil.h>
+#include <OpenImageIO/unittest.h>
+
+#ifndef _WIN32
+#    include <fcntl.h>
+#    include <unistd.h>
+#endif
+
+using namespace OIIO;
+
+int
+main()
+{
+    OIIO_CHECK_ASSERT(Sysutil::terminal_columns() > 0);
+    OIIO_CHECK_ASSERT(Sysutil::terminal_rows() > 0);
+#ifndef _WIN32
+    // Redirected input cannot provide terminal dimensions. Preserve defaults.
+    const int saved_input = dup(STDIN_FILENO);
+    OIIO_CHECK_ASSERT(saved_input >= 0);
+    if (saved_input < 0)
+        return unit_test_failures;
+    const int redirected = open("/dev/null", O_RDONLY);
+    OIIO_CHECK_ASSERT(redirected >= 0);
+    if (redirected >= 0) {
+        const int result = dup2(redirected, STDIN_FILENO);
+        OIIO_CHECK_ASSERT(result >= 0);
+        if (result >= 0) {
+            OIIO_CHECK_EQUAL(Sysutil::terminal_columns(), 80);
+            OIIO_CHECK_EQUAL(Sysutil::terminal_rows(), 24);
+        }
+        close(redirected);
+    }
+    OIIO_CHECK_ASSERT(dup2(saved_input, STDIN_FILENO) >= 0);
+    close(saved_input);
+#endif
+    return unit_test_failures;
+}
