diff -Naur oiio/src/libOpenImageIO/imagebufalgo_font.h OPENIMAGEIO_BLD/src/libOpenImageIO/imagebufalgo_font.h
--- oiio/src/libOpenImageIO/imagebufalgo_font.h	1970-01-01 00:00:00.000000000 +0000
+++ OPENIMAGEIO_BLD/src/libOpenImageIO/imagebufalgo_font.h	1970-01-01 00:00:00.000000000 +0000
@@ -0,0 +1,236 @@
+// Copyright Contributors to the OpenImageIO project.
+// SPDX-License-Identifier: Apache-2.0
+// https://github.com/AcademySoftwareFoundation/OpenImageIO
+
+#pragma once
+
+#include <cmath>
+#include <limits>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <OpenImageIO/filesystem.h>
+#include <OpenImageIO/strutil.h>
+
+#ifdef USE_STRUETYPE
+#    define STT_STATIC
+#    define STRUETYPE_IMPLEMENTATION
+#    include <struetype.h>
+#elif defined(USE_FREETYPE)
+#    include <ft2build.h>
+#    include FT_FREETYPE_H
+#endif
+
+OIIO_NAMESPACE_BEGIN
+namespace {
+
+struct FontGlyph {
+    int width = 0, height = 0;
+    int left = 0, top = 0, advance = 0;
+    std::vector<unsigned char> pixels;
+};
+
+
+
+class FontFace {
+public:
+    FontFace()                           = default;
+    FontFace(const FontFace&)            = delete;
+    FontFace& operator=(const FontFace&) = delete;
+    ~FontFace()
+    {
+#if defined(USE_FREETYPE) && !defined(USE_STRUETYPE)
+        if (m_face)
+            FT_Done_Face(m_face);
+#endif
+    }
+
+    bool load(const std::string& filename)
+    {
+        m_error.clear();
+#ifdef USE_STRUETYPE
+        const uint64_t size = Filesystem::file_size(filename);
+        if (!size || size > uint64_t(std::numeric_limits<int>::max()))
+            return fail("Font buffer is empty, unreadable, or too large");
+        m_data.resize(size);
+        if (Filesystem::read_bytes(filename, m_data.data(), size) != size)
+            return fail("Cannot read font buffer");
+        const int offset = stt_GetFontOffsetForIndex(m_data.data(), int(size),
+                                                     0);
+        if (offset < 0
+            || !stt_InitFont(&m_font, m_data.data(), int(size), offset))
+            return fail("Invalid or unsupported TrueType/OpenType font");
+        m_family = name(FamilyName);
+        m_style  = name(StyleName);
+        if (m_family.empty())
+            m_family
+                = Filesystem::replace_extension(Filesystem::filename(filename),
+                                                "");
+        return true;
+#else
+        if (m_face) {
+            FT_Done_Face(m_face);
+            m_face = nullptr;
+        }
+        static Library library;
+        if (!library.handle)
+            return fail("Cannot initialize FreeType");
+        if (FT_New_Face(library.handle, filename.c_str(), 0, &m_face))
+            return fail("Cannot open font face");
+        m_family = m_face->family_name ? m_face->family_name : "";
+        m_style  = m_face->style_name ? m_face->style_name : "";
+        return true;
+#endif
+    }
+
+    bool set_size(int size)
+    {
+        if (size <= 0)
+            return fail("Font size must be positive");
+#ifdef USE_STRUETYPE
+        m_scale = stt_ScaleForMappingEmToPixels(&m_font, float(size));
+        return (std::isfinite(m_scale) && m_scale > 0)
+               || fail("Invalid font scale");
+#else
+        return !FT_Set_Pixel_Sizes(m_face, 0, size)
+               || fail("Cannot set font size");
+#endif
+    }
+
+    bool glyph(uint32_t codepoint, FontGlyph& glyph)
+    {
+        glyph.pixels.clear();
+        glyph.width = glyph.height = glyph.left = glyph.top = glyph.advance = 0;
+#ifdef USE_STRUETYPE
+        if (codepoint > uint32_t(std::numeric_limits<int>::max()))
+            return fail("Invalid Unicode codepoint");
+        const int index = stt_FindGlyphIndex(&m_font, int(codepoint));
+        int advance;
+        stt_GetGlyphHMetrics(&m_font, index, &advance, nullptr);
+        const double scaled_advance = std::round(double(advance) * m_scale);
+        if (!std::isfinite(scaled_advance)
+            || scaled_advance < std::numeric_limits<int>::min()
+            || scaled_advance > std::numeric_limits<int>::max())
+            return fail("Glyph advance is out of range");
+        glyph.advance = int(scaled_advance);
+        int yoff      = 0;
+        const std::unique_ptr<unsigned char, BitmapDeleter> bitmap(
+            stt_GetGlyphBitmap(&m_font, m_scale, m_scale, index, &glyph.width,
+                               &glyph.height, &glyph.left, &yoff));
+        if (yoff == std::numeric_limits<int>::min())
+            return fail("Glyph offset is out of range");
+        glyph.top = -yoff;
+        if (glyph.width < 0 || glyph.height < 0)
+            return fail("Invalid glyph dimensions");
+        if (!glyph.width || !glyph.height)
+            return true;
+        if (!bitmap)
+            return fail("Glyph rasterization failed");
+        const size_t width = size_t(glyph.width), height = size_t(glyph.height);
+        if (width > glyph.pixels.max_size() / height)
+            return fail("Glyph bitmap is too large");
+        glyph.pixels.assign(bitmap.get(), bitmap.get() + width * height);
+#else
+        if (FT_Load_Char(m_face, codepoint, FT_LOAD_RENDER))
+            return fail("Glyph rasterization failed");
+        const auto& slot   = *m_face->glyph;
+        const auto& bitmap = slot.bitmap;
+        if (bitmap.width > unsigned(std::numeric_limits<int>::max())
+            || bitmap.rows > unsigned(std::numeric_limits<int>::max()))
+            return fail("Glyph bitmap is too large");
+        glyph.width   = int(bitmap.width);
+        glyph.height  = int(bitmap.rows);
+        glyph.left    = slot.bitmap_left;
+        glyph.top     = slot.bitmap_top;
+        glyph.advance = int(slot.advance.x >> 6);
+        if (!glyph.width || !glyph.height)
+            return true;
+        if (bitmap.pixel_mode != FT_PIXEL_MODE_GRAY
+            && bitmap.pixel_mode != FT_PIXEL_MODE_MONO)
+            return fail("Unsupported glyph bitmap format");
+        const size_t width = size_t(glyph.width), height = size_t(glyph.height);
+        if (width > glyph.pixels.max_size() / height)
+            return fail("Glyph bitmap is too large");
+        glyph.pixels.resize(width * height);
+        for (int y = 0; y < glyph.height; ++y) {
+            const auto* row = bitmap.buffer + ptrdiff_t(y) * bitmap.pitch;
+            for (int x = 0; x < glyph.width; ++x) {
+                glyph.pixels[size_t(y) * width + x]
+                    = bitmap.pixel_mode == FT_PIXEL_MODE_MONO
+                          ? ((row[x / 8] & (0x80 >> (x % 8))) ? 255 : 0)
+                          : row[x];
+            }
+        }
+#endif
+        return true;
+    }
+
+    const std::string& family() const { return m_family; }
+    const std::string& style() const { return m_style; }
+    const std::string& error() const { return m_error; }
+
+private:
+    bool fail(const char* message)
+    {
+        m_error = message;
+        return false;
+    }
+
+#ifdef USE_STRUETYPE
+    static constexpr int FamilyName = 1;
+    static constexpr int StyleName  = 2;
+
+    struct BitmapDeleter {
+        void operator()(unsigned char* bitmap) const
+        {
+            stt_FreeBitmap(bitmap, nullptr);
+        }
+    };
+
+    std::string name(int id) const
+    {
+        int length        = 0;
+        const char* value = stt_GetFontNameString(&m_font, &length,
+                                                  STT_PLATFORM_ID_MICROSOFT,
+                                                  STT_MS_EID_UNICODE_BMP,
+                                                  STT_MS_LANG_ENGLISH, id);
+        if (!value)
+            value = stt_GetFontNameString(&m_font, &length,
+                                          STT_PLATFORM_ID_UNICODE,
+                                          STT_UNICODE_EID_UNICODE_2_0_BMP, 0,
+                                          id);
+        if (!value || length <= 0 || length % 2)
+            return {};
+        std::u16string decoded;
+        decoded.reserve(size_t(length) / 2);
+        for (int i = 0; i < length; i += 2)
+            decoded.push_back(char16_t((uint16_t(uint8_t(value[i])) << 8)
+                                       | uint8_t(value[i + 1])));
+        return Strutil::utf16_to_utf8(decoded);
+    }
+
+    std::vector<unsigned char> m_data;
+    stt_fontinfo m_font {};
+    float m_scale = 0;
+#else
+    struct Library {
+        FT_Library handle = nullptr;
+        Library()
+        {
+            if (FT_Init_FreeType(&handle))
+                handle = nullptr;
+        }
+        ~Library()
+        {
+            if (handle)
+                FT_Done_FreeType(handle);
+        }
+    };
+    FT_Face m_face = nullptr;
+#endif
+    std::string m_family, m_style, m_error;
+};
+
+}  // namespace
+OIIO_NAMESPACE_END
diff -Naur oiio/src/libOpenImageIO/imagebufalgo_font_test.cpp OPENIMAGEIO_BLD/src/libOpenImageIO/imagebufalgo_font_test.cpp
--- oiio/src/libOpenImageIO/imagebufalgo_font_test.cpp	1970-01-01 00:00:00.000000000 +0000
+++ OPENIMAGEIO_BLD/src/libOpenImageIO/imagebufalgo_font_test.cpp	1970-01-01 00:00:00.000000000 +0000
@@ -0,0 +1,170 @@
+// Copyright Contributors to the OpenImageIO project.
+// SPDX-License-Identifier: Apache-2.0
+// https://github.com/AcademySoftwareFoundation/OpenImageIO
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <string>
+
+#include <OpenImageIO/filesystem.h>
+#include <OpenImageIO/imagebuf.h>
+#include <OpenImageIO/imagebufalgo.h>
+#include <OpenImageIO/imageio.h>
+#include <OpenImageIO/unittest.h>
+
+using namespace OIIO;
+
+namespace {
+constexpr int Width = 256, Height = 128, FontSize = 32;
+constexpr int OriginX = 20, OriginY = 60;
+const float TextColor[] = { 1.0f, 0.5f, 0.25f, 1.0f };
+
+ImageBuf
+canvas()
+{
+    ImageBuf image(ImageSpec(Width, Height, 4, TypeDesc::FLOAT));
+    ImageBufAlgo::zero(image);
+    return image;
+}
+
+void
+check_equal(const ImageBuf& a, const ImageBuf& b)
+{
+    const auto result = ImageBufAlgo::compare(a, b, 0, 0);
+    OIIO_CHECK_ASSERT(!result.error);
+    OIIO_CHECK_EQUAL(result.maxerror, 0.0);
+}
+
+void
+check_text(string_view font)
+{
+    // The accented glyph exercises UTF-8 decoding as well as ASCII rendering.
+    const std::string text = "art \xc3\x85";
+    const ROI bounds       = ImageBufAlgo::text_size(text, FontSize, font);
+    OIIO_CHECK_ASSERT(bounds.defined());
+    OIIO_CHECK_GT(bounds.width(), 0);
+    OIIO_CHECK_GT(bounds.height(), 0);
+    ImageBuf image = canvas();
+    OIIO_CHECK_ASSERT(ImageBufAlgo::render_text(image, OriginX, OriginY, text,
+                                                FontSize, font, TextColor));
+    int covered   = 0;
+    int rightmost = OriginX;
+    for (ImageBuf::ConstIterator<float> p(image); !p.done(); ++p) {
+        for (int c = 0; c < image.nchannels(); ++c) {
+            OIIO_CHECK_ASSERT(std::isfinite(p[c]));
+            OIIO_CHECK_GE(p[c], 0.0f);
+            OIIO_CHECK_LE(p[c], 1.0f);
+        }
+        if (p[3] == 0)
+            continue;
+        ++covered;
+        rightmost = std::max(rightmost, p.x());
+        OIIO_CHECK_GE(p.x(), OriginX + bounds.xbegin);
+        OIIO_CHECK_LT(p.x(), OriginX + bounds.xend);
+        OIIO_CHECK_GE(p.y(), OriginY + bounds.ybegin);
+        OIIO_CHECK_LT(p.y(), OriginY + bounds.yend);
+        OIIO_CHECK_EQUAL(p[0], p[3]);
+        OIIO_CHECK_EQUAL(p[1], 0.5f * p[3]);
+        OIIO_CHECK_EQUAL(p[2], 0.25f * p[3]);
+    }
+    OIIO_CHECK_GT(covered, 0);
+    OIIO_CHECK_GT(rightmost, OriginX + bounds.xbegin + bounds.width() / 2);
+
+    ImageBuf unix_lines = canvas(), windows_lines = canvas();
+    OIIO_CHECK_ASSERT(ImageBufAlgo::render_text(unix_lines, OriginX, OriginY,
+                                                "art\nOSL", FontSize, font));
+    OIIO_CHECK_ASSERT(ImageBufAlgo::render_text(windows_lines, OriginX, OriginY,
+                                                "art\r\nOSL", FontSize, font));
+    check_equal(unix_lines, windows_lines);
+
+    ImageBuf aligned = canvas(), positioned = canvas();
+    OIIO_CHECK_ASSERT(ImageBufAlgo::render_text(
+        aligned, Width / 2, Height / 2, text, FontSize, font, TextColor,
+        ImageBufAlgo::TextAlignX::Center, ImageBufAlgo::TextAlignY::Center));
+    OIIO_CHECK_ASSERT(ImageBufAlgo::render_text(
+        positioned, Width / 2 - (bounds.width() / 2 + bounds.xbegin),
+        Height / 2 - (bounds.height() / 2 + bounds.ybegin), text, FontSize,
+        font, TextColor));
+    check_equal(aligned, positioned);
+
+    ImageBuf shadowed = canvas();
+    ImageBufAlgo::fill(shadowed, 1.0f);
+    OIIO_CHECK_ASSERT(ImageBufAlgo::render_text(
+        shadowed, OriginX, OriginY, text, FontSize, font, TextColor,
+        ImageBufAlgo::TextAlignX::Left, ImageBufAlgo::TextAlignY::Baseline, 2));
+    bool has_shadow = false;
+    for (ImageBuf::ConstIterator<float> p(shadowed); !p.done(); ++p)
+        has_shadow |= p[0] < 1.0f;
+    OIIO_CHECK_ASSERT(has_shadow);
+
+    ImageBuf empty = canvas(), blank = canvas();
+    OIIO_CHECK_ASSERT(
+        ImageBufAlgo::render_text(empty, 0, 0, "\r\n", FontSize, font));
+    check_equal(empty, blank);
+    OIIO_CHECK_ASSERT(!ImageBufAlgo::text_size(text, 0, font).defined());
+    OIIO_CHECK_ASSERT(!ImageBufAlgo::render_text(empty, 0, 0, text, 0, font));
+    OIIO_CHECK_ASSERT(empty.has_error());
+    empty.geterror();
+    OIIO_CHECK_ASSERT(
+        !ImageBufAlgo::render_text(empty, std::numeric_limits<int>::max(),
+                                   std::numeric_limits<int>::max(), text,
+                                   FontSize, font));
+    OIIO_CHECK_ASSERT(empty.has_error());
+    empty.geterror();
+    OIIO_CHECK_ASSERT(
+        !ImageBufAlgo::render_text(empty, OriginX, OriginY, text, FontSize,
+                                   font, TextColor,
+                                   ImageBufAlgo::TextAlignX::Left,
+                                   ImageBufAlgo::TextAlignY::Baseline, -1));
+    OIIO_CHECK_ASSERT(empty.has_error());
+    empty.geterror();
+}
+}  // namespace
+
+int
+main(int argc, char** argv)
+{
+    OIIO_CHECK_EQUAL(argc, 2);
+    if (argc != 2)
+        return 1;
+#if defined(USE_FREETYPE) || defined(USE_STRUETYPE)
+    const std::string font = argv[1];
+    OIIO::attribute("font_searchpath", Filesystem::parent_path(font));
+    check_text(font);
+    check_text("DroidSans");
+    check_text("Droid Sans Regular");
+    check_text("");
+    OIIO_CHECK_ASSERT(
+        OIIO::get_string_attribute("font_family_list").find("Droid Sans")
+        != std::string::npos);
+    OIIO_CHECK_ASSERT(
+        OIIO::get_string_attribute("font_style_list:Droid Sans").find("Regular")
+        != std::string::npos);
+
+    // Existing files with truncated headers must fail, rather than fall back.
+    const std::string invalid = Filesystem::temp_directory_path() + "/"
+                                + Filesystem::unique_path(
+                                    "oiio-font-%%%%-%%%%.ttf");
+    OIIO_CHECK_ASSERT(
+        Filesystem::write_text_file(invalid,
+                                    string_view("\0\1broken font", 13)));
+    ImageBuf image = canvas();
+    OIIO_CHECK_ASSERT(
+        !ImageBufAlgo::text_size("art", FontSize, invalid).defined());
+    OIIO_CHECK_ASSERT(!ImageBufAlgo::render_text(image, 0, OriginY, "art",
+                                                 FontSize, invalid));
+    OIIO_CHECK_ASSERT(image.has_error());
+    image.geterror();
+    OIIO_CHECK_ASSERT(Filesystem::remove(invalid));
+#else
+    ImageBuf image = canvas();
+    OIIO_CHECK_ASSERT(
+        !ImageBufAlgo::text_size("art", FontSize, argv[1]).defined());
+    OIIO_CHECK_ASSERT(!ImageBufAlgo::render_text(image, 0, OriginY, "art",
+                                                 FontSize, argv[1]));
+    OIIO_CHECK_ASSERT(image.has_error());
+    image.geterror();
+#endif
+    return unit_test_failures;
+}
