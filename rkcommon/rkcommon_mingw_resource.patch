--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -24,6 +24,20 @@
   @ONLY
 )
 set(RKCOMMON_RESOURCE ${PROJECT_SOURCE_DIR}/rkcommon/rkcommon.rc)
+if(MINGW)
+  # windres uses a C preprocessor that expects a text resource in UTF-8.
+  find_package(Python3 REQUIRED COMPONENTS Interpreter)
+  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RKCOMMON_RESOURCE}")
+  execute_process(
+    COMMAND "${Python3_EXECUTABLE}" -c
+      "import pathlib, sys; sys.stdout.buffer.write(pathlib.Path(sys.argv[1]).read_text(encoding='utf-16').encode('utf-8'))"
+      "${RKCOMMON_RESOURCE}"
+    OUTPUT_VARIABLE rkcommon_resource_text
+    COMMAND_ERROR_IS_FATAL ANY)
+  set(RKCOMMON_RESOURCE "${PROJECT_BINARY_DIR}/rkcommon/rkcommon.rc")
+  file(CONFIGURE OUTPUT "${RKCOMMON_RESOURCE}"
+    CONTENT "#pragma code_page(65001)\n@rkcommon_resource_text@" @ONLY)
+endif()
 
