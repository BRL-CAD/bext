diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -342,18 +342,19 @@
 if(MZ_ZSTD)
     # Check if zstd is present
     if(NOT MZ_FORCE_FETCH_LIBS)
-        find_package(PkgConfig QUIET)
-        if(PKGCONFIG_FOUND)
-            pkg_check_modules(ZSTD libzstd)
-        endif()
-        if(NOT ZSTD_FOUND)
-            find_package(ZSTD QUIET)
-            if(ZSTD_FOUND)
