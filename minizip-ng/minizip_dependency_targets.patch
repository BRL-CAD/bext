diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -190,9 +190,8 @@
     elseif(ZLIB_FOUND AND NOT MZ_FORCE_FETCH_LIBS)
         message(STATUS "Using ZLIB ${ZLIB_VERSION}")
 
-        list(APPEND MINIZIP_INC ${ZLIB_INCLUDE_DIRS})
-        list(APPEND MINIZIP_LIB ${ZLIB_LIBRARIES})
-        list(APPEND MINIZIP_LBD ${ZLIB_LIBRARY_DIRS})
+        # Resolve zlib from the consuming prefix when the bundle is relocated.
+        list(APPEND MINIZIP_LIB ZLIB::ZLIB)
 
         set(PC_PRIVATE_DEPS "zlib")
         set(ZLIB_COMPAT ON)
@@ -342,18 +342,19 @@
 if(MZ_ZSTD)
     # Check if zstd is present
     if(NOT MZ_FORCE_FETCH_LIBS)
-        find_package(PkgConfig QUIET)
-        if(PKGCONFIG_FOUND)
-            pkg_check_modules(ZSTD libzstd)
-        endif()
-        if(NOT ZSTD_FOUND)
-            find_package(ZSTD QUIET)
-            if(ZSTD_FOUND)
-                if(TARGET zstd::libzstd_static)
-                    list(APPEND ZSTD_LIBRARIES zstd::libzstd_static)
-                else()
-                    list(APPEND ZSTD_LIBRARIES zstd::libzstd_shared)
-                endif()
+        # Prefer an imported target so the selected library and its include
+        # path stay paired when an SDK also provides libzstd.pc.
+        find_package(zstd CONFIG QUIET)
+        if(TARGET zstd::libzstd_static)
+            set(ZSTD_FOUND ON)
+            set(ZSTD_LIBRARIES zstd::libzstd_static)
+        elseif(TARGET zstd::libzstd_shared)
+            set(ZSTD_FOUND ON)
+            set(ZSTD_LIBRARIES zstd::libzstd_shared)
+        else()
+            find_package(PkgConfig QUIET)
+            if(PKGCONFIG_FOUND)
+                pkg_check_modules(ZSTD libzstd)
             endif()
         endif()
     endif()
