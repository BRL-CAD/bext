function(_bext_qt_cache_feature output cache_file feature)
  file(STRINGS "${cache_file}" feature_lines REGEX "^FEATURE_${feature}:BOOL=")
  if(feature_lines)
    list(GET feature_lines 0 feature_line)
    string(REGEX REPLACE "^[^=]*=" "" feature_value "${feature_line}")
  else()
    set(feature_value OFF)
  endif()
  if(feature_value)
    set(${output} TRUE PARENT_SCOPE)
  else()
    set(${output} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(bext_qt_selected_packages output cache_file include_sdk_tools)
  if(NOT EXISTS "${cache_file}")
    set(${output} "" PARENT_SCOPE)
    return()
  endif()

  set(packages
    SPDXRef-Package-qt-qt
    SPDXRef-Package-qt-qt-qtbase
    SPDXRef-Package-qt-qt-qtsvg
  )
  if(include_sdk_tools)
    list(APPEND packages SPDXRef-Package-qt-qt-qtbase-build-tools)
  endif()

  macro(_bext_qt_select suffix)
    list(APPEND packages "SPDXRef-Package-qt-qt-qtbase-src-3rdparty-${suffix}")
  endmacro()
  macro(_bext_qt_select_bundled feature system_feature suffix)
    _bext_qt_cache_feature(has_feature "${cache_file}" "${feature}")
    _bext_qt_cache_feature(uses_system "${cache_file}" "${system_feature}")
    if(has_feature AND NOT uses_system)
      _bext_qt_select("${suffix}")
    endif()
  endmacro()

  _bext_qt_cache_feature(uses_system_zlib "${cache_file}" system_zlib)
  if(NOT uses_system_zlib)
    _bext_qt_select(zlib)
  endif()
  _bext_qt_select_bundled(png system_png libpng)
  _bext_qt_select_bundled(jpeg system_jpeg libjpeg)
  _bext_qt_select_bundled(freetype system_freetype freetype)
  _bext_qt_select_bundled(harfbuzz system_harfbuzz harfbuzz-ng)
  _bext_qt_cache_feature(uses_system_pcre2 "${cache_file}" system_pcre2)
  if(NOT uses_system_pcre2)
    _bext_qt_select(pcre2)
  endif()
  _bext_qt_select_bundled(sql_sqlite system_sqlite sqlite)
  _bext_qt_select_bundled(textmarkdownreader system_textmarkdownreader md4c)
  _bext_qt_cache_feature(uses_emoji_segmenter "${cache_file}" emojisegmenter)
  if(uses_emoji_segmenter)
    _bext_qt_select(emoji-segmenter)
  endif()
  _bext_qt_cache_feature(uses_cbor_reader "${cache_file}" cborstreamreader)
  _bext_qt_cache_feature(uses_cbor_writer "${cache_file}" cborstreamwriter)
  if(uses_cbor_reader OR uses_cbor_writer)
    _bext_qt_select(tinycbor)
  endif()

  list(REMOVE_DUPLICATES packages)
  list(SORT packages)
  set(${output} "${packages}" PARENT_SCOPE)
endfunction()
