# Qt tools need matching Qt libraries first and compiler runtimes afterwards.
function(bext_qt_set_runtime_path)
  set(qt_runtime_dirs ${ARGN})
  list(FILTER qt_runtime_dirs EXCLUDE REGEX "^$")
  if (APPLE)
    set(qt_runtime_variable DYLD_LIBRARY_PATH)
  else ()
    set(qt_runtime_variable LD_LIBRARY_PATH)
  endif ()
  if (NOT "$ENV{${qt_runtime_variable}}" STREQUAL "")
    list(APPEND qt_runtime_dirs "$ENV{${qt_runtime_variable}}")
  endif ()
  string(JOIN ":" qt_runtime_path ${qt_runtime_dirs})
  set(ENV{${qt_runtime_variable}} "${qt_runtime_path}")
endfunction()
