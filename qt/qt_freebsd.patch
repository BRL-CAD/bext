 // Define a native float16 type
 namespace QtPrivate {
-#if defined(__STDCPP_FLOAT16_T__)
+// FreeBSD's GCC runtime lacks some PIC half-precision conversion helpers.
+// Keep the portable representation instead of emitting unavailable libcalls.
+#if defined(Q_OS_FREEBSD) && defined(Q_CC_GNU_ONLY)
+#  define QFLOAT16_IS_NATIVE        0
+using NativeFloat16Type = void;
+#elif defined(__STDCPP_FLOAT16_T__)
 #  define QFLOAT16_IS_NATIVE        1
 using NativeFloat16Type = std::float16_t;
