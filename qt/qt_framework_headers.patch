--- a/cmake/QtFrameworkHelpers.cmake
+++ b/cmake/QtFrameworkHelpers.cmake
@@ -1,3 +1,20 @@
+if(DEFINED QT_FRAMEWORK_HEADERS_SOURCE AND DEFINED QT_FRAMEWORK_HEADERS_DESTINATION)
+    # Staging includes forwarders to framework headers; do not overwrite the real headers.
+    file(GLOB_RECURSE headers RELATIVE "${QT_FRAMEWORK_HEADERS_SOURCE}" LIST_DIRECTORIES false
+        "${QT_FRAMEWORK_HEADERS_SOURCE}/*")
+    foreach(header IN LISTS headers)
+        file(READ "${QT_FRAMEWORK_HEADERS_SOURCE}/${header}" content LIMIT 32)
+        if(content MATCHES "^#include_next[ \t]")
+            continue()
+        endif()
+        get_filename_component(directory "${QT_FRAMEWORK_HEADERS_DESTINATION}/${header}" DIRECTORY)
+        file(MAKE_DIRECTORY "${directory}")
+        file(COPY_FILE "${QT_FRAMEWORK_HEADERS_SOURCE}/${header}"
+            "${QT_FRAMEWORK_HEADERS_DESTINATION}/${header}" ONLY_IF_DIFFERENT)
+    endforeach()
+    return()
+endif()
