+// Check both atan2 arguments against wrapped central differences so that
+// the negative-x branch cut does not turn a small angle change into 2*pi.
+template<class T>
 void
+test_atan2_derivs()
+{
+    const T coordinates[] = { T(-2), T(-0.5), T(0), T(0.5), T(2) };
+    const double epsilon = 1e-5;
+    const double period  = 2 * std::acos(-1.0);
+    const T tolerance    = T(2e-5);
+    for (T x : coordinates) {
+        for (T y : coordinates) {
+            const Dual<T, 2> xd(x, T(1), T(0));
+            const Dual<T, 2> yd(y, T(0), T(1));
+            const auto exact = OSL::atan2(yd, xd);
+            const auto fast  = OSL::fast_atan2(yd, xd);
+            double dx = 0, dy = 0;
+            // The singular origin deliberately returns zero derivatives.
+            if (x != T(0) || y != T(0)) {
+                dx = std::remainder(std::atan2(double(y), double(x) + epsilon)
+                                        - std::atan2(double(y), double(x) - epsilon),
+                                    period) / (2 * epsilon);
+                dy = std::remainder(std::atan2(double(y) + epsilon, double(x))
+                                        - std::atan2(double(y) - epsilon, double(x)),
+                                    period) / (2 * epsilon);
+            }
+            OIIO_CHECK_EQUAL_THRESH(std::atan2(y, x), exact.val(), tolerance);
+            OIIO_CHECK_EQUAL_THRESH(std::atan2(y, x), fast.val(), tolerance);
+            OIIO_CHECK_EQUAL_THRESH(T(dx), exact.dx(), tolerance);
+            OIIO_CHECK_EQUAL_THRESH(T(dy), exact.dy(), tolerance);
+            OIIO_CHECK_EQUAL_THRESH(T(dx), fast.dx(), tolerance);
+            OIIO_CHECK_EQUAL_THRESH(T(dy), fast.dy(), tolerance);
+        }
+    }
+}
+
+
