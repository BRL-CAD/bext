@@ -9,11 +9,8 @@ file (GLOB compiler_headers "../liboslexec/*.h")
 FLEX_BISON (../liboslexec/osolex.l ../liboslexec/osogram.y oso lib_src compiler_headers)
 
 add_library (${local_lib} ${lib_src})
-target_include_directories (${local_lib}
