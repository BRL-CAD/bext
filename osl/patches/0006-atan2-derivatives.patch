From 625022d80df5357797e85dfb9a4ff77be31c66f3 Mon Sep 17 00:00:00 2001
From: Clifford Yapp <238416+starseeker@users.noreply.github.com>
Date: Mon, 16 Nov 2026 03:18:42 +0000
Subject: [PATCH] fix: Correct both atan2 derivative signs

Apply the atan2 partials in argument order for ordinary and fast dual
arithmetic.  The previous implementation reversed both signs.

Check both arguments with wrapped finite differences across quadrants
and axes for float and double.  Correct the compiled-shader derivative
references that had retained the reversed signs.

diff --git a/src/include/OSL/dual.h b/src/include/OSL/dual.h
index ce7794f76a7cba6eb8df4849a94f2de0506fc69e..1d871bc7d66304d585debbaac585d19beb2246ca 100644
--- a/src/include/OSL/dual.h
+++ b/src/include/OSL/dual.h
@@ -1010,8 +1010,8 @@ OSL_HOSTDEVICE OSL_FORCEINLINE Dual<T,P> fast_atan(const Dual<T,P> &a)
     return dualfunc (a, f, df);
 }
 
-// f(x,y) = atan2(y,x); f'(x) =  y x' / (x^2 + y^2),
-//                      f'(y) = -x y' / (x^2 + y^2)
+// f(x,y) = atan2(y,x); df/dx = -y / (x^2 + y^2),
+//                      df/dy =  x / (x^2 + y^2)
 // reference:  http://en.wikipedia.org/wiki/Atan2
 // (above link has other formulations)
 template<class T, int P>
@@ -1019,7 +1019,7 @@ OSL_HOSTDEVICE OSL_FORCEINLINE Dual<T,P> atan2 (const Dual<T,P> &y, const Dual<T
 {
     T atan2xy = std::atan2 (y.val(), x.val());
     T denom = (x.val() == T(0) && y.val() == T(0)) ? T(0) : T(1) / (x.val()*x.val() + y.val()*y.val());
-    return dualfunc (y, x, atan2xy, -x.val()*denom, y.val()*denom);
+    return dualfunc (y, x, atan2xy, x.val()*denom, -y.val()*denom);
 }
 
 template<class T, int P>
@@ -1027,7 +1027,7 @@ OSL_HOSTDEVICE OSL_FORCEINLINE Dual<T,P> fast_atan2(const Dual<T,P> &y, const Du
 {
     T atan2xy = OIIO::fast_atan2(y.val(), x.val());
     T denom = (x.val() == 0 && y.val() == 0) ? 0.0f : 1.0f / (x.val() * x.val() + y.val() * y.val());
-    return dualfunc (y, x, atan2xy, -x.val()*denom, y.val()*denom);
+    return dualfunc (y, x, atan2xy, x.val()*denom, -y.val()*denom);
 }
 
 // f(x) = log(a), f'(x) = 1/x
diff --git a/src/liboslexec/dual_test.cpp b/src/liboslexec/dual_test.cpp
index 10384693cfb254c11b1aa6fe39d1cce3f0bb658a..ec19c17f4065c1d66cf2a672fa9b6391d9a214cf 100644
--- a/src/liboslexec/dual_test.cpp
+++ b/src/liboslexec/dual_test.cpp
@@ -94,6 +94,44 @@ test_derivs2()
 
 
 
+// Check both atan2 arguments against wrapped central differences so that
+// the negative-x branch cut does not turn a small angle change into 2*pi.
+template<class T>
+void
+test_atan2_derivs()
+{
+    const T coordinates[] = { T(-2), T(-0.5), T(0), T(0.5), T(2) };
+    const double epsilon = 1e-5;
+    const double period  = 2 * std::acos(-1.0);
+    const T tolerance    = T(2e-5);
+    for (T x : coordinates) {
+        for (T y : coordinates) {
+            const Dual<T, 2> xd(x, T(1), T(0));
+            const Dual<T, 2> yd(y, T(0), T(1));
+            const auto exact = OSL::atan2(yd, xd);
+            const auto fast  = OSL::fast_atan2(yd, xd);
+            double dx = 0, dy = 0;
+            // The singular origin deliberately returns zero derivatives.
+            if (x != T(0) || y != T(0)) {
+                dx = std::remainder(std::atan2(double(y), double(x) + epsilon)
+                                        - std::atan2(double(y), double(x) - epsilon),
+                                    period) / (2 * epsilon);
+                dy = std::remainder(std::atan2(double(y) + epsilon, double(x))
+                                        - std::atan2(double(y) - epsilon, double(x)),
+                                    period) / (2 * epsilon);
+            }
+            OIIO_CHECK_EQUAL_THRESH(std::atan2(y, x), exact.val(), tolerance);
+            OIIO_CHECK_EQUAL_THRESH(std::atan2(y, x), fast.val(), tolerance);
+            OIIO_CHECK_EQUAL_THRESH(T(dx), exact.dx(), tolerance);
+            OIIO_CHECK_EQUAL_THRESH(T(dy), exact.dy(), tolerance);
+            OIIO_CHECK_EQUAL_THRESH(T(dx), fast.dx(), tolerance);
+            OIIO_CHECK_EQUAL_THRESH(T(dy), fast.dy(), tolerance);
+        }
+    }
+}
+
+
+
 void
 test_metaprogramming()
 {
@@ -123,6 +161,8 @@ main(int /*argc*/, char* /*argv*/[])
     test_metaprogramming();
     test_derivs1();
     test_derivs2();
+    test_atan2_derivs<float>();
+    test_atan2_derivs<double>();
 
     // Some benchmarking
     std::cout << "\nBenchmarks:\n";
