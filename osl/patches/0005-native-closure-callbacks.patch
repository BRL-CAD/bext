diff --git a/src/liboslexec/llvmutil_test.cpp b/src/liboslexec/llvmutil_test.cpp
index ae57d013ef84f408b77d2b3e9f5798b1ea353091..0ff803faec4be366c7a017c0e65bc3477ed3dd6f 100644
--- a/src/liboslexec/llvmutil_test.cpp
