diff -Naur OpenShadingLanguage/src/liboslcomp/CMakeLists.txt OSL_BLD/src/liboslcomp/CMakeLists.txt
--- OpenShadingLanguage/src/liboslcomp/CMakeLists.txt	2024-06-26 16:05:10.536665401 -0400
+++ OSL_BLD/src/liboslcomp/CMakeLists.txt	2024-06-26 16:00:29.387207292 -0400
@@ -60,8 +60,20 @@
         SOVERSION   ${SOVERSION}
         OUTPUT_NAME ${local_lib}${OSL_LIBNAME_SUFFIX}
         LINK_FLAGS  ${link_flags}
+		  CXX_STANDARD 17
         POSITION_INDEPENDENT_CODE ON
     )
 
 install_targets (${local_lib})
 
+
+# bext: MinGW/clang-mingw need Version.dll's imports too -- clangDriver's
+# MSVC.cpp calls GetFileVersionInfoSizeW/GetFileVersionInfoW/VerQueryValueW.
+# MSVC's link.exe accepts "Version.lib" as a positional lib name; GNU ld does
+# not -- it needs a -l flag.  Appended here (rather than in the original
+# MSVC-only block above) so that on GNU ld single-pass link, -lversion is
+# processed AFTER libclangDriver.a, whose MSVC.cpp.obj emits the undefined
+# references.  Ordering matters for ld; MSVC link.exe is unaffected by order.
+if (WIN32 AND NOT MSVC)
+    target_link_libraries (${local_lib} PRIVATE "-lversion")
+endif()
