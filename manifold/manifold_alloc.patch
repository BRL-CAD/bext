  private:
+  struct BufferDeleter {
+    void operator()(T* pointer) const noexcept {
+      TracyFreeS(pointer, 3);
+      free(pointer);
+    }
+  };
+  using Buffer = std::unique_ptr<T, BufferDeleter>;
+
+  static Buffer allocate(size_t count) {
+    if (count > std::numeric_limits<size_t>::max() / sizeof(T))
+      throw std::bad_alloc();
+    T* pointer = reinterpret_cast<T*>(malloc(count * sizeof(T)));
+    // Allocation failures must be handled in release builds as well.
+    if (pointer == nullptr) throw std::bad_alloc();
+    TracyAllocS(pointer, count * sizeof(T), 3);
+    return Buffer(pointer);
+  }
+
   size_t capacity_ = 0;
 
